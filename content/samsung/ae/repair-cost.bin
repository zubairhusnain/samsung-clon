                                </thead>
                                <tbody>
                                    <% if(item.models && item.models.length > 0) { %>
                                        <% item.models.forEach(function(modelItem) { %>
                                            <tr>
                                                <td><%= modelItem.device %></td>
                                                <td><%= modelItem.replacement %></td>
                                                
                                            </tr>
                                        <% }); %>
                                    <% } %>
                                </tbody>
                            </table>
                        </div>
                        <% if(item.disclaimer && item.disclaimer.length > 0) { %>
                            <div class="disclaimer-wrapper">
                                <p><%= item.disclaimer %></p>
                            </div>
                        <% } %>
                    </div>
                </div>
            </div>
        </div>
        <% }); %>
    <% } %>
    </div>
</script>

