<style id="ring-buds-move-fix">

/* Hide Ring & Buds from main selector tabs */
.rec-selector-item[data-div-code="div_ring"],
.rec-selector-item[data-div-code="div_buds"]{
    display:none !important;
}

/* Hide standalone dropdown blocks for Ring & Buds */
.cpnsec-dropdown.div_ring,
.cpnsec-dropdown.div_buds{
    display:none !important;
}

/* ===================================== */
/* MOBILE TAB → UAE ONLY COUNTRIES */
/* ===================================== */

body.mobile-only-uae 
.ctry-selector-item:has(.ctry-selector-menu[data-ctry-code="bahrain"]),
body.mobile-only-uae 
.ctry-selector-item:has(.ctry-selector-menu[data-ctry-code="kuwait"]),
body.mobile-only-uae 
.ctry-selector-item:has(.ctry-selector-menu[data-ctry-code="oman"]),
body.mobile-only-uae 
.ctry-selector-item:has(.ctry-selector-menu[data-ctry-code="qatar"]){
    display:none !important;
}

</style>

<script>
(function(){

  function updateMobileCountryMode() {

    const activeTab = document.querySelector('.rec-selector-item.active');

    const isMobile =
      activeTab &&
      activeTab.getAttribute('data-div-code') === 'div_mx';

    if(isMobile){

      document.body.classList.add('mobile-only-uae');

      const activeCountry = document.querySelector(
        '.ctry-selector-menu.active'
      );

      if(
        activeCountry &&
        ['bahrain','kuwait','oman','qatar']
        .includes(activeCountry.getAttribute('data-ctry-code'))
      ){

        const uaeBtn = document.querySelector(
          '.ctry-selector-menu[data-ctry-code="uae"]'
        );

        if(uaeBtn){
          uaeBtn.click();
        }
      }

    } else {

      document.body.classList.remove('mobile-only-uae');

    }
  }

  document.addEventListener('click', function(){
    setTimeout(updateMobileCountryMode, 100);
  });

  document.addEventListener(
    'DOMContentLoaded',
    updateMobileCountryMode
  );

  setTimeout(updateMobileCountryMode, 500);

})();
</script>


