            position: fixed;
            bottom: 0px;
            left: 0px;
            height: 100%;
            width: 100%;
            background: rgba(0, 0, 0, 0.7);
            z-index: 0;
            transition: opacity 0.2s ease-in;
            opacity: 0;
            display: none;
        }
        .ins-popup-wrapper-c265 {
            display: flex;
            flex-direction: column;
            gap: 20px;
            width: max-content;
            position: fixed;
            bottom: 25px;
            left: 20px;
            z-index: 2600;
            text-transform: uppercase;
            cursor: pointer;
            border: none;
            pointer-events: all;
            align-items: center;
            box-sizing: border-box;
            -webkit-user-select: none;
            -moz-user-select: none;
            -ms-user-select: none;
            user-select: none;
        }
        .ins-popup-wrapper-c265.ins-hovered-c265 .ins-popup-container-c265 {
            transform: translate3d(0px, 0em, 0px) scale3d(1, 1, 1) rotateZ(0deg) skew(0deg, 0deg);
            transform-style: preserve-3d;
            opacity: 1;
            pointer-events: all;
            display: block;
        }
        .ins-popup-wrapper-c265.ins-hovered-c265 + .ins-popup-overlay-c265 {
            opacity: 1;
            pointer-events: none;
            z-index: 2500;
            display: block;
        }
        .ins-popup-wrapper-c265.ins-hovered-c265 .ins-popup-text-c265 {
            display: none;
        }
        .ins-popup-wrapper-c265.ins-hovered-c265 .ins-popup-hover-text-c265 {
            display: block;
        }
        .ins-popup-container-c265 {
            position: relative;
            border-radius: 11px;
            width: max-content;
            align-self: flex-start;
            transition: transform 0.2s ease-in, opacity 0.2s ease-in;
            opacity: 0;
            transform: translate3d(0px, 12px, 0px) scale3d(0.98, 0.98, 1) rotateY(0deg) rotateZ(0deg) skew(0deg, 0deg);
            transform-style: preserve-3d;
            perspective: calc(480px * 1.25);
            perspective-origin: 50% 60%;
            transition: transform 0.3s ease;
            transform-style: preserve-3d;
            max-width: calc(240px * 1.25);
            display: none;
        }
        .ins-popup-container-c265 img {
            object-fit: cover;
            height: 464px;
            transition: height 0.3s;
            border-radius: 11px;
        }
        .ins-popup-badge-container-c265 {
            position: relative;
            align-self: flex-start;
            background-color: #000000;
            color: #ffffff;
            border-radius: 100px;
            padding: 7px 16px;
            font-weight: 700;
            display: flex;
            gap: 4px;
            align-items: center;
            box-shadow: 0px 4px 20px rgba(0, 0, 0, 0.15);
            font-size: 14.7px;
            line-height: 1.66666667vw;
            font-family: "SamsungOne", arial, sans-serif;
        }
        .ins-popup-badge-container-c265 img {
            width: 35px;
            height: 35px;
        }
        .ins-popup-hover-text-c265 {
            display: none;
        }
        .ins-close-button-c265 {
            position: absolute;
            top: auto;
            bottom: 20px;
            left: auto;
            right: 0px;
            margin-right: -40px;
            display: flex;
            align-items: center;
            justify-content: center;
            width: 30px;
            height: 30px;
            font-size: 21px;
            font-weight: bold;
            background: #000;
            color: #fff;
            border-radius: 50%;
        }
        .ins-popup-wrapper-c265.ins-hovered-c265 .ins-close-button-c265 {
            margin-right: -10px;
