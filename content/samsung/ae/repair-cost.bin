<style>
.clear { clear: both; }
.dkp-only { display: block; }
.mbl-only { display: none; }
.cpnpage-wrapper { width: 100%; margin: 0; padding: 0;font-family: "SamsungOne"; }
.cpnpage-wrapper * { box-sizing: border-box; }
.cpnpage-wrapper a { outline: none!important; }
.cpnpage-wrapper { width: 100%; margin: 0; padding: 0; text-align: center; color: #000000; }
.cpnpage-wrapper h1 { font-family: 'SamsungSharpSans'; font-size: 52px; line-height: 1.33; margin: 0 0 20px 0; }
.cpnpage-wrapper h2 { font-family: 'SamsungSharpSans'; font-size: 44px; line-height: 1.33; margin: 0 0 15px 0; }
.cpnpage-wrapper h3 { font-family: 'SamsungSharpSans'; font-size: 32px; line-height: 1.33; margin: 0 0 15px 0;  }
.cpnpage-wrapper h4 { font-family: 'SamsungSharpSans'; font-size: 24px; line-height: 1.33; margin: 0 0 0 0; }
.cpnpage-wrapper h5 { font-family: 'SamsungSharpSans'; font-size: 18px; line-height: 1.33; margin: 0 0 0 0; }
.cpnpage-wrapper p { font-family: 'SamsungOne'; font-size: 18px; line-height: 1.2; margin: 0 0 10px 0; }
.cpnpage-wrapper p.text-sm { font-family: 'SamsungOne'; font-size: 16px; line-height: 1.2; margin: 0 0 5px 0; }
.cpnpage-wrapper a.cta-link { color: #000000; text-decoration: none; border-bottom: 1px solid #000000; transition: all 0.2s ease-in-out; }
.cpnpage-wrapper a.cta-link:hover { border-bottom: 1px solid transparent; }
.cpnpage-wrapper .img-wrapper { text-align: center;  }
.cpnpage-wrapper .img-wrapper img { max-width: 100%; max-height: 100%; margin-left: auto; margin-right: auto; }
.cpnpage-wrapper .video-wrapper { width: 100%; margin: 0; padding: 0; position: relative; padding-bottom: 56.53%; overflow:hidden; background-color: rgb(32, 10, 110); }
.cpnpage-wrapper .video-wrapper iframe, .cpnpage-wrapper .video-wrapper video { position: absolute; top: 0; left: 0; width: 100%; height: 100%; border: 3px solid rgb(32, 10, 110); }
.cpnpage-wrapper .bg-gray { background-color: #f4f4f4; }

.cpnpage-inner { width: 100%; max-width: 1440px; margin: 0 auto; padding: 0; }
.cpnsec-wrapper { width: 100%; margin: 0; padding: 0; text-align: center; }
.cpnsec-inner { padding: 80px 0; }

.cpnsec-mainkv .cpnsec-inner { padding: 0 0 0; }
.mainkv-wrapper { width: 100%; margin: 0; padding: 0;  }
.mainkv-inner { width: 100%; margin: 0; padding: 0; position: relative; }
.mainkv-overlay { position: absolute; width: 42%; top: 25%; left: 8%; text-align: left; }
.mainkv-overlay-content { padding: 10px; }

.rec-wrapper { width: 100%; margin: 0; padding: 0; }
.rec-inner { padding: 0; }
.rec-intro { padding: 0 0 40px; }
.rec-main { width: 100%; margin: 0; padding: 0; }
.rec-selector-wrapper { width: 100%; margin: 0; padding: 0; }
.rec-selector { width: 100%; max-width: 1440px; margin: 0 auto; padding: 0; }
.rec-selector-list { width: 100%; }
.rec-selector-item { flex-basis: 22.5%; }
.rec-selector-item-inner { padding: 20px 10px; margin: 0 15px; border: 3px solid #f7f7f7; border-top-left-radius: 15px; border-top-right-radius: 15px; cursor: pointer; transition: all 0.15s linear; }
.rec-selector-item-inner img{max-width: 5vw !important; max-height: 60px !important;}
.rec-selector-item-inner:hover { background-color: #f7f7f7; }
.rec-selector-item.active .rec-selector-item-inner { background-color: #f7f7f7; border-bottom: none; position: relative; z-index: 1; }
.rec-selector-item.active .rec-selector-item-inner::after { content: ''; position: absolute; bottom: -20px; left: -3px; right: -3px; height: 23px; background-color: #f7f7f7; z-index: -1; }
.rec-selector-item .img-wrapper { padding: 0 0 20px; }
.rec-viewer-wrapper { width: 100%; margin: 0; padding: 30px 0 80px; background-color: #f7f7f7; }
.rec-cataselector { width: 100%; max-width: 1440px; margin: 0 auto; padding: 0; }
.rec-cataselector-list { width: 100%; display: flex; flex-wrap: wrap; justify-content: center; margin: 0; padding: 0 0 50px; position: relative; }
.rec-cataselector-item { flex-basis: 16.5%; }
.rec-cataselector-item-inner { padding: 0 20px; }
.cpnsec-dropdown { position: relative; display: none; width: 100%; }
.cpnsec-dropdown.active { display: inline-block; position: absolute; left: 0; width: auto; min-width: 200px; }
.cpnsec-ddtoggle { width: 100%; padding: 10px 35px; background: #000000; border-radius: 30px; color: #ffffff; font-size: 14px; font-weight: 700; letter-spacing: 1px; position: relative; cursor: pointer; }
.cpnsec-ddtoggle::after { content: ''; width: 10px; height: 7px; background-image: url('https://images.samsung.com/is/image/samsung/assets/ae/screen-repair-cost/images/icon-arrow-down.png'); background-position: center; background-size: 10px 7px; display: inline-block; position: absolute; top: 50%; right: 10%; transform: translateY(-3.5px); }
.cpnsec-ddmenus { display: none; width: 100%; position: absolute; top: 100%; margin-top: 0; padding: 10px 0; background: #ebebeb; border-radius: 10px; max-height: 280px; overflow: auto; }
.cpnsec-ddmenu-item { padding: 10px 20px; display: block; cursor: pointer; background: #ebebeb; }
.cpnsec-ddmenu-item:hover { background: #dbdbdb; font-weight: bold; }
.ctry-selector { width: 100%; max-width: 750px; margin: 0 auto; padding: 20px 0 20px; }
.ctry-selector-list { width: 100%; display: flex; flex-wrap: wrap; justify-content: center; align-items: flex-start; }
.ctry-selector-item { padding: 0 20px; }
.ctry-selector-menu { text-decoration: none; color: #999; font-weight: bold; border-bottom: 2px solid transparent; transition: all 0.15s linear; }
.ctry-selector-menu:hover { border-bottom: 2px solid #999; }
.ctry-selector-menu.active { color: #000000; font-weight: bold; border-bottom: 2px solid #000; }
.rec-pricing { width: 100%; max-width: 1060px; margin: 0 auto; padding: 40px 0 0; }
.rec-pricing-holder { width: 100%; margin: 0; padding: 0; }
.price-model-inner { width: 100%; display: flex; flex-wrap: wrap; justify-content: center; align-items: flex-start; }
.price-model-thumbnail { flex-basis: 35%; }
.price-model-thumbnail .img-wrapper { padding: 60px 20px 0; max-width: 240px; margin: 0 auto; text-align: center; }
.price-model-thumbnail .img-wrapper.no-title { padding: 20px 20px 0; }
.price-model-content { flex-basis: 65%; }
.price-model-content-inner { padding: 10px 10px 60px; }
.price-model-content h4 { margin-bottom: 15px; }
.price-model-content h5 { margin-bottom: 15px; }
.mrp-table-wrapper { padding: 20px 10px; background: #fff; border-radius: 10px; box-shadow: rgb(149 157 165 / 20%) 0px 8px 24px; }
.mrp-table { width: 100%; text-align: center; }
.mrp-table tr:nth-child(1) td { padding-top: 20px; }
.mrp-table th { padding: 10px 20px 15px; border-right: 2px solid #efefef; vertical-align: middle; border-bottom: 2px solid #efefef; }
.mrp-table td { padding: 10px 20px; border-right: 2px solid #efefef; vertical-align: middle; }
.mrp-table th:last-child, .mrp-table td:last-child { border-right: none; }
.mrp-table th, .mrp-table td:first-child { font-weight: 700; }
.mrp-table .tbl-w20 { width: 20%; }
.mrp-table .tbl-w30 { width: 30%; }
.cpnsec-tnc .cpnsec-inner { padding: 0 0 80px; }
.tnc-wrapper { padding: 0 40px; }
.disclaimers-wrapper { width: 100%; margin: 0; padding: 0; text-align: left; }
.disclaimers-inner { padding: 0 80px; overflow: hidden; }
ul.disclaimers-list li { list-style: disc outside; font-size: 14px; margin-left: 18px;  }
.disclaimer-wrapper { padding: 20px 5px 0; text-align: left; }
.disclaimer-wrapper p { font-size: 14px; }
.rec-selector-item:first-of-type .rec-selector-item-inner{margin-left: 0 !important;}
.rec-selector-item:last-of-type .rec-selector-item-inner{margin-right: 0 !important;}

