<script>
$(document).ready(function () {
    $('.slk__slider').slick({
        arrows: false,
        dots: false,
        slidesToShow: 6.04,
        slidesToScroll: 1,
        autoplay: false,
        infinite: false,
        useTransform: false,
        variableWidth: false,
        focusOnSelect: true,
        responsive: [
            {
            breakpoint: 768,
            settings: {
                dots: false,
                arrows: false,
                slidesToShow: 3.5,
                slidesToScroll: 1,                
            }
            }
        ]
    });  
})  
</script>
