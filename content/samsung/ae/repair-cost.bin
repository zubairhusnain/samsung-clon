<script id="tplModelPricingMx" type="text/template">
    <div class="rec-pricing-holder">
    <% if(mrp && mrp.data && mrp.data.length > 0) { %>
        <% mrp.data.forEach(function(item) { %>
        <div class="price-model">
            <div class="price-model-inner">

                <div class="price-model-thumbnail">
                    <div class="img-wrapper">
                        <img src="<%= item.thbnail %>" alt="<%= item.title %>" />
                    </div>
                </div>

                <div class="price-model-content">
                    <div class="price-model-content-inner">
                        <h4><%= item.title %></h4>

                        <div class="mrp-table-wrapper">
                            <table class="mrp-table">
                                <thead>
                                    <tr>
                                        <th>Device</th>

                                        <% if(
                                            mrp.country === "uae" || 
                                            mrp.country === "kuwait" || 
                                            mrp.country === "oman" || 
                                            mrp.country === "qatar" || 
                                            (mrp.country === "bahrain" && 
                                                (item.name === "s24_series" || 
                                                 item.name === "zfold_series" || 
                                                 item.name === "zflip_series"))
                                        ) { %>
                                            <th>Screen Repair</th>
                                        <% } %>

                                    </tr>
                                </thead>

                                <tbody>
                                    <% if(item.models && item.models.length > 0) { %>
                                        <% item.models.forEach(function(modelItem) { %>
                                            <tr>
                                                <td><%= modelItem.device %></td>

                                                <% if(
                                                    mrp.country === "uae" || 
                                                    mrp.country === "kuwait" || 
                                                    mrp.country === "oman" || 
                                                    mrp.country === "qatar" || 
                                                    (mrp.country === "bahrain" && 
                                                        (item.name === "s24_series" || 
                                                         item.name === "zfold_series" || 
                                                         item.name === "zflip_series"))
                                                ){ %>
                                                    <td><%= modelItem.repair %></td>
                                                <% } %>

                                            </tr>
                                        <% }); %>
                                    <% } %>
                                </tbody>
                            </table>
                        </div>

                        <% if(item.models && item.models.length > 0) { %>
                            <% if(item.disclaimer && item.disclaimer.trim() !== "") { %>
                                <div class="disclaimer-wrapper">
                                    <p><%= item.disclaimer %></p>
                                </div>
                            <% } %>
                        <% } %>

                    </div>
                </div>

            </div>
        </div>
        <% }); %>
    <% } %>    
    </div>   
</script>
