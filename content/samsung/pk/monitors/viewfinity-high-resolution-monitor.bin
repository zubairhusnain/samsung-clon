    <!-- Feature -->
    <div class="vd-feature" id="FEATURE">
      <div class="vd-feature__wrap">
        <div class="vd-feature__text">
          <h3 class="vd-common__title">Convenience <br class="vd-common-br-mo">Meets Versatility</h3>
        </div>
        <div class="vd-feature__details">
          <div class="vd-feature__details-wrap">
            <div class="vd-feature__details-cont">
              <div class="vd-feature__video video__container js-video-src js-res-video" data-src-pc="//images.samsung.com/is/content/samsung/assets/consumer/global/vd/monitors/viewfinity-high-resolution-monitor/vd-feature-video01.mp4" data-src-mobile="//images.samsung.com/is/content/samsung/assets/consumer/global/vd/monitors/viewfinity-high-resolution-monitor/vd-feature-video01.mp4" data-auto-play="true">
                <video playsinline muted preload="auto" loop>
                  <source src="" type="video/mp4">
                </video>
                <p class="blind">A ViewFinity monitor is being assembled without any tools, thanks to the Easy Setup
                  Stand.</p>
                <button title="video" class="vd-feature__popup-btn video__controller is-use-controller" aria-label="play video:Easy Setup Stand" an-tr="ergonomics / connectivity-${pageTrack}-play/stop video-content_click" an-ca="content click" an-ac="feature" an-la="easy setup stand:play video">
                  <img src="data:image/gif;base64,R0lGODlhAQABAPAAAP///wAAACH/C1hNUCBEYXRhWE1QAz94cAAh+QQFAAAAACwAAAAAAQABAAACAkQBADs=" class="js-start-img-src js-res-img play" data-src-pc="//images.samsung.com/is/image/samsung/assets/consumer/global/vd/monitors/viewfinity-high-resolution-monitor/vd-icon-play.png?$ORIGIN_PNG$" data-src-tablet="//images.samsung.com/is/image/samsung/assets/consumer/global/vd/monitors/viewfinity-high-resolution-monitor/vd-icon-play.png?$ORIGIN_PNG$" data-src-mobile="//images.samsung.com/is/image/samsung/assets/consumer/global/vd/monitors/viewfinity-high-resolution-monitor/vd-icon-play.png?$ORIGIN_PNG$" alt="Play">
                  <img src="data:image/gif;base64,R0lGODlhAQABAPAAAP///wAAACH/C1hNUCBEYXRhWE1QAz94cAAh+QQFAAAAACwAAAAAAQABAAACAkQBADs=" class="js-start-img-src js-res-img pause" data-src-pc="//images.samsung.com/is/image/samsung/assets/consumer/global/vd/monitors/viewfinity-high-resolution-monitor/vd-icon-pause.png?$ORIGIN_PNG$" data-src-tablet="//images.samsung.com/is/image/samsung/assets/consumer/global/vd/monitors/viewfinity-high-resolution-monitor/vd-icon-pause.png?$ORIGIN_PNG$" data-src-mobile="//images.samsung.com/is/image/samsung/assets/consumer/global/vd/monitors/viewfinity-high-resolution-monitor/vd-icon-pause.png?$ORIGIN_PNG$" alt="Pause">
                </button>
              </div>
              <h4 class="vd-feature__details-title" data-subtitle="easy setup stand">Easy Setup Stand<sup><a href="#desc-section" class="click_sup" title="See disclaimer" data-sup="5">5</a></sup></h4>
              <p class="vd-feature__details-description">Effortless installation with the Easy Setup Stand. No tools or
                screws needed—setup is simple right out of the box and offers flexible viewing options at the push of a
                button.</p>
            </div>
            <div class="vd-feature__details-image">
              <img src="data:image/gif;base64,R0lGODlhAQABAPAAAP///wAAACH/C1hNUCBEYXRhWE1QAz94cAAh+QQFAAAAACwAAAAAAQABAAACAkQBADs=" class="js-start-img-src js-res-img" data-src-pc="//images.samsung.com/is/image/samsung/assets/consumer/global/vd/monitors/viewfinity-high-resolution-monitor/vd-feature-main01.jpg?$ORIGIN_JPG$" data-src-tablet="//images.samsung.com/is/image/samsung/assets/consumer/global/vd/monitors/viewfinity-high-resolution-monitor/vd-feature-main01.jpg?imwidth=1080" data-src-mobile="//images.samsung.com/is/image/samsung/assets/consumer/global/vd/monitors/viewfinity-high-resolution-monitor/vd-feature-main01.jpg?$ORIGIN_JPG$" alt="A Samsung ViewFinity monitor being assembled using the Easy Setup Stand. It is a tool-free installation process, with a user effortlessly attaching the rear of the monitor to the stand. The setup provides flexible viewing options for convenience and versatility.">
            </div>
          </div>
          <div class="vd-feature__details-wrap">
            <div class="vd-feature__details-image">
              <img src="data:image/gif;base64,R0lGODlhAQABAPAAAP///wAAACH/C1hNUCBEYXRhWE1QAz94cAAh+QQFAAAAACwAAAAAAQABAAACAkQBADs=" class="js-start-img-src js-res-img" data-src-pc="//images.samsung.com/is/image/samsung/assets/consumer/global/vd/monitors/viewfinity-high-resolution-monitor/vd-feature-main02.jpg?$ORIGIN_JPG$" data-src-tablet="//images.samsung.com/is/image/samsung/assets/consumer/global/vd/monitors/viewfinity-high-resolution-monitor/vd-feature-main02.jpg?imwidth=1080" data-src-mobile="//images.samsung.com/is/image/samsung/assets/consumer/global/vd/monitors/viewfinity-high-resolution-monitor/vd-feature-main02.jpg?$ORIGIN_JPG$" alt="A Samsung ViewFinity monitor sits on a desk in portrait mode, displaying a webpage in a bright, modern office environment. The ergonomic design allows for height adjustment, as well as pivot, swivel, and tilt options to ensure comfortable use tailored to the user's preferences.">
            </div>
            <div class="vd-feature__details-cont">
              <h4 class="vd-feature__details-title" data-subtitle="ergonomic design">Ergonomic Design</h4>
              <div class="vd-feature__video video__container js-video-src js-res-video" data-src-pc="//images.samsung.com/is/content/samsung/assets/consumer/global/vd/monitors/viewfinity-high-resolution-monitor/vd-feature-video02.mp4" data-src-mobile="//images.samsung.com/is/content/samsung/assets/consumer/global/vd/monitors/viewfinity-high-resolution-monitor/vd-feature-video02.mp4" data-auto-play="true">
                <video playsinline muted preload="auto" loop>
                  <source src="" type="video/mp4">
                </video>
                <p class="blind">A ViewFinity monitor is rotating vertically, and tilting, and moving back to horizontal
                  mode. And its height is being adjusted.</p>
                <button title="video" class="vd-feature__popup-btn video__controller is-use-controller" aria-label="play video:Ergonomic Design" an-tr="ergonomics / connectivity-${pageTrack}-play/stop video-content_click" an-ca="content click" an-ac="feature" an-la="ergonomic design:play video">
                  <img src="data:image/gif;base64,R0lGODlhAQABAPAAAP///wAAACH/C1hNUCBEYXRhWE1QAz94cAAh+QQFAAAAACwAAAAAAQABAAACAkQBADs=" class="js-start-img-src js-res-img play" data-src-pc="//images.samsung.com/is/image/samsung/assets/consumer/global/vd/monitors/viewfinity-high-resolution-monitor/vd-icon-play.png?$ORIGIN_PNG$" data-src-tablet="//images.samsung.com/is/image/samsung/assets/consumer/global/vd/monitors/viewfinity-high-resolution-monitor/vd-icon-play.png?$ORIGIN_PNG$" data-src-mobile="//images.samsung.com/is/image/samsung/assets/consumer/global/vd/monitors/viewfinity-high-resolution-monitor/vd-icon-play.png?$ORIGIN_PNG$" alt="Play">
                  <img src="data:image/gif;base64,R0lGODlhAQABAPAAAP///wAAACH/C1hNUCBEYXRhWE1QAz94cAAh+QQFAAAAACwAAAAAAQABAAACAkQBADs=" class="js-start-img-src js-res-img pause" data-src-pc="//images.samsung.com/is/image/samsung/assets/consumer/global/vd/monitors/viewfinity-high-resolution-monitor/vd-icon-pause.png?$ORIGIN_PNG$" data-src-tablet="//images.samsung.com/is/image/samsung/assets/consumer/global/vd/monitors/viewfinity-high-resolution-monitor/vd-icon-pause.png?$ORIGIN_PNG$" data-src-mobile="//images.samsung.com/is/image/samsung/assets/consumer/global/vd/monitors/viewfinity-high-resolution-monitor/vd-icon-pause.png?$ORIGIN_PNG$" alt="Pause">
                </button>
              </div>
              <p class="vd-feature__details-description">Experience maximum comfort with an ergonomic monitor, which
                features a height-adjustable stand with pivot, swivel, and tilt options to perfectly match your
                preference.<sup><a href="#desc-section" class="click_sup" title="See disclaimer" data-sup="6">6</a></sup>
              </p>
            </div>
          </div>
