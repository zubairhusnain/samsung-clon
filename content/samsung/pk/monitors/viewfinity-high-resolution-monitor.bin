    .pd-header-navigation-keep {
      display: none
    }
  
    .vd-fixed-nav {
      overflow: hidden;
      position: fixed;
      top: -60px;
      top: -4.16667vw;
      display: flex;
      justify-content: space-around;
      align-items: center;
      width: 100%;
      max-width: 1920px;
      max-width: 133.33333vw;
      height: 60px;
      height: 4.16667vw;
      background-color: #fff;
      transition: top, .3s cubic-bezier(0, .18, .07, 1);
      z-index: 10
    }
  
    @media (min-width:1440px) {
      .vd-fixed-nav {
        top: -60px
      }
    }
  
    @media (min-width:1440px) {
      .vd-fixed-nav {
        max-width: 1920px
      }
    }
  
    @media (min-width:1440px) {
      .vd-fixed-nav {
        height: 60px
      }
    }
  
    .vd-fixed-nav.is-show {
      top: 0;
      z-index: 20
    }
  
    .vd-fixed-nav__tab {
      display: flex;
      justify-content: space-between;
      gap: 10px;
      gap: .69444vw;
      max-width: 948px;
      max-width: 65.83333vw;
      padding: 2px;
      padding: .13889vw
    }
  
    @media (min-width:1440px) {
      .vd-fixed-nav__tab {
        gap: 10px
      }
    }
  
    @media (min-width:1440px) {
      .vd-fixed-nav__tab {
        max-width: 948px
      }
    }
  
    @media (min-width:1440px) {
      .vd-fixed-nav__tab {
        padding: 2px
      }
    }
  
    .vd-fixed-nav__tab-item {
      width: 316px;
      width: 21.94444vw
    }
  
    @media (min-width:1440px) {
      .vd-fixed-nav__tab-item {
        width: 316px
      }
    }
  
    .vd-fixed-nav__tab-link {
      display: block
    }
  
    .vd-fixed-nav__tab-link.is-active .vd-fixed-nav__tab-title-text {
      color: #000
    }
  
    .vd-fixed-nav__tab-link.is-active .vd-fixed-nav__tab-title-text:after {
      opacity: 1
    }
  
    .vd-fixed-nav__tab-title-text {
      position: relative;
      display: block;
      width: fit-content;
      margin: 0 auto;
      padding: 20px 10px 19px;
      padding: 1.38889vw .69444vw 1.31944vw;
      font-family: SamsungSharpSans, SamsungOne, "sans serif";
      font-size: 24px;
      font-size: 1.66667vw;
      line-height: .7;
      color: rgba(0, 0, 0, .4);
      text-align: center;
      transition: color, .2s
    }
  
    @media (min-width:1440px) {
      .vd-fixed-nav__tab-title-text {
        padding: 20px 10px 19px
      }
    }
  
    html[lang^=th] .vd-fixed-nav__tab-title-text {
      font-size: 32.4px;
      font-size: 2.25vw
    }
  
    @media (min-width:1440px) {
      .vd-fixed-nav__tab-title-text {
        font-size: 24px
      }
  
      html[lang^=th] .vd-fixed-nav__tab-title-text {
        font-size: 32.4px
      }
    }
  
