    .m_content-desc ol li {
      position: relative;
      font-size: 12px;
      line-height: 20px;
      color: #666;
      list-style-type: decimal
    }
  
    .m_content-desc ol li a {
      color: inherit;
      box-shadow: none;
      outline: 0
    }
  
    .m_content-desc ol li.is-active a:focus {
      -webkit-box-shadow: 0 0 0 2px #fff;
      box-shadow: 0 0 0 2px #fff
    }
  
    .m_content-desc ol li.is-active .click_disclaimer {
      display: inline-block
    }
  
    .m_content-desc ol li .click_disclaimer {
      display: none;
      position: absolute;
      top: 0;
      left: -48px;
      width: 16px;
      height: 16px
    }
  
    .rtl .m_content-desc ol li .click_disclaimer {
      left: auto;
      right: -48px
    }
  
