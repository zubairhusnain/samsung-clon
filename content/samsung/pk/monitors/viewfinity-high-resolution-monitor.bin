    <!-- Accurate Colors -->
    <div class="vd-colors" id="COLORS">
      <div class="vd-colors__wrap">
        <div class="vd-colors__text">
          <h2 class="vd-common__title" data-title="unmatched color accuracy">Unmatched Color <br
              class="vd-common-br-mo">Accuracy</h2>
        </div>
        <div class="vd-colors__cont swiper-container">
          <button tabindex="-1" type="button" class="swiper-autoplay-stop-btn">
            <span class="hidden">Stop automatic slide show</span>
          </button>
          <div id="tabpanel_id" class="vd-colors__tabpanel-wrap swiper-wrapper">
            <div class="vd-colors__tabpanel swiper-slide" data-option="tab-DCI">
              <div class="vd-colors__tabpanel-img">
                <div class="image">
                  <img src="data:image/gif;base64,R0lGODlhAQABAPAAAP///wAAACH/C1hNUCBEYXRhWE1QAz94cAAh+QQFAAAAACwAAAAAAQABAAACAkQBADs=" class="js-start-img-src js-res-img" data-src-pc="//images.samsung.com/is/image/samsung/assets/consumer/global/vd/monitors/viewfinity-high-resolution-monitor/vd-colors01.jpg?$ORIGIN_JPG$" data-src-tablet="//images.samsung.com/is/image/samsung/assets/consumer/global/vd/monitors/viewfinity-high-resolution-monitor/vd-colors01.jpg?imwidth=1080" data-src-mobile="//images.samsung.com/is/image/samsung/assets/consumer/global/vd/monitors/viewfinity-high-resolution-monitor/vd-colors01-mo.jpg?$ORIGIN_JPG$" alt="A vibrant, colorful jellyfish displayed on a Samsung ViewFinity screen with a darker background, highlighting the monitor's color accuracy with a color spectrum graph(which represents the coverage from 0.0 to 0.8) in the lower-right corner showing the DCI-P3 and sRGB color space coverage.">
                </div>
              </div>
              <div class="vd-colors__tabpanel-text">
                <strong class="vd-colors__tabpanel-title">Wide color gamut <br class="vd-common-br-mo">up to sRGB
                  115%</strong>
                <p class="vd-colors__tabpanel-description">The ViewFinity series covers 99% to 115% of sRGB for vibrant,
                  accurate colors.<sup><a href="#desc-section" class="click_sup" title="See disclaimer" data-sup="1">1</a></sup> Additionally, the S9(S90PC) model achieves 99% of the DCI-P3 standard,
                  delivering richer, more vibrant colors with exceptional precision and accuracy.</p>
              </div>
            </div>
            <div class="vd-colors__tabpanel swiper-slide" data-option="tab-Pantone">
              <div class="vd-colors__tabpanel-img">
                <div class="image">
                  <img src="data:image/gif;base64,R0lGODlhAQABAPAAAP///wAAACH/C1hNUCBEYXRhWE1QAz94cAAh+QQFAAAAACwAAAAAAQABAAACAkQBADs=" class="js-start-img-src js-res-img" data-src-pc="//images.samsung.com/is/image/samsung/assets/consumer/global/vd/monitors/viewfinity-high-resolution-monitor/vd-colors02.jpg?$ORIGIN_JPG$" data-src-tablet="//images.samsung.com/is/image/samsung/assets/consumer/global/vd/monitors/viewfinity-high-resolution-monitor/vd-colors02.jpg?imwidth=1080" data-src-mobile="//images.samsung.com/is/image/samsung/assets/consumer/global/vd/monitors/viewfinity-high-resolution-monitor/vd-colors02-mo.jpg?$ORIGIN_JPG$" alt="A small dog peeking out from under a colorful, striped blanket, with Pantone color swatches displayed on different parts of the blanket. They highlight the Pantone ValidatedTM and Pantone SkinTone ValidatedTM color accuracy of the Samsung ViewFinity monitor.">
                </div>
              </div>
              <div class="vd-colors__tabpanel-text">
                <strong class="vd-colors__tabpanel-title">Pantone <br class="vd-common-br-mo">Validated <br
                    class="vd-common-br-pc">colors</strong>
                <p class="vd-colors__tabpanel-description">With Pantone Validated and Pantone SkinTone Validated
                  certifications, the ViewFinity series accurately reproduces Pantone Matching System (PMS) colors,
                  ensuring reliable and precise color accuracy.<sup><a href="#desc-section" class="click_sup" title="See disclaimer" data-sup="2">2</a></sup></p>
              </div>
            </div>
            <div class="vd-colors__tabpanel swiper-slide" data-option="tab-HDR">
              <div class="anti-reflective__visual">
                <div class="anti-reflective__image-wrap">
                  <div class="anti-reflective__image-inner">
                    <div class="anti-reflective__before">
                      <img src="data:image/gif;base64,R0lGODlhAQABAPAAAP///wAAACH/C1hNUCBEYXRhWE1QAz94cAAh+QQFAAAAACwAAAAAAQABAAACAkQBADs=" class="js-start-img-src js-res-img" data-src-pc="//images.samsung.com/is/image/samsung/assets/consumer/global/vd/monitors/viewfinity-high-resolution-monitor/vd-colors03.jpg?$ORIGIN_JPG$" data-src-tablet="//images.samsung.com/is/image/samsung/assets/consumer/global/vd/monitors/viewfinity-high-resolution-monitor/vd-colors03.jpg?imwidth=1080" data-src-mobile="//images.samsung.com/is/image/samsung/assets/consumer/global/vd/monitors/viewfinity-high-resolution-monitor/vd-colors03-mo.jpg?$ORIGIN_JPG$" alt="Comparison of Standard Dynamic Range (SDR) and High Dynamic Range (HDR) on a Samsung ViewFinity monitor. A woman is standing between two rocky cliffs with vibrant colors and enhanced details on the HDR side. A slider in the center contrasts the differences in brightness and color depth between 8-bit SDR and 10-bit HDR.">
                      <button type="button" class="btn-slider js-before"><span class="blind">Move to the left of the split
                          screen border</span></button>
                    </div>
                    <div class="anti-reflective__after">
                      <img src="data:image/gif;base64,R0lGODlhAQABAPAAAP///wAAACH/C1hNUCBEYXRhWE1QAz94cAAh+QQFAAAAACwAAAAAAQABAAACAkQBADs=" class="js-start-img-src js-res-img" data-src-pc="//images.samsung.com/is/image/samsung/assets/consumer/global/vd/monitors/viewfinity-high-resolution-monitor/vd-colors03-after.jpg?$ORIGIN_JPG$" data-src-tablet="//images.samsung.com/is/image/samsung/assets/consumer/global/vd/monitors/viewfinity-high-resolution-monitor/vd-colors03-after.jpg?imwidth=1080" data-src-mobile="//images.samsung.com/is/image/samsung/assets/consumer/global/vd/monitors/viewfinity-high-resolution-monitor/vd-colors03-after-mo.jpg?$ORIGIN_JPG$" alt="Comparison of Standard Dynamic Range (SDR) and High Dynamic Range (HDR) on a Samsung ViewFinity monitor. A woman is standing between two rocky cliffs with vibrant colors and enhanced details on the HDR side. A slider in the center contrasts the differences in brightness and color depth between 8-bit SDR and 10-bit HDR.">
                      <button type="button" class="btn-slider js-after"><span class="blind">Move to the right of the split
                          screen border</span></button>
                    </div>
                  </div>
                  <div class="anti-reflective__bar">
                    <div class="bar">
                      <button type="button" class="anti-reflective__bar-controller" aria-hidden="true" tabindex="-1">
                        <span class="blind">interactive single feature, horizontal slide</span>
                        <svg width="50" height="50" viewBox="0 0 50 50" fill="none" xmlns="http://www.w3.org/2000/svg"
                          focusable="false" aria-hidden="true">
                          <circle cx="25" cy="25" r="25" fill="white" />
                          <circle cx="25" cy="25" r="25" fill="white" />
                          <path d="M38 25L29 33.6603L29 16.3397L38 25Z" fill="#367AF5" />
                          <path d="M12 25L21 33.6603L21 16.3397L12 25Z" fill="#367AF5" />
                          <path d="M38 25L29 33.6603L29 16.3397L38 25Z" fill="#367AF5" />
                          <path d="M12 25L21 33.6603L21 16.3397L12 25Z" fill="#367AF5" />
                        </svg>
                      </button>
                    </div>
                  </div>
                </div>
              </div>
              <div class="vd-colors__tabpanel-text">
                <strong class="vd-colors__tabpanel-title">Brilliance with HDR <br class="vd-common-br-mo">and 1 billion
                  colors</strong>
                <p class="vd-colors__tabpanel-description">The ViewFinity series, compliant with HDR standards like HDR
                  10, VESA HDR400, and VESA HDR600, delivers exceptional color accuracy.<sup><a href="#desc-section" class="click_sup" title="See disclaimer" data-sup="3">3</a> </sup><sup><a href="#desc-section" class="click_sup" title="See disclaimer" data-sup="4">4</a></sup> Experience over 1 billion colors
                  on high-resolution monitors ranging from QHD to 5K.</p>
              </div>
            </div>
