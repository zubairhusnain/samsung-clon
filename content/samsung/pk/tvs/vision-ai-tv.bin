<!-- global vars -->
<script type="text/javascript">
  window.__MKT_GLOBAL_VARS__ = {
    video: {
      play: 'play',
      pause: 'stop',
    },
    disclaimer: {
      supTitle: 'See disclaimer',
    },
  };
