    <!-- nav -->
<style>
  .mkt-navigation::after {
    display: block;
    height: 56px;
    content: "";
  }
  .mkt-navigation-wrap {
    position: absolute;
    z-index: 1950;
    width: 100%;
    height: 56px;
    margin: 0 auto;
    background: #fff;
  }
  .mkt-navigation-wrap::after {
    position: absolute;
    right: 0;
    bottom: 0;
    left: 0;
    display: block;
    border-bottom: 1px solid rgba(0, 0, 0, 0.2);
    content: "";
  }
  .is-fixed .mkt-navigation-wrap {
    position: fixed;
    top: 0;
    right: 0;
    left: 0;
  }
  .mkt-navigation-inner {
    position: relative;
    display: flex;
    height: 100%;
    align-items: center;
    justify-content: space-between;
    padding: 0vw 1.6666666667vw;
    gap: 30px;
    width: 100%;
    margin: 0 auto;
    max-width: 100vw;
  }
  @media screen and (min-width: 1440px) {
    .mkt-navigation-inner {
      max-width: 1440px;
    }
  }
  @media screen and (max-width: 767px) {
    .mkt-navigation-inner {
      max-width: initial;
    }
  }
  @media screen and (min-width: 1440px) {
    .mkt-navigation-inner {
      padding: 0px 24px;
    }
  }
  @media screen and (max-width: 1279px) {
    .mkt-navigation-inner {
      padding: 0 15px;
    }
  }
  @media screen and (max-width: 767px) {
    .mkt-navigation-inner {
      padding: 0 24px;
      gap: 20px;
    }
  }
  .mkt-navigation-header {
    position: relative;
    z-index: 3;
    display: flex;
    width: 100%;
    height: 100%;
    align-items: center;
    justify-content: space-between;
  }
  .mkt-navigation-headline {
    position: relative;
    display: inline-flex;
    align-items: center;
    font-family: "SamsungSharpSans", arial, sans-serif;
    font-size: 18px;
    line-height: 1.33;
  }
  html.rtl .mkt-navigation-headline {
    font-family: "SamsungSharpSans", "SamsungOne", sans-serif;
  }
  html[lang^=ko] .mkt-navigation-headline {
    font-family: "Samsung Sharp Sans", "SamsungOneKorean", sans-serif;
  }
  html[lang^=th] .mkt-navigation-headline {
    font-family: "SamsungSharpSans", "SamsungOne", arial, sans-serif;
  }
  html[lang^=my] .mkt-navigation-headline {
    font-family: "SamsungSharpSans", "Pyidaungsu", arial, sans-serif;
  }
  html[lang^=zh-CN] .mkt-navigation-headline {
    font-family: "SamsungSharpSans", "Microsoft Yahei", "微软雅黑", Simsun, "宋体", arial, sans-serif;
  }
  html[lang^=zh-TW] .mkt-navigation-headline {
    font-family: "SamsungSharpSans", "Microsoft JhengHei", "微软雅黑", Simsun, "宋体", arial, sans-serif;
  }
  html[lang^=zh-HK] .mkt-navigation-headline {
    font-family: "SamsungSharpSans", "Microsoft JhengHei", "微软雅黑", Simsun, "宋体", arial, sans-serif;
  }
  html[lang^=ja] .mkt-navigation-headline {
    font-family: "SamsungSharpSans", Meiryo, sans-serif;
  }
  html[lang^=ka-GE] .mkt-navigation-headline {
    font-family: "SamsungSharpSans", Sylfaen, sans-serif;
  }
  @media screen and (max-width: 767px) {
    .mkt-navigation-headline {
      position: absolute;
      padding-right: 32px;
      color: transparent;
      font-size: 14px;
    }
  }
  .mkt-navigation-headline-text {
    display: block;
    color: inherit;
  }
  @media screen and (max-width: 767px) {
    .mkt-navigation-menu {
      display: flex;
      flex-grow: 1;
    }
  }
  .mkt-navigation-menu-button {
    position: relative;
    display: flex;
    height: 32px;
    flex-grow: 1;
    align-items: center;
    justify-content: space-between;
  }
  .mkt-navigation-menu-button::after {
    width: 32px;
    height: 32px;
    background-image: url("data:image/svg+xml,%3Csvg id='Icon_Bold_Navigation_Open_down' data-name='Icon / Bold / Navigation / Open_down' xmlns='http://www.w3.org/2000/svg' width='16' height='16' viewBox='0 0 16 16'%3E%3Crect id='Container' width='16' height='16' fill='none'/%3E%3Cpath id='Icon_Bold_Navigation_Open_down-2' data-name='Icon / Bold / Navigation / Open_down' d='M6,7,0,.925.941,0,6,5.123,11.059,0,12,.925Z' transform='translate(2 5)'/%3E%3C/svg%3E%0A");
    background-position: center;
    background-repeat: no-repeat;
    background-size: 16px auto;
    content: "";
  }
  .open .mkt-navigation-menu-button::after {
    transform: rotate(180deg);
  }
  @media screen and (min-width: 768px) {
    .mkt-navigation-menu-button {
      display: none;
