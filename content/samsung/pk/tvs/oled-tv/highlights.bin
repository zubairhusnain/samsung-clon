<section class="static static--auto-game-mode" data-section-scrolled="false">
	<div class="static__cont-wrap">
		<div class="static__cont">
			<div class="static__container-wrap">
				<div class="static__container">
					<div class="static__video-area">

						<!-- static__video-wrap(s) -->
						<figure class="static__video-wrap">
							<video class="static__video__player" poster="https://stg-images.samsung.com/is/image/samsung/assets/global/hq/vd/tvs/oled-tv/highlights/2025-oled-tv-f11-ai-auto-game-mode-pc.jpg" data-poster-pc="https://stg-images.samsung.com/is/image/samsung/assets/global/hq/vd/tvs/oled-tv/highlights/2025-oled-tv-f11-ai-auto-game-mode-pc.jpg" data-poster-mo="https://stg-images.samsung.com/is/image/samsung/assets/global/hq/vd/tvs/oled-tv/highlights/2025-oled-tv-f11-ai-auto-game-mode-mo.jpg" playsinline muted preload="" autoplay="true" loop="true" disableremoteplayback="" tabindex="0">
								<source src="https://stg-images.samsung.com/is/content/samsung/assets/global/hq/vd/tvs/oled-tv/highlights/2025-oled-tv-f11-ai-auto-game-mode-pc.mp4" data-src-pc="https://stg-images.samsung.com/is/content/samsung/assets/global/hq/vd/tvs/oled-tv/highlights/2025-oled-tv-f11-ai-auto-game-mode-pc.mp4" data-src-mo="https://stg-images.samsung.com/is/content/samsung/assets/global/hq/vd/tvs/oled-tv/highlights/2025-oled-tv-f11-ai-auto-game-mode-mo.mp4" type="video/mp4">
							</video>
							<p class="blind">
								A TV screen shows various settings on a bar at the bottom, such as virtual aim point, screen ratio, and minimap zoom. Various video games like The First Descendant play on screen, from genres such as RPG, Sports, and RTS. As the genre changes, the TV uses AI to optimize the settings to the genre.
							</p>
							<div class="static__video__play-wrap--max-w-1260">
								<div class="static__video__play">
									<button type="button" class="static__video-button-controller video-button-controller--pause" title="AI Auto Game Mode Feature Video" tabindex="0" an-tr="oled-vd marketing page-play video-content_click" an-ca="content click" an-ac="feature" an-la="settings optimized victory assured:ai auto game mode:stop video">
										<span class="blind">stop</span>
									</button>
								</div>
							</div>
						</figure>
						<!-- static__video-wrap(e) -->

					</div>
				</div>
			</div>

			<!-- static__text-wrap(s) -->
			<div class="static__text-wrap">
				<div class="static__headline-box">
					<strong class="static__headline">Settings optimized. <br class="br--pc"><br class="br--mo">Victory assured.</strong>
				</div>
				<div class="static__text-area">
					<h2 class="static__text__title">AI Auto Game Mode</h2>
					<p class="static__text__desc">
						Get the best game settings right away. AI automatically detects what you're playing, then optimizes to match the genre — shooters, sports games, RPGs and more.
						So you can just launch and dive right into peak gameplay.<sup><a id="staticAutoGameModeDescription01" href="#staticDescription10" class="static__disc-txt" title="see disclaimer">10</a></sup>
					</p>
				</div>
			</div>
			<!-- static__text-wrap(e) -->

		</div>
	</div>
</section>
