		<script>
			;(function(win,doc,callback){'use strict';callback=callback||function(){};function detach(){if(doc.addEventListener){doc.removeEventListener('DOMContentLoaded',completed);}else{doc.detachEvent('onreadystatechange',completed);}}function completed(){if(doc.addEventListener||event.type==='load'||doc.readyState==='complete'){detach();callback(window,window.jQuery);}}function init(){if (doc.addEventListener){doc.addEventListener('DOMContentLoaded',completed);}else{doc.attachEvent('onreadystatechange',completed);}}init();})(window,document,function(win,$){
				/* RC01_Static Content > Footer(Javascript) : static--auto-game-mode(s) */
window.setStaticAutoGameMode = () => {
	const $staticAutoGameMode = $(".static--auto-game-mode");

	const updateStaticAutoGameMode = () => {
		const currentWidth = $(window).width();

		$staticAutoGameMode.find('.static__image-wrap--bg').find('.static__image').each(function () {
			const $this = $(this);
			const newSrc = window.isMobile ? $this.data('src-mo') : $this.data('src-pc');
			$this.attr('src', newSrc);
		});

		$staticAutoGameMode.find('.static__video__player').each(function () {
			const $video = $(this);
			const $source = $video.find('source');
			const newVideoSrc = window.isMobile ? $source.data('src-mo') : $source.data('src-pc');
			const newPosterSrc = window.isMobile ? $video.data('poster-mo') : $video.data('poster-pc');

			$source.attr('src', newVideoSrc);
			$video.attr('poster', newPosterSrc);
			$video[0].load();
		});
	};


	updateStaticAutoGameMode();
	$(window.mediaQueryForResponsive).on("change", function () {
		updateStaticAutoGameMode();
	});
};
/* RC01_Static Content > Footer(Javascript) : static--auto-game-mode(e) */
			});
		</script>
	
