<section class="static static--description" data-section-scrolled="false">
	<div class="static__cont-wrap">
		<div class="static__cont">
			<div class="static__container-wrap">
				<div class="static__container">

					<div class="static__list-wrap">
						<!-- static__list.static__list--refer(s) -->
						<div class="static__list static__list--refer" role="list">
							<div class="static__list__item" role="listitem">
								<p>
									Image simulated for illustration purposes. Any changes in appearance and design specifications that do not affect product performance may occur without prior notice. UI, content and services may vary by region and are subject to change without notice. 
								</p>
							</div>
							<div class="static__list__item" role="listitem">
								<p>
									Viewing experience may vary according to types of content and format.
								</p>
							</div>
							<div class="static__list__item" role="listitem">
								<p>
									Features may vary by model. Check the specifications of each model for details.
								</p>
							</div>
							<div class="static__list__item" role="listitem">
								<p>
									Global No.1 TV: Source - Omdia, Feb-2025. Results are not an endorsement of Samsung. Any reliance on these results is at the third-party’s own risk.
								</p>
							</div>
							<div class="static__list__item" role="listitem">
								<p>
									Tizen OS upgrades will be supported for up to 7 years starting from 2025, for products released in the year 2025. Please note that this upgrade does not cover the hardware performance, features or durability.
								</p>
							</div>
<div class="static__list__item" role="listitem">
								<p>
									Above is for general information purposes only. Final product configuration and features may differ from the ones depicted here and may vary depending on the region/country. Errors & Omissions are expected. Users are advised to check the most current features and specifications applicable to a product before purchase from Samsung representative/dealer.
								</p>
							</div>
<div class="static__list__item" role="listitem">
								<p>
									All third party logos/marks/content shown are registered/owned/licensed logos/marks/content of respective brand owners
								</p>
							</div>
						</div>
						<!-- static__list.static__list--refer(e) -->
						<!-- static__list.static__list--desc(s) -->
						<ol class="static__list static__list--desc" role="list">
							<li class="static__list__item" id="staticDescription01" role="listitem">
								<a href="#staticHdrDescription01" class="static__description-button--back" title="">
									<span class="blind">Back to Location</span>
								</a>
								<p>
									OLED HDR Pro: The range of HDR luminance is based on internal testing standards and is subject to change according to viewing conditions or specifications. The feature OLED HDR Pro is only available in S95F model.
								</p>
							</li>
							<li class="static__list__item" id="staticDescription02" role="listitem">
								<a href="#staticGlareFreeDescription01" class="static__description-button--back" title="">
									<span class="blind">Back to Location</span>
								</a>
								<p>
									Glare Free: Verified 'Glare Free' performance by UL Solutions, based on Unified Glare Rating (UGR) assessments. Verification issued when: Reflection Glare UGR ≤ 10, Discomfort Glare UGR ≤ 22, and Disability Glare UGR ≤ 34. Results based on test conducted under indoor lighting conditions. The feature Glare Free is only available in QN950F, QN900F, QN90F, S95F models.
								</p>
							</li>
							<li class="static__list__item" id="staticDescription03" role="listitem">
								<a href="#staticVisionAiTab01" class="static__description-button--back" title="">
									<span class="blind">Back to Location</span>
								</a>
								<p>
									4K AI Upscaling Pro: 4K AI Upscaling may not apply to PC connection and Game Mode.
								</p>
							</li>
							<li class="static__list__item" id="staticDescription04" role="listitem">
								<a href="#staticVisionAiTab04" class="static__description-button--back" title="">
									<span class="blind">Back to Location</span>
								</a>
								<p>
									Bixby: Voice commands and Multi turn is supported for 10 languages (US/UK/IN(en)/DE/FR/IT/ES/BR/MX/KR). Not all accents, dialects and expressions recognized.
								</p>
							</li>
							<li class="static__list__item" id="staticDescription05" role="listitem">
								<a href="#staticVisionAiTab05" class="static__description-button--back" title="">
									<span class="blind">Back to Location</span>
								</a>
								<p>
									Pet Care: Real-time streaming on mobile devices is supported on Android OS 11.0 and higher versions or iOS 16.0 and higher versions, and is available on 2025 Samsung TVs and later models. It only works when the TV is turned off. TV must be connected to a power source to use this feature. TV and mobile device must be connected to SmartThings to send and receive notifications.
								</p>
							</li>
							<li class="static__list__item" id="staticDescription06" role="listitem">
								<a href="#staticVisionAiTab06" class="static__description-button--back" title="">
									<span class="blind">Back to Location</span>
								</a>
								<p>
									Universal Gesture: Available apps and services may vary and are subject to change without notice. Only supported on Galaxy Watch4 and later models, and Wear OS 5 and higher versions.
								</p>

							</li>
							<li class="static__list__item" id="staticDescription07" role="listitem">
								<a href="#staticVisionAiTab07" class="static__description-button--back" title="">
									<span class="blind">Back to Location</span>
								</a>
								<p>
									Samsung Knox Security: Samsung Knox Security applies to Samsung TVs powered by Tizen®, launched since 2015. Latest software update is required.
								</p>
							</li>
							<li class="static__list__item" id="staticDescription08" role="listitem">
								<a href="#staticAutoLowLatencyModeDescription01" class="static__description-button--back" title="">
									<span class="blind">Back to Location</span>
								</a>
								<p>
									Auto Low Latency Mode: Low input lag is measured based on internal testing conditions and it is subject to change according to game settings or specific conditions.
								</p>
							</li>
							<li class="static__list__item" id="staticDescription09" role="listitem">
								<a href="#staticFreesyncDescription01" class="static__description-button--back" title="">
									<span class="blind">Back to Location</span>
								</a>
								<p>
									Viewing experience may vary according to types of content and graphics processing unit, as well as network connection speeds and ping levels when gaming on the cloud.
								</p>
							</li>
							<li class="static__list__item" id="staticDescription10" role="listitem">
								<a href="#staticAutoGameModeDescription01" class="static__description-button--back" title="">
									<span class="blind">Back to Location</span>
								</a>
								<p>
									AI Auto Game Mode: AI Auto Game Mode is available for certain console and PC games.
								</p>
							</li>
							<li class="static__list__item" id="staticDescription11" role="listitem">
								<a href="#staticAutoGameModeDescription01" class="static__description-button--back" title="">
									<span class="blind">Back to Location</span>
								</a>
								<p>
									NQ4 AI Gen3 Processor: The feature NQ4 AI Gen3 Processor is only available in QN950F model.
								</p>
							</li>
<li class="static__list__item" id="staticDescription11" role="listitem">
								<a href="#staticAutoGameModeDescription01" class="static__description-button--back" title="">
									<span class="blind">Back to Location</span>
								</a>
								<p>
									 Motion Xcelerator 165Hz: The feature Motion Xcelerator 165Hz is only available in QN90F model.
								</p>
							</li>
						</ol>
						<!-- static__list.static__list--desc(e) -->

					</div>
				</div>
			</div>
		</div>
	</div>
</section>
<!-- RC01_Static Content > Body(HTML) : static--description(e) -->
	
</div>
<div class="static-content aem-GridColumn aem-GridColumn--default--12">
	
		<style scoped="scoped">
			div.nv-g-breadcrumb {background: #fff !important;}
		</style>
	
	
	<!-- RC01_Static Content > Body(HTML) : Common Setting : Bottom(s) -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/beerslider@1.0.3/dist/BeerSlider.min.css"/>
<script src="https://cdn.jsdelivr.net/npm/beerslider@1.0.3/dist/BeerSlider.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/gsap.min.js"></script>
<!-- RC01_Static Content > Body(HTML) : Common Setting : Bottom(e) -->
	
		<script>
			;(function(win,doc,callback){'use strict';callback=callback||function(){};function detach(){if(doc.addEventListener){doc.removeEventListener('DOMContentLoaded',completed);}else{doc.detachEvent('onreadystatechange',completed);}}function completed(){if(doc.addEventListener||event.type==='load'||doc.readyState==='complete'){detach();callback(window,window.jQuery);}}function init(){if (doc.addEventListener){doc.addEventListener('DOMContentLoaded',completed);}else{doc.attachEvent('onreadystatechange',completed);}}init();})(window,document,function(win,$){
				/* RC01_Static Content > Footer(Javascript) : Common Setting : Bottom(s) */
$(document).ready(() => {

	/* 반응형 상태 관리 : 현재 화면 크기에 따라 모바일/데스크톱 상태를 동적으로 업데이트 */
	window.debounce = (func, delay) => {
		let timeout;
		return (...args) => {
			clearTimeout(timeout);
			timeout = setTimeout(() => func.apply(null, args), delay);
		};
	};

	window.mediaQueryForResponsive = window.matchMedia("(max-width: 767px)");
	window.isMobile = window.mediaQueryForResponsive.matches;

	function handleResponsiveChange(event) {
		window.isMobile = event.matches;
		console.log(`##### 화면 전환됨: ${window.isMobile ? '모바일' : '데스크톱'} #####`);
	}
	handleResponsiveChange(window.mediaQueryForResponsive);
	window.mediaQueryForResponsive.addEventListener("change", handleResponsiveChange);


	/* 초기 실행: 모든 섹션의 관련 함수 호출 */
	const staticSectionInit = () => {
		window.setStaticKV();
		window.setStaticManifesto();
		window.setStaticDisplay();
		window.setStaticHdr();
		//window.setStaticGlareFree();
		window.setStaticVisionAi();
		window.setStaticBestGamingTV();
		window.setStaticAutoLowLatencyMode();
		window.setStaticFreesync();
		window.setStaticGSyncCompatible();
		window.setStaticAutoGameMode();
		window.setStaticDesign();
	};

	/* 각 섹션 비디오 버튼 영역 제어 */
	const initStaticVideoPlay = function (containerClass, anLaText) {
		$(containerClass).find(".static__video__play").each(function () {
			const $videoPlay = $(this);
			const $videoWrap = $videoPlay.closest(".static__video-wrap");
			const $video = $videoWrap.find("video.static__video__player");
			const $buttonController = $videoPlay.find(".static__video-button-controller");
			const $buttonText = $buttonController.find(".blind");

			const toggleOpacity = function (event, isActive) {
				if (isActive) {
					$videoPlay.css("opacity", 1);
				} else {
					if (!$videoPlay.is(":focus") && !$videoPlay.find(":focus").length) {
						$videoPlay.css("opacity", 0);
					}
				}
			};

			const toggleFocusClass = function (event, isActive) {
				$(event.currentTarget).toggleClass("active--focus", isActive);
			};

			$videoWrap.add($buttonController).off("mouseenter focusin mouseleave focusout").on("mouseenter focusin mouseleave focusout", function (event) {
				const isActive = event.type === "mouseenter" || event.type === "focusin";
				toggleOpacity(event, isActive);
				toggleFocusClass(event, isActive);
			});

			$buttonController.off("click").on("click", function () {
				if ($video.length && $video[0]) {
					if ($video[0].paused) {
						$video[0].play();
						$buttonController.addClass("video-button-controller--pause");
						$buttonText.text("stop");
						$buttonController.attr("an-la", anLaText + ":stop video");
					} else {
						$video[0].pause();
						$buttonController.removeClass("video-button-controller--pause");
						$buttonText.text("play");
						$buttonController.attr("an-la", anLaText + ":play video");
					}
				}
			});
		});
	};

	// static--vision-ai는 개별 처리하므로 videoSectionsData에서 제외
	const videoSectionsData = [
		{ class:".static--kv", text:"enrich your experience with samsung vision ai" },
		{ class:".static--manifesto", text:"oled tv" },
		{ class:".static--display", text:"power the ultimate oled experience with infinite contrast:oled display with nq4 ai gen3 processor" },
		{ class:".static--best-gaming-tv", text:"level up to an immersive gaming theater:oled gaming tv with motion xcelerator 165hz" },
		{ class:".static--auto-low-latency-mode", text:"low latency smooth moves:auto low latency mode" },
		{ class:".static--auto-game-mode", text:"settings optimized victory assured:ai auto game mode" },
		{ class:".static--design", text: "redefine your space with a sleek centerpiece:oled design" }
	];

	// 일반 섹션 초기화
	$.each(videoSectionsData, function (index, section) {
		initStaticVideoPlay(section.class, section.text);
	});

	// static--vision-ai 개별 처리
	$(".static--vision-ai").find(".static__video__play").each(function () {
		const $videoPlay = $(this);
		const $videoWrap = $videoPlay.closest(".static__video-wrap");
		const $video = $videoWrap.find("video.static__video__player");
		const $buttonController = $videoPlay.find(".static__video-button-controller");
		const $buttonText = $buttonController.find(".blind");

		const toggleOpacity = (event, isActive) => {
			if (isActive) {
				$videoPlay.css("opacity", 1);
			} else {
				if (!$videoPlay.is(":focus") && !$videoPlay.find(":focus").length) {
					$videoPlay.css("opacity", 0);
				}
			}
		};

		const toggleFocusClass = (event, isActive) => {
			$(event.currentTarget).toggleClass("active--focus", isActive);
		};

		$videoWrap.add($buttonController).on("mouseenter focusin mouseleave focusout", function (event) {
			const isActive = event.type === "mouseenter" || event.type === "focusin";
			toggleOpacity(event, isActive);
			toggleFocusClass(event, isActive);
		});

		$buttonController.on("click", function () {
			if ($video.length && $video[0]) {
				const $this = $(this);
				const tabPanelId = $this.parents(".static__tab-panel").attr("id");

				if ($video[0].paused) {
					$video[0].play();
					$buttonController.addClass("video-button-controller--pause");
					$buttonText.text("stop");

					switch (tabPanelId) {
						case "staticVisionAiTabpanel01":
							$buttonController.attr("an-la", "unlock a world of new experiences with samsung vision ai:click to search:stop video");
							break;
						case "staticVisionAiTabpanel02":
							$buttonController.attr("an-la", "unlock a world of new experiences with samsung vision ai:live translate:stop video");
							break;
						case "staticVisionAiTabpanel04":
							$buttonController.attr("an-la", "unlock a world of new experiences with samsung vision ai:4k ai upscaling pro:stop video");
							break;
					}
				} else {
					$video[0].pause();
					$buttonController.removeClass("video-button-controller--pause");
					$buttonText.text("play");

					switch (tabPanelId) {
						case "staticVisionAiTabpanel01":
							$buttonController.attr("an-la", "unlock a world of new experiences with samsung vision ai:click to search:play video");
							break;
						case "staticVisionAiTabpanel02":
							$buttonController.attr("an-la", "unlock a world of new experiences with samsung vision ai:live translate:play video");
							break;
						case "staticVisionAiTabpanel04":
							$buttonController.attr("an-la", "unlock a world of new experiences with samsung vision ai:4k ai upscaling pro:play video");
							break;
					}
				}
			}
		});
	});


	/* 스크롤 관련 처리 : 특정 섹션이 뷰포트에 진입하거나 벗어날 때 동작 수행 */
	const staticSectionCheckAndRunOnce = () => {
		$(".static-content").find("[data-section-scrolled]").each(function () {
			const $this = $(this);
			const contentTop = $this.offset().top;
			const contentBottom = contentTop + $this.outerHeight();
			const scrollTop = $(window).scrollTop();
			const viewportBottom = scrollTop + $(window).height();
			const $video = $this.find("video.static__video__player");

			// 뷰포트 안에 들어온 경우
			if (contentTop < viewportBottom && contentBottom > scrollTop) {
				// console.log(`### 섹션 진입: ${$this.attr('class')}, data-section-scrolled: false`);

				if ($this.attr("data-section-scrolled") === "false") {

					$this.attr("data-section-scrolled", "true");

					// 비디오 자동 재생
					if ($video.length) {
						$video.each(function () {
							const videoElement = this;
							if (videoElement.paused) {
								videoElement.play().then(() => {
									console.log(`비디오 자동 재생 성공: ${videoElement.src}, 섹션: ${$this.attr('class')}`);
								}).catch(err => console.error(`비디오 재생 오류: ${err.message}`));
							}
						});
					}

					// 각 섹션에 맞는 전용 함수 호출
					if ($this.hasClass("static--kv")) {
						window.setStaticKV();
					} else if ($this.hasClass("static--manifesto")) {
						window.setStaticManifesto();
					} else if ($this.hasClass("static--display")) {
						window.setStaticDisplay();
					} else if ($this.hasClass("static--hdr")) {
						window.setStaticHdr();
					} else if ($this.hasClass("static--glare-free")) {
						window.setStaticGlareFree();
					} else if ($this.hasClass("static--vision-ai")) {
						window.setStaticVisionAi();
					} else if ($this.hasClass("static--best-gaming-tv")) {
						window.setStaticBestGamingTV();
					} else if ($this.hasClass("static--auto-low-latency-mode")) {
						window.setStaticAutoLowLatencyMode();
					} else if ($this.hasClass("static--freesync")) {
						window.setStaticFreesync();
					} else if ($this.hasClass("static--g-sync-compatible")) {
						window.setStaticGSyncCompatible();
					} else if ($this.hasClass("static--auto-game-mode")) {
						window.setStaticAutoGameMode();
					} else if ($this.hasClass("static--design")) {
						window.setStaticDesign();
					}

				}
			} else {
				// 특정 섹션에서만 data-section-scrolled 초기화
				if ($this.hasClass("static--glare-free")) {
					$this.attr("data-section-scrolled", "false");
				}
			}

		});
	};

	staticSectionInit(); // 초기 한번 실행
	$(window).on("scroll", staticSectionCheckAndRunOnce); // 스크롤 시 실행

	const updateStaticMarginTop = () => {
		let staticMarginTop = $(".static--description .static__list--desc").css("margin-top");
		return parseInt(staticMarginTop, 10) || 0;
	};

	const scrollDownToTarget = (targetId, offsetAdjustment = 0) => {
		const targetElement = $(targetId);
		
		if (targetElement.length) {
			const navigationWrapHeight = $(".floating-navigation--no-menu .floating-navigation__wrap").outerHeight() || 0;
			const targetOffsetTop = targetElement.offset().top;
			const windowHeight = $(window).height();
			const elementHeight = targetElement.outerHeight();

			const finalScrollPosition = (targetOffsetTop + navigationWrapHeight) - windowHeight / 2 + elementHeight / 2;

			$("html, body").stop(true).scrollTop(finalScrollPosition);

		}
	};

	const scrollUpToTarget = (targetId) => {
		const targetElement = $(targetId);

		if (targetElement.length) {
			let navigationWrapHeight = $(".floating-navigation--no-menu .floating-navigation__wrap").outerHeight() || 0;
			let targetOffsetTop;
			let finalScrollPosition;

			// staticVisionAiTab 먼저 처리
			if (targetId.includes("staticVisionAiTab")) {
				targetOffsetTop = Math.round($('#staticVisionAi').offset().top);
				finalScrollPosition = targetOffsetTop + navigationWrapHeight;
			}
			// staticFreesyncAndGSyncCompatibleGroup 예외 처리
			else if (targetId === "#staticFreesyncAndGSyncCompatibleGroup") {
				const $freesync = $(".static--freesync");
				const $gsync = $(".static--g-sync-compatible");

				const freesyncHeight = $freesync.outerHeight(true) || 0;
				const gsyncHeight = $gsync.outerHeight(true) || 0;

				const groupTop = Math.min($freesync.offset().top, $gsync.offset().top);
				const groupHeight = freesyncHeight + gsyncHeight;

				const windowHeight = $(window).height();

				finalScrollPosition = groupTop - (windowHeight / 2) + (groupHeight / 2);
			}
			// 일반 처리
			else {
				targetOffsetTop = targetElement.offset().top;
				let windowHeight = $(window).height();
				let elementHeight = targetElement.outerHeight();

				finalScrollPosition = window.isMobile
					? (targetOffsetTop + (navigationWrapHeight / 2)) - windowHeight / 2 + elementHeight / 2
					: (targetOffsetTop - navigationWrapHeight) - windowHeight / 2 + elementHeight / 2;
			}

			$("html, body").stop(true).scrollTop(finalScrollPosition);

			// staticVisionAiTab 초점 처리
			if (targetId.includes("staticVisionAiTab")) {
				targetElement.attr("tabindex", "0").focus();

				const secondaryTargetId = targetElement.find("a").attr("href");
				const secondaryTargetElement = $(secondaryTargetId);

				if (secondaryTargetElement.length) {
					secondaryTargetElement.attr("tabindex", "0").focus();
					secondaryTargetElement.on("blur", () => secondaryTargetElement.removeAttr("tabindex"));
				}

				targetElement.on("blur", () => targetElement.removeAttr("tabindex"));
			}
		}
	};

	const $staticDiscTxt = $(".static__disc-txt");
	let staticMarginTop = updateStaticMarginTop();
	$staticDiscTxt.on("click", function (event) {
		event.preventDefault();
		const targetId = $(this).attr("href");

		// 모든 .static__list__item에서 active--focus 클래스 제거
		$(".static__list--desc .static__list__item").removeClass("active--focus");

		// targetId에 해당하는 요소에 active--focus 클래스 추가
		$(targetId).addClass("active--focus");

		// 스크롤 이동
		scrollDownToTarget(targetId, staticMarginTop);
	});

	const $staticListDescLinks = $(".static__list--desc li .static__description-button--back");
	$staticListDescLinks.on("click", function (event) {
		event.preventDefault();
		const targetId = $(this).attr("href");
		const currentWidth = $(window).width();

		// 모든 .static__list__item에서 active--focus 클래스 제거
		$(".static__list--desc .static__list__item").removeClass("active--focus");

		// 브라우저 중앙에 위치하도록 스크롤
		scrollUpToTarget(targetId, true);

		if (window._staticVisionAiTabSlider) {
			if (window.isMobile && (targetId === "#staticVisionAiTab07" || targetId === "#staticVisionAiTab08") || targetId === "#staticVisionAiTab09") {
				window._staticVisionAiTabSlider.slideTo(1, 600);

			} else {
				window._staticVisionAiTabSlider.slideTo(0, 600);
			}
		}
	});

	$(window.mediaQueryForResponsive).on("change", () => {
		const navigationWrapHeight = $(".floating-navigation--no-menu .floating-navigation__wrap").outerHeight() || 0;
		staticMarginTop = updateStaticMarginTop();
	});

});
/* RC01_Static Content > Footer(Javascript) : Common Setting : Bottom(e) */
			});
		</script>
	
</div>













