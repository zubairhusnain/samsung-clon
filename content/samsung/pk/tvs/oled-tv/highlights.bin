	position: relative;
}
.static--glare-free .static__container .static--glare-free__before-after-slider-area {
	position: relative;
	display: block;
	margin: 0 auto;
	width: 100%;
	max-width: 1260px;
	height: auto;
}
.static--glare-free .static__container .static--glare-free__before-after-slider-wrap .static--glare-free__before-after-slider {
	width: 100%;
}

.static--glare-free .static__container .static--glare-free__before-after-slider-wrap .beer-handle {
	height: 100%;
	border-radius: 0;
	background: none;
	box-shadow: none;
	z-index: 10;
}
.static--glare-free .static__container .static--glare-free__before-after-slider-wrap .beer-handle::before,
.static--glare-free .static__container .static--glare-free__before-after-slider-wrap .beer-handle::after {
	display: none;
}

.static--glare-free .static__container .static--glare-free__before-after-slider-wrap .beer-handle .beer-handle__circle {
	background: #fff;
	border-radius: 50%;
	box-shadow: 0 0 6px transparent;
	color: #000;
	width: 60px;
	height: 60px;
	left: 50%;
	pointer-events: none;
	position: absolute;
	top: 50%;
	transform: translate3d(-50%, -50%, 0);
	transition: background .3s, box-shadow .3s, opacity .5s .25s;
}
.static--glare-free .static__container .static--glare-free__before-after-slider-wrap .beer-handle .beer-handle__circle::before,
.static--glare-free .static__container .static--glare-free__before-after-slider-wrap .beer-handle .beer-handle__circle::after {
	border-left: 2px solid;
	border-top: 2px solid;
	content: "";
	position: absolute;
	top: 50%;
	transform-origin: 0 0;
	width: 14px;
	height: 14px;
	color: #006bea;
	z-index: 10;
}

.static--glare-free .static__container .static--glare-free__before-after-slider-wrap .beer-handle .beer-handle__circle::before {
	left: 11px;
	transform: rotate(-45deg);
}
.static--glare-free .static__container .static--glare-free__before-after-slider-wrap .beer-handle .beer-handle__circle::after {
	right: -2px;
	transform: rotate(135deg);
}

.static--glare-free .static__container .static--glare-free__before-after-slider-wrap .beer-handle .beer-handle__bar {
	position: absolute;
	top: 0;
	left: 50%;
	transform: translateX(-50%);
	z-index: 10;
	height: 100%;
	width: 2px;
	background-color: #fff;
	background-size: 2px;
}

.static--glare-free .static__container .static--glare-free__before-after-slider-wrap .beer-reveal {
	will-change: width;
	transition: width 0.3s cubic-bezier(0.25, 1, 0.5, 1);
}

.static--glare-free .static__container .static--glare-free__before-after-slider-wrap .beer-handle {
	will-change: left;
	transition: left 0.3s cubic-bezier(0.25, 1, 0.5, 1);
}

.static--glare-free .static__container .static--glare-free__before-after-tap-wrap {
	position: absolute;
	top: 2px;
	left: calc(50%);
	display: flex;
	width: calc(100% - 4px);
	max-width: 1260px;
	height: calc(100% - 4px);
	transform: translateX(-50%);
	z-index: 1;
}
.static--glare-free .static__container .static--glare-free__before-after-tap-wrap .static--glare-free__before-after-tap {
	height: 100%;
}
.static--glare-free .static__container .static--glare-free__before-after-tap-wrap .static--glare-free__before-after-tap-right {
	flex: 1;
}
.static--glare-free .static__container .static--glare-free__before-after-tap-wrap .static--glare-free__before-after-tap-button {
