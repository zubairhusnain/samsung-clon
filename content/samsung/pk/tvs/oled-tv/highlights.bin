<!-- RC01_Static Content > Body(HTML) : static--vision-ai(e) -->
	
		<script>
			;(function(win,doc,callback){'use strict';callback=callback||function(){};function detach(){if(doc.addEventListener){doc.removeEventListener('DOMContentLoaded',completed);}else{doc.detachEvent('onreadystatechange',completed);}}function completed(){if(doc.addEventListener||event.type==='load'||doc.readyState==='complete'){detach();callback(window,window.jQuery);}}function init(){if (doc.addEventListener){doc.addEventListener('DOMContentLoaded',completed);}else{doc.attachEvent('onreadystatechange',completed);}}init();})(window,document,function(win,$){
				/* RC01_Static Content > Footer(Javascript) : static--vision-ai(s) */
window._staticVisionAiTabSlider = null;
window.setStaticVisionAi = () => {

	const $staticVisionAi = $(".static--vision-ai");
	const $staticVisionAiTabWrap = $staticVisionAi.find(".static__tab-wrap");
	const $staticVisionAiTabPanelWrap = $staticVisionAi.find(".static__tab-panel-wrap");
	const $staticVisionAiTabSlider = $staticVisionAiTabWrap.find(".static--vision-ai__tab-slider");


	const updateStaticVisionAiTabSliderAriaLabel = (currentIdx, slidesPerPage) => {
		const $bullets = $(".static--vision-ai .static__tab-wrap .swiper-pagination-bullet");

		$bullets.each((idx, el) => {
			const $el = $(el);
			const isActive = idx === Math.floor(currentIdx / slidesPerPage);
			const pageNumber = idx + 1;

			const ariaLabel = `Page ${pageNumber}: unlock a world of new experiences with samsung vision ai${isActive ? ". Selected" : ""}`;
			$el.attr("aria-label", ariaLabel);
		});
	};

	const initStaticVisionAiTabSlider = () => {
		const staticVisionAiTabSliderOptions = {
			observer: true,
			observeParents: true,
			watchOverflow: true,
			loop: false,
			slidesPerView: "auto",
			spaceBetween: 0,
			centeredSlides: true,
			speed: 400,
			pagination: {
				el: ".static--vision-ai .static__tab-wrap .swiper-pagination",
				type: "bullets",
				clickable: true,
				renderBullet: (idx, className) => `
					<button
						role="listitem"
						class="swiper-pagination-bullet ${className ? className.trim() : ''}"
						aria-label="Slide ${idx + 1}: unlock a world of new experiences with samsung vision ai"
						data-slide-index="${idx}"
						an-tr="oled-vd marketing page-index-indication"
						an-ca="indication"
						an-ac="carousel"
						an-la="carousel:index:${idx + 1}"
					</button>
				`,
			},
			on: {
				init() {
					setTimeout(() => {
						updateStaticVisionAiTabSliderAriaLabel(this.realIndex, this.params.slidesPerView);
					}, 200);
				},
				slideChangeTransitionEnd() {
					updateStaticVisionAiTabSliderAriaLabel(this.realIndex, this.params.slidesPerView);
				},
			},
		};

		_staticVisionAiTabSlider = new Swiper($staticVisionAiTabSlider[0], staticVisionAiTabSliderOptions);
	};

	const destroyStaticVisionAiTabSlider = () => {
		if (_staticVisionAiTabSlider) {
			_staticVisionAiTabSlider.destroy(true, true);
			_staticVisionAiTabSlider = null;
		}
	};

	const updateStaticVisionAi = () => {
		const currentWidth = $(window).width();

		if (window.isMobile) {
			if (!_staticVisionAiTabSlider) {
				initStaticVisionAiTabSlider();
			}
		} else {
			destroyStaticVisionAiTabSlider();
		}

		// 반응형 이미지 업데이트 : $staticVisionAiTabWrap
		$staticVisionAiTabWrap.find('.static__image-wrap').find('.static__image').each(function () {
			const $this = $(this);
			const newSrc = window.isMobile ? $this.data('src-mo') : $this.data('src-pc');

			$this.attr('src', newSrc);
		});

		// 반응형 이미지 업데이트 : $staticVisionAiTabPanelWrap
		$staticVisionAiTabPanelWrap.find('.static__image-wrap').find('.static__image').each(function () {
			const $this = $(this);
			const newSrc = window.isMobile ? $this.data('src-mo') : $this.data('src-pc');

			$this.attr('src', newSrc);
		});

		// 반응형 이미지 업데이트 : $staticVisionAi
		$staticVisionAi.find('.static__video__player').each(function () {
			const $video = $(this);
			const $source = $video.find('source');
			const newVideoSrc = window.isMobile ? $source.data('src-mo') : $source.data('src-pc');
			const newPosterSrc = window.isMobile ? $video.data('poster-mo') : $video.data('poster-pc');

			$source.attr('src', newVideoSrc);
			$video.attr('poster', newPosterSrc);
			$video[0].load();
		});
	};

	const updateActiveStaticVisionAiTab = ($StaticVisionAiTab) => {
		const $staticVisionAiContainer = $StaticVisionAiTab.closest(".static--vision-ai");
		const targetId = $StaticVisionAiTab.attr("aria-controls");

		$staticVisionAiContainer.find("video").each(function () {
			this.pause();
			this.currentTime = 0;
		});

		$staticVisionAiContainer.find(".static__tab-btn").removeClass("static__tab-btn--active");
		$StaticVisionAiTab.addClass("static__tab-btn--active");

		const $targetItem = $staticVisionAiContainer.find(".static__tab-panel").removeClass("static__tab-panel--active").filter(`#${targetId}`).addClass("static__tab-panel--active");

		const $video = $targetItem.find('video');
		const $buttonController = $targetItem.find(".static__video-button-controller");
		const $buttonText = $buttonController.find(".blind");

		if ($video.length > 0) {
			$video.get(0).currentTime = 0;
			$video.get(0).play();
			$buttonController.addClass("video-button-controller--pause");
			$buttonText.text("stop");
		}
	};

	$(document).on("click keydown", ".static__tab-btn", function (e) {
		if (e.type === "click" || ["Enter", " "].includes(e.key)) {
			e.preventDefault();
			const $this = $(this);
			const targetIndex = $this.parent().index();

			updateActiveStaticVisionAiTab($this);

			if (_staticVisionAiTabSlider && typeof _staticVisionAiTabSlider.slideTo === "function") {
				_staticVisionAiTabSlider.slideTo(targetIndex, 400);
			}
		}
	});

	$(document).on("focus", ".static__tab-btn", function () {
		updateActiveStaticVisionAiTab($(this));
	});

	updateStaticVisionAi();
	$(window.mediaQueryForResponsive).on("change", function (event) {
		updateStaticVisionAi();
	});

};
/* RC01_Static Content > Footer(Javascript) : static--vision-ai(e) */
			});
		</script>
	
</div>
