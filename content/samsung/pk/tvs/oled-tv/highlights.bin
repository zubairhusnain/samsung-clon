					<div class="static__tab-panel-wrap">
						<div class="static__tab-panel static__tab-panel--active" id="staticVisionAiTabpanel01" role="tabpanel" aria-labelledby="static-vision-ai-tab-1">
							<div class="static__tab-panel__content">
								<!-- static__tab-panel__text(s) -->
								<div class="static__tab-panel__text">
									<h2 class="static__tab-panel__title">4K AI Upscaling Pro</h2>
									<p class="static__tab-panel__desc">
										Enjoy your content in stunning 4K resolution, even if it wasn't filmed that way. AI can boost your favorite shows and movies to provide a clear, sharp definition.<sup><a href="#staticDescription03" class="static__disc-txt" title="see disclaimer">3</a></sup>
									</p>
								</div>
								<!-- static__tab-panel__text(e) -->

								<!-- static__video-wrap(s) -->
								<figure class="static__video-wrap">
									<video class="static__video__player" poster="https://stg-images.samsung.com/is/image/samsung/assets/global/hq/vd/tvs/oled-tv/highlights/vision-ai/others/2025-oled-tv-f06-1-samsung-vision-ai-4k-ai-upscaling-pro-pc.jpg" data-poster-pc="https://stg-images.samsung.com/is/image/samsung/assets/global/hq/vd/tvs/oled-tv/highlights/vision-ai/others/2025-oled-tv-f06-1-samsung-vision-ai-4k-ai-upscaling-pro-pc.jpg" data-poster-mo="https://stg-images.samsung.com/is/image/samsung/assets/global/hq/vd/tvs/oled-tv/highlights/vision-ai/others/2025-oled-tv-f06-1-samsung-vision-ai-4k-ai-upscaling-pro-mo.jpg" playsinline muted preload="" autoplay="true" loop="true" disableremoteplayback="" tabindex="0">
										<source src="https://stg-images.samsung.com/is/content/samsung/assets/global/hq/vd/tvs/oled-tv/highlights/vision-ai/others/2025-oled-tv-f06-1-samsung-vision-ai-4k-ai-upscaling-pro-pc.mp4" data-src-pc="https://stg-images.samsung.com/is/content/samsung/assets/global/hq/vd/tvs/oled-tv/highlights/vision-ai/others/2025-oled-tv-f06-1-samsung-vision-ai-4k-ai-upscaling-pro-pc.mp4" data-src-mo="https://stg-images.samsung.com/is/content/samsung/assets/global/hq/vd/tvs/oled-tv/highlights/vision-ai/others/2025-oled-tv-f06-1-samsung-vision-ai-4k-ai-upscaling-pro-mo.mp4" type="video/mp4">
									</video>
									<p class="blind">
										Image of a little girl kissing a puppy. The Samsung NQ4 AI Gen3 Processor appears on the photo and enhances several details, including the girl’s hair and clothes and the puppy’s face. The result is a much sharper image where subtle details are visible.
									</p>
									<div class="static__video__play-wrap--max-w-1260">
										<div class="static__video__play">
											<button type="button" class="static__video-button-controller video-button-controller--pause" title="4K AI Upscaling Pro Feature Video" tabindex="0" an-tr="oled-vd marketing page-play video-content_click" an-ca="content click" an-ac="feature" an-la="unlock a world of new experiences with samsung vision ai:4k ai upscaling pro:stop video">
												<span class="blind">stop</span>
											</button>
										</div>
									</div>
								</figure>
								<!-- static__video-wrap(e) -->
							</div>

						</div>
						<div class="static__tab-panel" id="staticVisionAiTabpanel02" role="tabpanel" aria-labelledby="static-vision-ai-tab-2">
							<div class="static__tab-panel__content">
								<!-- static__tab-panel__text(s) -->
								<div class="static__tab-panel__text">
									<h2 class="static__tab-panel__title">AI Mode</h2>
									<p class="static__tab-panel__desc">Sit back and let your settings adjust themselves. Our AI can recognize your content and surrounding environment, then tweak your picture and sound for the best experience.</p>
								</div>
								<!-- static__tab-panel__text(e) -->
								<!-- static__image-wrap(s) -->
								<figure class="static__image-wrap">
									<img class="static__image" src="https://stg-images.samsung.com/is/image/samsung/assets/global/hq/vd/tvs/oled-tv/highlights/vision-ai/others/2025-oled-tv-f06-2-samsung-vision-ai-ai-mode-pc.jpg" data-src-pc="https://stg-images.samsung.com/is/image/samsung/assets/global/hq/vd/tvs/oled-tv/highlights/vision-ai/others/2025-oled-tv-f06-2-samsung-vision-ai-ai-mode-pc.jpg" data-src-mo="https://stg-images.samsung.com/is/image/samsung/assets/global/hq/vd/tvs/oled-tv/highlights/vision-ai/others/2025-oled-tv-f06-2-samsung-vision-ai-ai-mode-mo.jpg" alt="Three TV screens showing how AI Mode customizes the picture and audio settings for different types of content.">
								</figure>
								<!-- static__image-wrap(e) -->
							</div>
						</div>
						<div class="static__tab-panel" id="staticVisionAiTabpanel03" role="tabpanel" aria-labelledby="static-vision-ai-tab-3">
							<div class="static__tab-panel__content">
								<!-- static__tab-panel__text(s) -->
								<div class="static__tab-panel__text">
									<h2 class="static__tab-panel__title">Adaptive Sound Pro</h2>
									<p class="static__tab-panel__desc">Experience clear voices and vivid yet balanced sound, just as the creators intended. Our AI optimizes audio based on what you're watching and the viewing environment, then fine-tunes it with remastering technology.</p>
								</div>
								<!-- static__tab-panel__text(e) -->
								<!-- static__image-wrap(s) -->
								<figure class="static__image-wrap">
									<img class="static__image" src="https://stg-images.samsung.com/is/image/samsung/assets/global/hq/vd/tvs/oled-tv/highlights/vision-ai/others/2025-oled-tv-f06-3-samsung-vision-ai-adaptive-sound-pro-pc.jpg" data-src-pc="https://stg-images.samsung.com/is/image/samsung/assets/global/hq/vd/tvs/oled-tv/highlights/vision-ai/others/2025-oled-tv-f06-3-samsung-vision-ai-adaptive-sound-pro-pc.jpg" data-src-mo="https://stg-images.samsung.com/is/image/samsung/assets/global/hq/vd/tvs/oled-tv/highlights/vision-ai/others/2025-oled-tv-f06-3-samsung-vision-ai-adaptive-sound-pro-mo.jpg" alt="Three TVs play audio differently, indicated by audio bars above the TVs, optimized for the type of content being played.">
								</figure>
								<!-- static__image-wrap(e) -->
							</div>

						</div>
						<div class="static__tab-panel" id="staticVisionAiTabpanel04" role="tabpanel" aria-labelledby="static-vision-ai-tab-4">
							<div class="static__tab-panel__content">

								<!-- static__tab-panel__text(s) -->
								<div class="static__tab-panel__text">
									<h2 class="static__tab-panel__title">Bixby</h2>
									<p class="static__tab-panel__desc">
										Get better help from a smarter voice assistant. With updated AI, Bixby can process multiple commands at once, and it's better at grasping the wider context.
										Enjoy smoother conversations, easier searches and seamless device control.<sup><a href="#staticDescription04" class="static__disc-txt" title="see disclaimer">4</a></sup>
									</p>
								</div>
								<!-- static__tab-panel__text(e) -->
								<!-- static__image-wrap(s) -->
								<figure class="static__image-wrap">
									<img class="static__image" src="https://stg-images.samsung.com/is/image/samsung/assets/global/hq/vd/tvs/oled-tv/highlights/vision-ai/others/2025-oled-tv-f06-4-samsung-vision-ai-bixby-pc.jpg" data-src-pc="https://stg-images.samsung.com/is/image/samsung/assets/global/hq/vd/tvs/oled-tv/highlights/vision-ai/others/2025-oled-tv-f06-4-samsung-vision-ai-bixby-pc.jpg" data-src-mo="https://stg-images.samsung.com/is/image/samsung/assets/global/hq/vd/tvs/oled-tv/highlights/vision-ai/others/2025-oled-tv-f06-4-samsung-vision-ai-bixby-mo.jpg" alt="Woman in living room speaks to Bixby through the TV. Captions of the dialogue are shown. What’s the weather in Paris today? The weather in Paris today is clear. Is there a famous place there? Paris is famous for the Eiffel Tower, the Seine River and more.">
								</figure>
								<!-- static__image-wrap(e) -->
							</div>

						</div>
						<div class="static__tab-panel" id="staticVisionAiTabpanel05" role="tabpanel" aria-labelledby="static-vision-ai-tab-5">
							<div class="static__tab-panel__content">
								<!-- static__tab-panel__text(s) -->
								<div class="static__tab-panel__text">
									<h2 class="static__tab-panel__title">Pet Care</h2>
									<p class="static__tab-panel__desc">
										Monitor your pets even when you're away. Your TV's on-device AI can detect sounds like barking and notifies you when your pet needs attention.
										You can also set custom rules to turn on your pet's favorite content at any time.<sup><a href="#staticDescription05" class="static__disc-txt" title="see disclaimer">5</a></sup>
									</p>
								</div>
								<!-- static__tab-panel__text(e) -->
								<!-- static__image-wrap(s) -->
								<figure class="static__image-wrap">
									<img class="static__image" src="https://stg-images.samsung.com/is/image/samsung/assets/global/hq/vd/tvs/oled-tv/highlights/vision-ai/others/2025-oled-tv-f06-5-samsung-vision-ai-pet-care-pc.jpg" data-src-pc="https://stg-images.samsung.com/is/image/samsung/assets/global/hq/vd/tvs/oled-tv/highlights/vision-ai/others/2025-oled-tv-f06-5-samsung-vision-ai-pet-care-pc.jpg" data-src-mo="https://stg-images.samsung.com/is/image/samsung/assets/global/hq/vd/tvs/oled-tv/highlights/vision-ai/others/2025-oled-tv-f06-5-samsung-vision-ai-pet-care-mo.jpg" alt="A TV's connected mic detects a dog's presence. The dog looks happy as the TV plays a peaceful scene along with music.">
								</figure>
								<!-- static__image-wrap(e) -->
							</div>
						</div>
						<div class="static__tab-panel" id="staticVisionAiTabpanel06" role="tabpanel" aria-labelledby="static-vision-ai-tab-6">
							<div class="static__tab-panel__content">
								<!-- static__tab-panel__text(s) -->
								<div class="static__tab-panel__text">
									<h2 class="static__tab-panel__title">Universal Gestures</h2>
									<p class="static__tab-panel__desc">
										Control your TV with simple motions from your Galaxy Watch. Whether you're working out, cooking or multitasking, easily operate your TV with intuitive gestures — no need to touch a remote.<sup><a href="#staticDescription06" class="static__disc-txt" title="see disclaimer">6</a></sup>
									</p>
								</div>
								<!-- static__tab-panel__text(e) -->
								<!-- static__image-wrap(s) -->
								<figure class="static__image-wrap">
									<img class="static__image" src="https://stg-images.samsung.com/is/image/samsung/assets/global/hq/vd/tvs/oled-tv/highlights/vision-ai/others/2025-oled-tv-f06-6-samsung-vision-ai-universal-gestures-pc.jpg" data-src-pc="https://stg-images.samsung.com/is/image/samsung/assets/global/hq/vd/tvs/oled-tv/highlights/vision-ai/others/2025-oled-tv-f06-6-samsung-vision-ai-universal-gestures-pc.jpg" data-src-mo="https://stg-images.samsung.com/is/image/samsung/assets/global/hq/vd/tvs/oled-tv/highlights/vision-ai/others/2025-oled-tv-f06-6-samsung-vision-ai-universal-gestures-mo.jpg" alt="Man wearing a Galaxy Watch watches TV in a living room. He moves his hand back and forth to play the video on the screen.">
								</figure>
								<!-- static__image-wrap(e) -->
							</div>
						</div>
						<div class="static__tab-panel" id="staticVisionAiTabpanel07" role="tabpanel" aria-labelledby="static-vision-ai-tab-7">
							<div class="static__tab-panel__content">
								<!-- static__tab-panel__text(s) -->
								<div class="static__tab-panel__text">
									<h2 class="static__tab-panel__title">Samsung Knox Security</h2>
									<p class="static__tab-panel__desc">
										Your privacy is safe on Samsung TVs with constant security updates. Sensitive data like passwords are protected, connected IoT devices are monitored and malicious apps and sites are automatically blocked.<sup><a href="#staticDescription07" class="static__disc-txt" title="see disclaimer">7</a></sup>
									</p>
								</div>
								<!-- static__tab-panel__text(e) -->
								<!-- static__image-wrap(s) -->
								<figure class="static__image-wrap">
									<img class="static__image" src="https://stg-images.samsung.com/is/image/samsung/assets/global/hq/vd/tvs/oled-tv/highlights/vision-ai/others/2025-oled-tv-f06-7-samsung-vision-ai-samsung-knox-security-pc.jpg" data-src-pc="https://stg-images.samsung.com/is/image/samsung/assets/global/hq/vd/tvs/oled-tv/highlights/vision-ai/others/2025-oled-tv-f06-7-samsung-vision-ai-samsung-knox-security-pc.jpg" data-src-mo="https://stg-images.samsung.com/is/image/samsung/assets/global/hq/vd/tvs/oled-tv/highlights/vision-ai/others/2025-oled-tv-f06-7-samsung-vision-ai-samsung-knox-security-mo.jpg" alt="Samsung Knox security logo on a TV screen. Secured by Knox logo.">
								</figure>
								<!-- static__image-wrap(e) -->
