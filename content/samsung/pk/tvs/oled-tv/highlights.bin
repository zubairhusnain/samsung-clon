		height: 0;
		border-radius: 6px;
		background-color: #000;
		box-shadow: 0 4px 10px 0 rgba(0, 0, 0, 0.2);
		visibility: hidden;
	}

	.rtl .mkt-navigation-menu-list {
		left: auto;
		right: 0;
	}

	.open .mkt-navigation-menu-list {
		height: auto;
		visibility: visible;
	}
}

@media screen and (max-width: 767px) {
	.mkt-navigation-menu-list-item:first-child {
		margin-top: 8px;
	}

	.mkt-navigation-menu-list-item:last-child {
		margin-bottom: 8px;
	}
}

.mkt-navigation-menu-list-item a {
	display: flex;
	overflow: hidden;
	height: 56px;
	align-items: center;
	padding: 0 10px;
	color: #fff;
	font-size: 15px;
	line-height: 1.33;
}

@media screen and (min-width: 768px) {
	.mkt-navigation-menu-list-item a {
		font-weight: 700;
	}
}

@media screen and (max-width: 767px) {
	.mkt-navigation-menu-list-item a {
		height: 40px;
		padding: 0 19px;
		font-size: 14px;
		line-height: 1.33;
	}

	html[lang^=my] .mkt-navigation-menu-list-item a {
		line-height: 1.4;
	}
}

@media screen and (min-width: 768px) {
	.mkt-navigation-menu-list-item.current {
		display: none;
	}
}

@media screen and (max-width: 767px) {
	.mkt-navigation-menu-list-item.current a {
		font-weight: 700;
		text-decoration: underline;
	}
}

@media screen and (max-width: 767px) {

	.mkt-navigation-menu-list-item:hover a,
	.mkt-navigation-menu-list-item:focus a {
		background-color: #000;
	}
}

.mkt-navigation-utility {
	flex-shrink: 0;
}

.mkt-navigation-button {
	display: inline-flex;
	overflow: hidden;
	height: 40px;
	align-items: center;
	justify-content: center;
	padding: 11px 24px 10px;
	border-radius: 20px;
	background: #2189ff;
	color: #fff;
	font-size: 16px;
	font-weight: bold;
	text-align: center;
}

@media screen and (max-width: 767px) {
	.mkt-navigation-button {
		height: 32px;
		padding: 8px 16px;
		font-size: 12px;
	}
}

.mkt-navigation-button span {
	line-height: 1.32;
	text-shadow: 0 0 3px rgba(0, 0, 0, 0.75);
	vertical-align: middle;
	white-space: nowrap;
}

@media screen and (max-width: 767px) {
	.mkt-navigation-button span {
		line-height: 1.33;
	}

	html[lang^=my] .mkt-navigation-button span {
		line-height: 1.4;
	}
}
		</style>
	
	
