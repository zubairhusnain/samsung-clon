						<!-- static--glare-free__before-after-slider-wrap(e) -->
						<!-- static--glare-free__before-after-tap-wrap(s) -->
						<div class="static--glare-free__before-after-tap-wrap">
							<div class="static--glare-free__before-after-tap static--glare-free__before-after-tap-left">
								<button type="button" class="static--glare-free__before-after-tap-button">
									<span class="blind">Move to the left of the split screen border</span>
