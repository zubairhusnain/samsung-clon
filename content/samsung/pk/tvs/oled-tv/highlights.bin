		<script>
			;(function(win,doc,callback){'use strict';callback=callback||function(){};function detach(){if(doc.addEventListener){doc.removeEventListener('DOMContentLoaded',completed);}else{doc.detachEvent('onreadystatechange',completed);}}function completed(){if(doc.addEventListener||event.type==='load'||doc.readyState==='complete'){detach();callback(window,window.jQuery);}}function init(){if (doc.addEventListener){doc.addEventListener('DOMContentLoaded',completed);}else{doc.attachEvent('onreadystatechange',completed);}}init();})(window,document,function(win,$){
				/* RC01_Static Content > Footer(Javascript) : static--glare-free(s) */
window.setStaticGlareFree = () => {
	$.fn.BeerSlider = function (options) {
		options = options || {};
		return this.each(function () {
			new BeerSlider(this, options);
		});
	};

	const $staticGlareFreeBeforeAfterSlider = $('.static--glare-free__before-after-slider-wrap').find(".beer-slider");
	const setStartValue = 0;

	$staticGlareFreeBeforeAfterSlider.BeerSlider({ start: setStartValue });

	$staticGlareFreeBeforeAfterSlider.each(function () {
		const $beerHandle = $(this).find('.beer-handle');
		const $beerReveal = $(this).find('.beer-reveal');
		const $beerRange = $(this).find('input.beer-range');
		const $beforeAfterTap = $('.static--glare-free__before-after-tap');
		const $beforeAfterTapButton = $beforeAfterTap.children('.static--glare-free__before-after-tap-button');
		const $beforeAfterTapLeft = $('.static--glare-free__before-after-tap-left');
		const $beforeAfterTapLeftButton = $beforeAfterTapLeft.children('.static--glare-free__before-after-tap-button');
		const $beforeAfterTapRight = $('.static--glare-free__before-after-tap-right');
		const $beforeAfterTapRightButton = $beforeAfterTapRight.children('.static--glare-free__before-after-tap-button');
		const animationState = { value: setStartValue };

		const updateStaticGlareFree = (event) => {
			const currentWidth = $(window).width();
	
			$staticGlareFreeBeforeAfterSlider.find('.static__image').each(function () {
				const $this = $(this);
				const newSrc = window.isMobile ? $this.data('src-mo') : $this.data('src-pc');
				$this.attr('src', newSrc);
			});
		};

		$beerHandle.append('<span class="beer-handle__circle"></span><span class="beer-handle__bar"></span>');
		$beerRange.attr('tabindex', '-1');
		$beerRange.attr('aria-value-init-ani', '');

		// setTimeout(() => {
			animationState.value = 50; // 초기값 설정
			$beerRange.attr('aria-value-init-ani', animationState.value);

			// 50 → 0 애니메이션
			gsap.to(animationState, {
				value: 0,
				duration: 1.2,
				ease: "power2.inOut",
				onUpdate: function () {
					const currentValue = Math.round(animationState.value);
					$beerRange.attr('aria-value-init-ani', currentValue);
					$beerReveal.css('width', `${currentValue}%`);
					$beerHandle.css('left', `${currentValue}%`);
				},
				onComplete: function () {
					// 0 → 100 애니메이션
					gsap.to(animationState, {
						value: 100,
						duration: 1.2,
						ease: "power2.inOut",
						onUpdate: function () {
							const currentValue = Math.round(animationState.value);
							$beerRange.attr('aria-value-init-ani', currentValue);
							$beerReveal.css('width', `${currentValue}%`);
							$beerHandle.css('left', `${currentValue}%`);
						},
						onComplete: function () {
							// 100 → 50 애니메이션
							gsap.to(animationState, {
								value: 50,
								duration: 1.2,
								ease: "power2.inOut",
								onUpdate: function () {
									const currentValue = Math.round(animationState.value);
									$beerRange.attr('aria-value-init-ani', currentValue);
									$beerReveal.css('width', `${currentValue}%`);
									$beerHandle.css('left', `${currentValue}%`);
								},
								onComplete: function () {
									$beforeAfterTap.css('width', '50%');
								}
							});
						}
					});
				}
			});
		// }, 1000);

		$beerRange.on('input change', function () {
			const getBeerRangeValuenow = parseFloat($beerRange.attr('aria-valuenow'));

			if (!isNaN(getBeerRangeValuenow)) {
				$beforeAfterTapLeft.css('width', `${getBeerRangeValuenow}%`);
			}
		});

		$(document).on('click touchend', (event) => {
			const $target = $(event.target);

			if (!$target.closest($staticGlareFreeBeforeAfterSlider).length) {
				$beforeAfterTapButton.blur();
				return;
			}

			const clickX = event.type === 'touchend'
				? event.originalEvent.changedTouches[0].clientX
				: event.clientX;

			const handleX = $beerHandle.offset().left + ($beerHandle.width() / 2);
			const handleWidth = $beerHandle.width() / 2;

			const leftBoundary = handleX - handleWidth;
			const rightBoundary = handleX + handleWidth;

			if (clickX < leftBoundary) {
				$beforeAfterTapLeftButton.focus();
			} else if (clickX > rightBoundary) {
				$beforeAfterTapRightButton.focus();
			} else {
				$beforeAfterTapButton.blur();
			}
		});

		if ($staticGlareFreeBeforeAfterSlider.length > 0) {
			updateStaticGlareFree();
	
			$(window.mediaQueryForResponsive).on("change", function (event) {
				updateStaticGlareFree();
			});
		};
		
	});
	
};
/* RC01_Static Content > Footer(Javascript) : static--glare-free(e) */
			});
		</script>
	
</div>
