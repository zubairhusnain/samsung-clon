		<script>
			;(function(win,doc,callback){'use strict';callback=callback||function(){};function detach(){if(doc.addEventListener){doc.removeEventListener('DOMContentLoaded',completed);}else{doc.detachEvent('onreadystatechange',completed);}}function completed(){if(doc.addEventListener||event.type==='load'||doc.readyState==='complete'){detach();callback(window,window.jQuery);}}function init(){if (doc.addEventListener){doc.addEventListener('DOMContentLoaded',completed);}else{doc.attachEvent('onreadystatechange',completed);}}init();})(window,document,function(win,$){
				window.addEventListener('DOMContentLoaded', () => {
	const navWrap = document.querySelector('.mkt-navigation');
	const menu = navWrap.querySelector('.mkt-navigation-menu');
	const menuBtn = navWrap.querySelector('.mkt-navigation-menu-button');
	const menuListCon = menu.querySelector('.mkt-navigation-menu-list');
	const pcTitleBtn = navWrap.querySelector('.mkt-navigation-headline-text');
	const state = {
		fixedFlag: false,
		isShow: false,
		isInit: false,
		isMobile: false,
	};
	const setMobileFocusLoop = (el, option = {}) => {
		const {
			ignoreTag = ['SCRIPT', 'STYLE']
		} = option;
		if (el && el.parentElement) {
			do {
				const siblings = el.parentElement.childNodes;
				for (let i = 0; i < siblings.length; i++) {
					const item = siblings[i];
					if (item.nodeType === 1 && item !== el && ignoreTag.findIndex((tag) => tag === item.tagName) === -1) {
						item.setAttribute('data-aria-hidden', item.getAttribute('aria-hidden') || 'null');
						item.setAttribute('aria-hidden', 'true');
					}
				}
				el = el.parentElement;
			} while (el !== document.body);
		}
	};
	const removeMobileFocusLoop = () => {
		const els = document.querySelectorAll('[data-aria-hidden]');
		for (let i = 0; i < els.length; i++) {
			const item = els[i];
			const originAriaHidden = item.getAttribute('data-aria-hidden');
			if (!originAriaHidden || originAriaHidden === 'null') {
				item.removeAttribute('aria-hidden');
			} else {
				item.setAttribute('aria-hidden', originAriaHidden);
			}
			item.removeAttribute('data-aria-hidden');
		}
	};
	const onScroll = () => {
		if (navWrap) {
			const flag = navWrap.getBoundingClientRect().y <= 0;
			if (state.fixedFlag !== flag) {
				state.fixedFlag = flag;
				if (flag) navWrap.classList.add('is-fixed');
				else navWrap.classList.remove('is-fixed');
			}
		}
	};
	const onCurrentClick = (e) => {
		e.preventDefault();
		showMenu(false);
		menuBtn.focus();
		onScrollTop(e);
	};
	const onResize = () => {
		const isMobile = window.innerWidth < 768;
		if (!state.isInit || state.isMobile !== isMobile) {
			showMenu(false);
			state.isMobile = isMobile;
			const menuList = menuListCon.querySelectorAll('.mkt-navigation-menu-list-item');
			menuListCon.setAttribute('role', isMobile ? 'listbox' : 'list');
			menuList.forEach((item) => item.setAttribute('role', isMobile ? 'presentation' : 'listitem'));
			menu.querySelectorAll('.mkt-navigation-menu-list-item').forEach((item) => {
				const btn = item.querySelector('a');
				if (btn) {
					if (item.classList.contains('current')) {
						if (isMobile) {
							btn.setAttribute('aria-selected', 'true');
							btn.addEventListener('click', onCurrentClick);
						} else {
							btn.removeEventListener('click', onCurrentClick);
						}
					} else {
						if (isMobile) btn.setAttribute('aria-selected', 'false');
					}
					if (isMobile) {
						btn.setAttribute('role', 'option');
					} else {
						btn.removeAttribute('role');
						btn.removeAttribute('aria-selected');
					}
				}
			});
		}
	};
	const onScrollTop = (e) => {
		e.preventDefault();
		window.scrollTo({
			top: 0,
			behavior: 'smooth',
		});
	};

	const showMenu = (flag) => {
		state.isShow = flag;
		menuListCon.setAttribute('aria-hidden', !flag ? 'true' : 'false');
		if (flag) {
			menu.classList.add('open');
			// setMobileFocusLoop(navWrap);
		} else {
			menu.classList.remove('open');
			// removeMobileFocusLoop();
		}
	};
	const toggleMenu = (e) => {
		e.preventDefault();
		showMenu(!state.isShow);
	};
	const init = () => {
		window.addEventListener('scroll', onScroll);
		window.addEventListener('resize', onResize);
		window.addEventListener('orientationchange', onResize);
		menuBtn.addEventListener('click', toggleMenu);
		pcTitleBtn.addEventListener('click', onScrollTop);
		onResize();
		onScroll();
		state.isInit = true;
	};
	init();
});
			});
		</script>
	
