$(document).ready(function () {
	//Code for a tag smooth click
	$('a[href^="#"]').on('click',function (e) {
		e.preventDefault();
		var target = this.hash;
		var $target = $(target);
		$('html, body').stop().animate({
			'scrollTop': $target.offset().top - 90
		}, 1000);
	});
	
	//Code for menu close in mobile device
	$( ".topnav a" ).on("click", function(){
		$(".topnav").removeClass("responsive");
	});
	
	//Code for sticky bar
	$(window).scroll(function () {
		if($(window).scrollTop() > 80) {
			$("#myNav").addClass('sticky');
		} else {
			$("#myNav").removeClass('sticky');
		}
	});
	
	//Code for slick slider
	$(".course_details").slick({
		dots: false,
		arrows: false,
		infinite: true,
		adaptiveHeight: true,
		autoplay: false,
		slidesToShow: 4,
		slidesToScroll: 4,
		responsive: [
		{
			breakpoint: 1025,
			settings: {
				slidesToShow: 4,
				slidesToScroll: 4,
				arrows: false
			}
		},
		{
			breakpoint: 990,
			settings: {
				slidesToShow: 4,
				slidesToScroll: 4,
				arrows: true
			}
		},
		{
			breakpoint: 768,
			settings: {
				slidesToShow: 2,
				slidesToScroll: 2,
				arrows: true
			}
		},
		{
			breakpoint: 480,
			settings: {
				slidesToShow: 1,
				slidesToScroll: 1,
				arrows: true
			}
		}]
	});
});
			});
		</script>
	
</div>
<div class="static-content aem-GridColumn aem-GridColumn--default--12">
	
	
