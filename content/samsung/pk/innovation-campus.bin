<script>
/*Menu function start*/
function clickmenu() {
	var x = document.getElementById("myTopnav");
	if (x.className === "topnav") {
		x.className += " responsive";
	} else {
		x.className = "topnav";
	}
}
/*Menu function end*/
</script>

<script>
/*Counter function start*/
var countDownDate = new Date("Aug 31, 2024 23:59:00").getTime();

var x = setInterval(function() {
	var now = new Date().getTime();
	var distance = countDownDate - now;
    
	var days = Math.floor(distance / (1000 * 60 * 60 * 24));
	var hours = Math.floor((distance % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
	var minutes = Math.floor((distance % (1000 * 60 * 60)) / (1000 * 60));
	var seconds = Math.floor((distance % (1000 * 60)) / 1000);
    
	document.getElementById("days").innerHTML = days;
	document.getElementById("hours").innerHTML = hours;
	document.getElementById("seconds").innerHTML = seconds;
}, 1000);
/*Counter function end*/
</script>

<script>
$(document).ready(function () {
	//Code for a tag smooth click
	$('a[href^="#"]').on('click',function (e) {
		e.preventDefault();
		var target = this.hash;
		var $target = $(target);
		$('html, body').stop().animate({
			'scrollTop': $target.offset().top - 90
		}, 1000);
	});
	
	//Code for menu close in mobile device
	$( ".topnav a" ).on("click", function(){
		$(".topnav").removeClass("responsive");
	});
	
	//Code for sticky bar
	$(window).scroll(function () {
		if($(window).scrollTop() > 80) {
			$("#myNav").addClass('sticky');
		} else {
			$("#myNav").removeClass('sticky');
		}
	});
	
	//Code for slick slider
	$(".course_details").slick({
		dots: false,
		arrows: true,
		infinite: true,
		adaptiveHeight: true,
		autoplay: false,
		slidesToShow: 4,
		slidesToScroll: 1,
		responsive: [
		{
			breakpoint: 1025,
			settings: {
				slidesToShow: 4,
				slidesToScroll: 1
			}
		},
		{
			breakpoint: 990,
			settings: {
				slidesToShow: 4,
				slidesToScroll: 1
			}
		},
		{
			breakpoint: 768,
			settings: {
				slidesToShow: 2,
				slidesToScroll: 1
			}
		},
		{
			breakpoint: 480,
			settings: {
				slidesToShow: 1,
				slidesToScroll: 1
			}
		}]
	});
});
</script>
	
