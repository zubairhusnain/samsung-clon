				<div class="trans_btn">
					<a href="//images.samsung.com/is/content/samsung/assets/pk/innovation_campus/images/2024_assets/3-Samsung-Innovation-Campus_Artificial-Intelligence-Course-Details.pdf" data-omni-type="microsite_course" data-omni="pk:innovation campus:check course details" target="_blank">Check course details</a>
				</div>
