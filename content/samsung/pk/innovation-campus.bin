<style>
/* Slider */
.slick-slider { position: relative; display: block; box-sizing: border-box; -webkit-user-select: none; -moz-user-select: none; -ms-user-select: none; user-select: none; -webkit-touch-callout: none; -khtml-user-select: none; -ms-touch-action: pan-y; touch-action: pan-y; -webkit-tap-highlight-color: transparent; }
.slick-list { position: relative; display: block; margin: 0; padding: 0; }
.slick-list:focus { outline: none; }
.slick-list.dragging { cursor: pointer; cursor: hand; }
.slick-slider .slick-track, .slick-slider .slick-list { -webkit-transform: translate3d(0, 0, 0); -moz-transform: translate3d(0, 0, 0); -ms-transform: translate3d(0, 0, 0); -o-transform: translate3d(0, 0, 0); transform: translate3d(0, 0, 0); }
.slick-track { position: relative; top: 0; left: 0; display: block; margin-left: auto; margin-right: auto; }
.slick-track:before, .slick-track:after { display: table; content: ''; }
.slick-track:after { clear: both; }
.slick-loading .slick-track { visibility: hidden; }
.slick-slide { display: none; float: left; min-height: 1px; }
[dir='rtl'] .slick-slide { float: right; }
.slick-slide img {}
.slick-slide.slick-loading img { display: none; }
.slick-slide.dragging img { pointer-events: none; }
.slick-initialized .slick-slide { display: block; }
.slick-loading .slick-slide { visibility: hidden; }
.slick-vertical .slick-slide { display: block; height: auto; border: 1px solid transparent; }
.slick-arrow.slick-hidden { display: none; }
</style>
<style>
@charset 'UTF-8';
/* Slider */
.slick-loading .slick-list { background: #fff url('//images.samsung.com/is/image/samsung/assets/ae/2024_assets/innovation_campus/images/ajax-loader.gif?$ORIGIN_GIF$]') center center no-repeat; }

/* Arrows */
.slick-prev, .slick-next { font-size: 0; line-height: 0; position: absolute; top: 50%; display: block; width: 30px; height: 30px; padding: 0; -webkit-transform: translate(0, -50%); -ms-transform: translate(0, -50%); transform: translate(0, -50%); cursor: pointer; color: transparent; border: none; outline: none; background: transparent; z-index: 99; }
.slick-prev:hover, .slick-prev:focus, .slick-next:hover, .slick-next:focus { color: transparent; outline: none; background: transparent; }
.slick-prev:hover:before, .slick-prev:focus:before, .slick-next:hover:before, .slick-next:focus:before { opacity: 1; }
.slick-prev.slick-disabled:before, .slick-next.slick-disabled:before { opacity: .25; }
.slick-prev:before, .slick-next:before { font-size: 20px; line-height: 1; opacity: 1; color: white; -webkit-font-smoothing: antialiased; -moz-osx-font-smoothing: grayscale; }
.slick-prev { left: 0; }
[dir='rtl'] .slick-prev { right: -25px; left: auto; }
.slick-prev:before { content: url('//images.samsung.com/is/image/samsung/assets/ae/2024_assets/innovation_campus/images/prev_new.png?$ORIGIN_PNG$'); }
[dir='rtl'] .slick-prev:before { content: url('//images.samsung.com/is/image/samsung/assets/ae/2024_assets/innovation_campus/images/next_new.png?$ORIGIN_PNG$'); }
.slick-next { right: 0; }
[dir='rtl'] .slick-next { right: auto; left: -25px; }
.slick-next:before { content: url('//images.samsung.com/is/image/samsung/assets/ae/2024_assets/innovation_campus/images/next_new.png?$ORIGIN_PNG$'); }
[dir='rtl'] .slick-next:before { content: url('//images.samsung.com/is/image/samsung/assets/ae/2024_assets/innovation_campus/images/prev_new.png?$ORIGIN_PNG$'); }

/* Dots */
.slick-dotted.slick-slider { margin-bottom: 30px; }
.slick-dots { position: absolute; bottom: -25px; display: block; width: 100%; padding: 0; margin: 0; list-style: none; text-align: center; }
.slick-dots li { position: relative; display: inline-block; width: 20px; height: 20px; margin: 0 5px; padding: 0; cursor: pointer; }
.slick-dots li button { font-size: 0; line-height: 0; display: block; width: 20px; height: 20px; padding: 5px; cursor: pointer; color: transparent; border: 0; outline: none; background: transparent; }
.slick-dots li button:hover, .slick-dots li button:focus { outline: none; }
.slick-dots li button:hover:before, .slick-dots li button:focus:before { opacity: 1; }
.slick-dots li button:before { font-size: 6px; line-height: 20px; position: absolute; top: 0; left: 0; width: 20px; height: 20px; content: '•'; text-align: center; opacity: .25; color: black; -webkit-font-smoothing: antialiased; -moz-osx-font-smoothing: grayscale; }
.slick-dots li.slick-active button:before { opacity: .75; color: black; }
</style>
<style>
body { margin: 0; }
* { box-sizing: border-box; }
.main_container { width: 100%; height: auto; margin: 0; padding: 0; color: #000000; }
.work_container { width: 100%; max-width: 1440px; margin: 0 auto; padding: 0; }
.clear { clear: both; }
.desktop_element { display: block; }
.mobile_element { display: none; }

.section1 { width: 100%; margin: 0; padding: 0; }
.section2 { width: 100%; margin: 0; padding: 80px 0 60px; text-align: center; }
.section3 { width: 100%; margin: 0; padding: 50px 0; text-align: center; }
.section4 { width: 100%; margin: 0; padding: 80px 0 60px; text-align: center; }
.section5 { width: 100%; margin: 0; padding: 60px 0 0; text-align: center; }
.section6 { width: 100%; margin: 0; padding: 50px 0; text-align: center; }
.section7 { width: 100%; margin: 0; padding: 0 0 30px; text-align: center; }
.section8 { width: 100%; margin: 0; padding: 0; text-align: center; }

.blue_bg { background: #eefaff; }
.pattern_bg { width: 100%; margin: 0 auto; padding: 0; background: url(//images.samsung.com/is/image/samsung/assets/ae/2024_assets/innovation_campus/images/bg_img.jpg?$ORIGIN_JPG$) no-repeat right top; }

.top_kv_nav { width: 100%; margin: 0; padding: 0; position: relative; }
.top_nav { width: 100%; margin: 0; padding: 15px 0; position: absolute; z-index: 20; left: 0; top: 0; border-bottom: 1px solid rgba(255,255,255,.2); }
.top_nav.sticky { position: fixed; width: 100%; max-width: 1440px; margin: 0 auto; left: 50%; margin-left: -720px; background: #28417a; z-index: 999; }
.menu_icon { display: none; }
.topnav { width: 70%; margin: 0; padding: 0 0 0 50px; float: left; }
.topnav a { font-family: 'SamsungOne',arial,sans-serif; color: #ffffff; font-size: 14px; text-decoration: none; font-weight: 700; display: inline-block; padding: 15px 30px; }
.topnav a:hover, .topnav a:focus {}
.white_cta { width: 23%; margin: 0; padding: 0 50px 0 0; float: right; text-align: right; }
.white_cta a { display: inline-block; font-family: 'SamsungOne',arial,sans-serif; font-size: 14px; font-weight: 700; color: #13289f; text-decoration: none; background: #ffffff; border: 1px solid #ffffff; border-radius: 30px; padding: 15px 30px; }
.white_cta a:hover, .white_cta a:focus { background: #dddddd; color: #313131; border-color: #dddddd; }
.top_kv { width: 100%; margin: 0; padding: 0; position: relative; }
.top_kv_img { width: 100%; margin: 0; padding: 0; }
.top_kv_img img { max-width: 100%; max-height: 100%; position: relative; z-index: 10; }
.top_kv_copy { width: 50%; margin: 0; padding: 0; position: absolute; z-index: 20; left: 50px; top: 50%; margin-top: -150px; }
.kv_title { width: 100%; margin: 0; padding: 0 0 50px; font-family: "SamsungSharpSans"; font-size: 80px; line-height: 80px; font-weight: 800; color: #ffffff; }
.kv_sub_title { width: 100%; margin: 0; padding: 0; font-family: "SamsungSharpSans"; font-size: 40px; font-weight: 600; color: #ffffff; }
.main_title { width: 100%; margin: 0; padding: 0 0 30px; font-family: "SamsungSharpSans"; font-size: 56px; }
.sub_title { width: 100%; margin: 0; padding: 0 0 70px; font-family: "SamsungSharpSans"; font-size: 40px; }
.common_text { width: 100%; margin: 0; padding: 0 0 30px; font-size: 18px; font-weight: 400; line-height: 1.33; }
.auto_counter { width: 100%; margin: 0; padding: 30px 0 100px; position: relative; top: 0; }
.counter_title { width: 100%; margin: 0; padding: 30px 0 0; font-family: "SamsungSharpSans"; font-size: 30px; font-weight: 600; }
.counter_box { width: 55%; margin: 0 auto; padding: 0; position: relative; }
.counter_box .digits { width: 27%; float: left; border-radius: 50%; padding: 50px; margin: 0 25px; text-align: center; font-family: "SamsungSharpSans"; font-size: 80px; background: #ffffff; position: relative; }
.counter_box .digits.days { border: 1px solid #006BEA; color: #006BEA; }
.counter_box .digits.days::after { content: "Days"; position: absolute; bottom: -40px; left: 0; font-size: 20px; text-transform: uppercase; color: #006BEA; width: 100%; }
.counter_box .digits.hours { border: 1px solid #006BEA; color: #006BEA; }
.counter_box .digits.hours::after { content: "Hours"; position: absolute; bottom: -40px; left: 0; font-size: 20px; text-transform: uppercase; color: #006BEA; width: 100%; }
.counter_box .digits.seconds { border: 1px solid #006BEA; color: #006BEA; }
.counter_box .digits.seconds::after { content: "Seconds"; position: absolute; bottom: -40px; left: 0; font-size: 20px; text-transform: uppercase; color: #006BEA; width: 100%; }
.session_details { width: 80%; margin: 0 auto 50px; padding: 0; border-top: 1px solid #006BEA; border-bottom: 1px solid #006BEA; }
.session_details ul { margin: 0; padding: 0; list-style: none; overflow: hidden; }
.session_details ul li { width: 33.33%; float: left; padding: 20px; }
.session_details ul li:last-child { border-right: 0 none; }
.session_details ul li .session_title { width: 100%; margin: 0; padding: 0 0 10px; font-size: 20px; font-weight: 800; }
.session_details ul li .session_desc { width: 100%; margin: 0; padding: 0; font-size: 14px; font-weight: 400; line-height: 1.33; }
.session_details ul li .session_desc span { font-size: 14px; display: block; }
.course_details { width: 80%; margin: 0 auto; padding: 0; list-style: none; overflow: hidden; }
.course_details li { width: 25%; margin: 0; padding: 0 15px; float: left; }
.detail_box { width: 100%; margin: 0; padding: 0; }
.icon_box { width: 100%; margin: 0; padding: 0; }
.course_copy { width: 100%; margin: 0; padding: 15px 20px 0; font-size: 18px; font-weight: 400; line-height: 1.33; }
.line_style { width: 100%; margin: 0; padding: 0; position: absolute; bottom: 30px; left: 0; }
.line_style span { width: 54px; height: 2px; display: inline-block; }
.line_style span.red { background: #ef483d; }
.line_style span.blue { background: #00b3e4; }
.line_style span.yellow { background: #fbc56c; }
.line_style span.green { background: #b4ddbf; }
.section5 .detail_box {}
.trans_btn { width: 100%; margin: 0; padding: 0; }
.trans_btn a { display: inline-block; font-family: 'SamsungOne',arial,sans-serif; font-size: 14px; font-weight: 700; color: #000000; text-decoration: none; background: transparent; border: 1px solid #000000; border-radius: 30px; padding: 15px 30px; }
.trans_btn a:hover, .trans_btn a:focus { background: #dddddd; color: #313131; border-color: #dddddd; }
.partners_box { width: 60%; margin: 0 auto; padding: 15px; border: 1px solid #bbbec2; overflow: hidden; }
.partners_box .three_box { width: 50%; float: left; margin: 0; padding: 0; }
.partners_box .three_box.copy { text-align: left; font-family: "SamsungSharpSans"; font-size: 30px; border-right: 1px solid #bbbec2; padding: 50px 0 50px 30px; }
.partners_box .three_box img { max-width: 100%; max-height: 100%; }
.tnc { width: 100%; margin: 0; padding: 0; }
.tnc a { display: inline-block; text-decoration: none; color: #000000; font-size: 14px; font-weight: 400; }
.tnc a:hover, .tnc a:focus { text-decoration: underline; }

.slider {}
.slick-slide {}
.slick-slide img {}
.slick-prev:before, .slick-next:before { color: black; }
.slick-slide { transition: all ease-in-out .3s; opacity: .2; }
.slick-active { opacity: 1; }
.slick-current { opacity: 1; }

a.cta_disabled { display: inline-block; text-decoration: none; font-size: 14px; font-family: calibri; font-weight: 800; color: #000000; background: #c4c4c4; border: 1px solid #c4c4c4; border-radius: 30px; padding: 10px 20px; }
a.cta_active { display: inline-block; text-decoration: none; font-size: 14px; font-family: calibri; font-weight: 800; color: #ffffff; background: #1428a0; border: 1px solid #1428a0; border-radius: 30px; padding: 10px 20px; }
a.cta_active:hover, a.cta_active:focus { background: #000000; border: 1px solid #000000; }

.modal { display: none; position: fixed; z-index: 9999; left: 0; top: 0; width: 100%; height: 100%; overflow: auto; background-color: rgba(0,0,0,0.7); }
.modal-content { background-color: #fefefe; margin: auto; padding: 20px; border: 1px solid #888; width: 30%; position: relative; text-align: center; border-radius: 10px; top: 50%; margin-top: -160px; }
.close { color: #aaaaaa; font-size: 28px; font-weight: bold; position: absolute; right: 10px; top: 0; }
.close:hover, .close:focus { color: #000; text-decoration: none; cursor: pointer; }



