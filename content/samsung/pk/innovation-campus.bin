					<div class="white_cta">
						<!--<a href="./register/" data-omni-type="microsite_course" data-omni="pk:innovation campus:register now for innovation campus" target="_blank">Register now</a>-->
						<!--<a href="https://mena.samsung.com/qa/Samsung_Innovation_campus" data-omni-type="microsite_course" data-omni="pk:innovation campus:start your course" onclick="return alert('By clicking OK you agree to our terms and conditions on this page below. Please click Ok to continue...');" target="_blank">Apply Here</a>-->
						<!--<a href="https://innovationcampus.thinkific.com/users/sign_in" data-omni-type="microsite_course" data-omni="pk:innovation campus:start your course" onclick="return alert('By clicking OK you agree to our terms and conditions on this page below. Please click Ok to continue...');" target="_blank">Start your course</a>-->
					</div>
				</div>
				
				<div class="top_kv">
					<div class="top_kv_img">
						<img src="//images.samsung.com/is/image/samsung/assets/pk/innovation_campus/images/2024_assets/Innovation-Campus_revised-1440x810.jpg?$ORIGIN_JPG$" alt="Samsung Innovation Campus" class="desktop_element"/>
						<img src="//images.samsung.com/is/image/samsung/assets/pk/innovation_campus/images/2024_assets/Innovation-Campus_revised-720x1280-2.jpg?$ORIGIN_JPG$" alt="Samsung Innovation Campus" class="mobile_element"/>
