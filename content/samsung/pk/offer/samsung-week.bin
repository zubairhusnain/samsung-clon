<script>
$(document).ready(function () {
    var sku_tab_config = {
      "bundle-offers": 0,
      "smartphones-offers": 1,
      "tv-offers": 2,
      "washing-machine-offers": 3,
      "refrigerator-offers": 4,
      "monitors-offers": 5,
      "dishwasher-offers": 6,
      "air-conditioners-offers": 7
    }

    var initial_tabmenu = "bundle-offers"

    var $tabMenusSlider = $(".tab-menus-slider").slick({
        arrows: false,
        dots: false,
        slidesToShow: 9,
        slidesToScroll: 9,
        autoplay: false,
        infinite: false,
        useTransform: false,
        variableWidth: false,
        responsive: [
          {
            breakpoint: 767,
            settings: {
              dots: false,
              arrows: true,
              slidesToShow: 3,
              slidesToScroll: 1,
              initialSlide: sku_tab_config[initial_tabmenu],
            },
          },
        ],
    });

    onLoad(initial_tabmenu)

    const kv_selector = '.offer-header__cta-wrap a, .home-kv-carousel__cta-wrap a, .full-bleed-thumbnail-section a, .personalised-kv-recommendation a'
    const aem_tab_selector = '.showcase-card-tab__card-wrap a'
    const tabmenu_button_selectors = '.cpnsec-wrapper .nav-wrapper .offer-tabs-navitem a'

    redirectClickToTab([tabmenu_button_selectors,kv_selector,aem_tab_selector].join(", "),function(e){
        const clicked_element = e.currentTarget

        const attribute = $(clicked_element).attr('data-tabmenu')
        if(attribute) return {tabmenu:attribute,scroll:true,prevent_default:true}

        const href = $(clicked_element).prop('href')
        if(!href) return {tabmenu:"",scroll:false,prevent_default:false}

        let current_url = new URL(window.location.href)
        let goto_url = new URL(href)
        current_url.pathname += current_url.pathname[current_url.pathname.length-1] === "/"? "" : "/"
        goto_url.pathname += goto_url.pathname[goto_url.pathname.length-1] === "/"? "" : "/"
        if(current_url.origin !== goto_url.origin || current_url.pathname !== goto_url.pathname) return {tabmenu:"",scroll:false,prevent_default:false}

        const query_tabmenu = new URL(href).searchParams.get("tabmenu")
        if(goto_url.hash){
            scrollTo(goto_url.hash,"on-click")
            return {tabmenu:query_tabmenu,scroll:false,prevent_default:true}
        }

        if(query_tabmenu) return {tabmenu:query_tabmenu,scroll:true,prevent_default:true}

        return {tabmenu:"",scroll:false,prevent_default:false}

    })

    function onLoad(tabmenu){
        let query = new URLSearchParams(window.location.search).get("tabmenu");
        let initial_tab = query
        let initial_scroll = true
        if(window.location.hash){
            scrollTo(window.location.hash,"on-load")
            initial_scroll = false
        }
        if((initial_tab in sku_tab_config) && initial_tab === "bmsm"){
          if(initial_scroll) scrollTo(initial_tab,"on-load")
            initial_tab = tabmenu
            initial_scroll = false
        }
        if(!(initial_tab in sku_tab_config)){
            initial_tab = Object.keys(sku_tab_config)[0]
            initial_scroll = false
        }
          activateTab(initial_tab,initial_scroll,"on-load")

        // $(window).scroll(stickyNav);
        // stickyNav()
    }
    function activateTab(tabmenu,scroll,event){
        const sku_tab = isSkuTab(tabmenu)
        if(sku_tab){
            clearActiveTab()
            setSkuTabActive(tabmenu)
            if(scroll) scrollTo(tabmenu,event)
            if(event !== "on-load") changeBrowserQuery(tabmenu)
        }else if(tabmenu === "bmsm"){
            if(scroll) scrollTo(tabmenu,event)
        }
    }
    function redirectClickToTab(selector,callback){
        $(selector).on('click', function (e) {
            let data = callback(e);
            if(data.prevent_default) e.preventDefault()
            activateTab(data.tabmenu,data.scroll,"on-click")
        });
    }

    function isSkuTab(tabmenu){
        return tabmenu && tabmenu in sku_tab_config && tabmenu !== "bmsm"
    }
    function setSkuTabActive(tabmenu){
        $('#offer-tabs-nav li a[data-tabmenu="'+tabmenu+'"]').parents('.offer-tabs-navitem').addClass('active');
        $(`#${tabmenu}`+'.offer-tab-content').addClass('active');

        $tabMenusSlider.slick('slickGoTo', sku_tab_config[tabmenu]);
    }

    function clearActiveTab() {
        $('li .offer-tabs-navitem').removeClass('active');
        $('.offer-tab-content').removeClass('active');
    }
    function changeBrowserQuery(tabmenu){
        const url = new URL(window.location.href);
        url.searchParams.set('tabmenu', tabmenu);
        window.history.pushState(null, '', url.toString());
    }
    function stickyNav(){
        const offset = 70
        let component = $(".swo-cpnpg-wrapper")[0].getBoundingClientRect();
        if (component.top < offset) $(".nav-wrapper").addClass("sticky");
        else $(".nav-wrapper").removeClass("sticky");
    }
    function scrollTo(selector,event){
        setTimeout(function(){
            if(selector in sku_tab_config && selector !== "bmsm"){
                $('html, body').stop().animate({
                    'scrollTop': $("#offer").offset().top - 60
                }, 300);
            }else{
                window.location.hash="";
                window.location.hash=selector;
                window.location.hash="";
                window.location.hash=selector;
                setTimeout(function (){
                    let isSticky = $('.nav-wrapper').hasClass("sticky");
                    if(isSticky){
                        let currentPositionOfPage = window.scrollY;
                        let navMenuHeight = $("#nav-sticky").outerHeight();
                        window.scrollTo(0, currentPositionOfPage - navMenuHeight);
                    }
                },300)
            }
        },event === "on-load" ? 900 : 300)
      }
});

</script>

