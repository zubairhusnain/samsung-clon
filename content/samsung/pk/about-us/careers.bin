				<button class="cta cta--contained cta--black gnb-js-layer-close" aria-label="Accessibility Text" onclick="window.sg.components.Nv00GnbV4.closeLayerPopup(this);">
					OK
				</button>
			</div>
			<button class="layer-popup__close">
