       <a href="https://www.samsung.com/pk/apps/samsung-health/" class="common__health-cta" target="_blank" title="Open in a new window" data-omni-type="microsite_contentinter" data-omni="gwatch8:highlights:anti-oxidant^antioxidant-index:link-page:samsung-health" ga-ca="content click" ga-ac="feature" ga-la="gwatch8:highlights:anti-oxidant^antioxidant-index:link-page:samsung-health"> 
