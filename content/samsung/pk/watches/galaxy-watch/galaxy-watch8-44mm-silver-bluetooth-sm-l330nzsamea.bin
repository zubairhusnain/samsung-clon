   <!-- Sleep --> 
   <div class="watch-sleep"> 
    <div class="watch-sleep__visual" data-visible-text> 
     <div class="common__inner"> 
      <h2 class="common__headline" data-copy-set="C011-001">Build healthy sleep habits with Galaxy AI</h2> 
     </div> 
     <div class="watch-sleep__image"> 
      <picture data-media-lazy> 
       <source data-empty media="(min-width:0px)" srcset="data:image/gif;base64,R0lGODlhAQABAHAAACH5BAEAAAAALAAAAAABAAEAAAICRAEAOw=="> 
       <source media="(min-width: 768px)" srcset="https://images.samsung.com/pk/galaxy-watch8/feature/galaxy-watch8-sleep-lifestyle.jpg?imbypass=true"> 
       <source media="(max-width: 767px)" srcset="https://images.samsung.com/pk/galaxy-watch8/feature/galaxy-watch8-sleep-lifestyle-mo.jpg?imbypass=true"> 
       <img src="https://images.samsung.com/pk/galaxy-watch8/feature/galaxy-watch8-sleep-lifestyle.jpg?imbypass=true" alt="A person stretching in bed." data-copy-set="C011-002"> 
      </picture> 
     </div> 
    </div> 
    <div class="watch-sleep__content"> 
     <div class="common__inner"> 
      <h3 class="common__label" data-copy-set="C012-001">Bedtime Guidance</h3> 
      <p class="common__title" data-copy-set="C012-002">Form a healthy bedtime routine</p> 
      <div class="watch-sleep__text"> 
       <p class="common__description" data-copy-set="C012-003"> Build good sleep habits with <strong>Bedtime Guidance</strong>. Galaxy Watch8 uses three days worth of sleep data to find your optimal bedtime, the first step toward better sleep. Get smart nudges for your <strong>ideal bedtime</strong> and get the rest you need. Wake up feeling refreshed, fully recharged and better prepared to take on the day — all with a personalized sleep schedule. <sup><a href="#desc-section" class="click_sup" title="See disclaimer" data-sup="2">2</a>,<a href="#desc-section" class="click_sup" title="See disclaimer" data-sup="5">5</a></sup> </p> 
