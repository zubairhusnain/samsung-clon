          }
        ]
      },
      ai: {
        icon: '',
        info: '-',
        boolean: false,
        available: 'not available'
      },
      quickbutton: {
        icon: '',
        info: '-',
        available: 'not available'
      }
    }
  };
</script> 
   <!-- Faq --> 
   <div class="watch-faq"> 
    <div class="common__inner"> 
     <h2 class="common__title">Frequently Asked Questions</h2> 
     <ul class="watch-faq__list" role="list"> 
      <li class="watch-faq__item" role="listitem"> <h3 class="watch-faq__question"> <button type="button" class="watch-faq__button" data-omni-type="microsite_contentinter" data-omni="gwatch8:highlights:faq:acdn-open:comparison" ga-ca="indication" ga-ac="accordion" ga-la="gwatch8:highlights:faq:acdn-open:comparison"> <span class="watch-faq__text">What has changed with Galaxy Watch8's design?</span> 
         <svg xmlns="http://www.w3.org/2000/svg" id="Down" width="40" height="40" viewbox="0 0 40 40"> 
          <g id="Container" transform="translate(40) rotate(90)" fill="none" stroke="#555" stroke-width="1.5"> 
           <circle cx="20" cy="20" r="20" stroke="none" /> 
           <circle cx="20" cy="20" r="19.25" fill="none" /> 
          </g> 
          <g id="Arrow" transform="translate(32 8) rotate(90)"> 
           <rect id="Container-2" data-name="Container" width="24" height="24" fill="rgba(255,255,255,0)" /> 
           <rect id="Container-3" data-name="Container" width="24" height="24" transform="translate(24 24) rotate(180)" fill="rgba(255,255,255,0)" /> 
           <path id="Path" d="M4647.249,176.567l-8.748-8.374,8.748-8.374" transform="translate(4655.629 180.193) rotate(180)" fill="none" stroke="#555" stroke-miterlimit="10" stroke-width="2" /> 
          </g> 
         </svg> </button> </h3> 
       <div class="watch-faq__answer"> 
        <div class="watch-faq__answer-inner"> 
         <p class="watch-faq__description"> The cushion design has been newly added to Galaxy Watch8. With its slimmed-down profile to just 8.6 mm, and the upgraded Dynamic Lug System, it offers a more refined look and a more comfortable fit. <sup><a href="#desc-section" class="click_sup" title="See disclaimer" data-sup="3">3</a>,<a href="#desc-section" class="click_sup" title="See disclaimer" data-sup="4">4</a></sup> </p> 
        </div> 
       </div> </li> 
      <li class="watch-faq__item" role="listitem"> <h3 class="watch-faq__question"> <button type="button" class="watch-faq__button" data-omni-type="microsite_contentinter" data-omni="gwatch8:highlights:faq:acdn-open:outdoor-activities" ga-ca="indication" ga-ac="accordion" ga-la="gwatch8:highlights:faq:acdn-open:outdoor-activities"> <span class="watch-faq__text">Why is Galaxy Watch8 good for outdoor activities?</span> 
         <svg xmlns="http://www.w3.org/2000/svg" id="Down" width="40" height="40" viewbox="0 0 40 40"> 
          <g id="Container" transform="translate(40) rotate(90)" fill="none" stroke="#555" stroke-width="1.5"> 
           <circle cx="20" cy="20" r="20" stroke="none" /> 
           <circle cx="20" cy="20" r="19.25" fill="none" /> 
          </g> 
          <g id="Arrow" transform="translate(32 8) rotate(90)"> 
           <rect id="Container-2" data-name="Container" width="24" height="24" fill="rgba(255,255,255,0)" /> 
           <rect id="Container-3" data-name="Container" width="24" height="24" transform="translate(24 24) rotate(180)" fill="rgba(255,255,255,0)" /> 
           <path id="Path" d="M4647.249,176.567l-8.748-8.374,8.748-8.374" transform="translate(4655.629 180.193) rotate(180)" fill="none" stroke="#555" stroke-miterlimit="10" stroke-width="2" /> 
          </g> 
         </svg> </button> </h3> 
       <div class="watch-faq__answer"> 
        <div class="watch-faq__answer-inner"> 
         <p class="watch-faq__description">Galaxy Watch8 boasts a bright 3,000 nits display, ensuring clear visibility even in bright surroundings — making it suitable for outdoor activities. Powered by a 3 nm processor, it also delivers a seamless user experience, from health monitoring to multitasking across different apps.</p> 
        </div> 
       </div> </li> 
      <li class="watch-faq__item" role="listitem"> <h3 class="watch-faq__question"> <button type="button" class="watch-faq__button" data-omni-type="microsite_contentinter" data-omni="gwatch8:highlights:faq:acdn-open:colors-sizes" ga-ca="indication" ga-ac="accordion" ga-la="gwatch8:highlights:faq:acdn-open:colors-sizes"> <span class="watch-faq__text">What colors and sizes do Galaxy Watch8 come in?</span> 
         <svg xmlns="http://www.w3.org/2000/svg" id="Down" width="40" height="40" viewbox="0 0 40 40"> 
          <g id="Container" transform="translate(40) rotate(90)" fill="none" stroke="#555" stroke-width="1.5"> 
           <circle cx="20" cy="20" r="20" stroke="none" /> 
           <circle cx="20" cy="20" r="19.25" fill="none" /> 
          </g> 
          <g id="Arrow" transform="translate(32 8) rotate(90)"> 
           <rect id="Container-2" data-name="Container" width="24" height="24" fill="rgba(255,255,255,0)" /> 
           <rect id="Container-3" data-name="Container" width="24" height="24" transform="translate(24 24) rotate(180)" fill="rgba(255,255,255,0)" /> 
           <path id="Path" d="M4647.249,176.567l-8.748-8.374,8.748-8.374" transform="translate(4655.629 180.193) rotate(180)" fill="none" stroke="#555" stroke-miterlimit="10" stroke-width="2" /> 
          </g> 
         </svg> </button> </h3> 
       <div class="watch-faq__answer"> 
        <div class="watch-faq__answer-inner"> 
         <p class="watch-faq__description"> Galaxy Watch8 is available in Silver and Graphite. It comes in two sizes, Small (40 mm) and Large (44 mm). <sup><a href="#desc-section" class="click_sup" title="See disclaimer" data-sup="1">1</a></sup> </p> 
        </div> 
       </div> </li> 
      <li class="watch-faq__item" role="listitem"> <h3 class="watch-faq__question"> <button type="button" class="watch-faq__button" data-omni-type="microsite_contentinter" data-omni="gwatch8:highlights:faq:acdn-open:stress" ga-ca="indication" ga-ac="accordion" ga-la="gwatch8:highlights:faq:acdn-open:stress"> <span class="watch-faq__text">Can Galaxy Watch8 monitor my stress levels?</span> 
         <svg xmlns="http://www.w3.org/2000/svg" id="Down" width="40" height="40" viewbox="0 0 40 40"> 
          <g id="Container" transform="translate(40) rotate(90)" fill="none" stroke="#555" stroke-width="1.5"> 
           <circle cx="20" cy="20" r="20" stroke="none" /> 
           <circle cx="20" cy="20" r="19.25" fill="none" /> 
          </g> 
          <g id="Arrow" transform="translate(32 8) rotate(90)"> 
           <rect id="Container-2" data-name="Container" width="24" height="24" fill="rgba(255,255,255,0)" /> 
           <rect id="Container-3" data-name="Container" width="24" height="24" transform="translate(24 24) rotate(180)" fill="rgba(255,255,255,0)" /> 
           <path id="Path" d="M4647.249,176.567l-8.748-8.374,8.748-8.374" transform="translate(4655.629 180.193) rotate(180)" fill="none" stroke="#555" stroke-miterlimit="10" stroke-width="2" /> 
          </g> 
         </svg> </button> </h3> 
       <div class="watch-faq__answer"> 
        <div class="watch-faq__answer-inner"> 
         <p class="watch-faq__description"> Yes, Galaxy Watch8 can monitor your stress levels. You can set up Galaxy Watch8 to automatically track your stress levels throughout the day. When the levels are high, you'll receive alerts and you can take guided breathing exercises to relieve tension. You can also manually monitor your stress levels whenever you need to stay on top of your mental well-being. <sup><a href="#desc-section" class="click_sup" title="See disclaimer" data-sup="10">10</a></sup> </p> 
        </div> 
       </div> </li> 
      <li class="watch-faq__item" role="listitem"> <h3 class="watch-faq__question"> <button type="button" class="watch-faq__button" data-omni-type="microsite_contentinter" data-omni="gwatch8:highlights:faq:acdn-open:battery" ga-ca="indication" ga-ac="accordion" ga-la="gwatch8:highlights:faq:acdn-open:battery"> <span class="watch-faq__text">What is Galaxy Watch8 battery life capacity?</span> 
         <svg xmlns="http://www.w3.org/2000/svg" id="Down" width="40" height="40" viewbox="0 0 40 40"> 
          <g id="Container" transform="translate(40) rotate(90)" fill="none" stroke="#555" stroke-width="1.5"> 
           <circle cx="20" cy="20" r="20" stroke="none" /> 
           <circle cx="20" cy="20" r="19.25" fill="none" /> 
          </g> 
          <g id="Arrow" transform="translate(32 8) rotate(90)"> 
           <rect id="Container-2" data-name="Container" width="24" height="24" fill="rgba(255,255,255,0)" /> 
           <rect id="Container-3" data-name="Container" width="24" height="24" transform="translate(24 24) rotate(180)" fill="rgba(255,255,255,0)" /> 
           <path id="Path" d="M4647.249,176.567l-8.748-8.374,8.748-8.374" transform="translate(4655.629 180.193) rotate(180)" fill="none" stroke="#555" stroke-miterlimit="10" stroke-width="2" /> 
          </g> 
         </svg> </button> </h3> 
       <div class="watch-faq__answer"> 
        <div class="watch-faq__answer-inner"> 
         <p class="watch-faq__description">Battery life on Galaxy Watch8 varies depending on the usage. The 40 mm model comes with a 325 mAh battery, and the 44 mm model has a 435 mAh battery. Both offer up to 30 hours of use in Always On Display (AOD) mode.</p> 
        </div> 
       </div> </li> 
      <li class="watch-faq__item" role="listitem"> <h3 class="watch-faq__question"> <button type="button" class="watch-faq__button" data-omni-type="microsite_contentinter" data-omni="gwatch8:highlights:faq:acdn-open:lte-bluetooth" ga-ca="indication" ga-ac="accordion" ga-la="gwatch8:highlights:faq:acdn-open:lte-bluetooth"> <span class="watch-faq__text">Does Galaxy Watch8 support both LTE and Bluetooth?</span> 
         <svg xmlns="http://www.w3.org/2000/svg" id="Down" width="40" height="40" viewbox="0 0 40 40"> 
          <g id="Container" transform="translate(40) rotate(90)" fill="none" stroke="#555" stroke-width="1.5"> 
           <circle cx="20" cy="20" r="20" stroke="none" /> 
           <circle cx="20" cy="20" r="19.25" fill="none" /> 
          </g> 
          <g id="Arrow" transform="translate(32 8) rotate(90)"> 
           <rect id="Container-2" data-name="Container" width="24" height="24" fill="rgba(255,255,255,0)" /> 
           <rect id="Container-3" data-name="Container" width="24" height="24" transform="translate(24 24) rotate(180)" fill="rgba(255,255,255,0)" /> 
           <path id="Path" d="M4647.249,176.567l-8.748-8.374,8.748-8.374" transform="translate(4655.629 180.193) rotate(180)" fill="none" stroke="#555" stroke-miterlimit="10" stroke-width="2" /> 
          </g> 
         </svg> </button> </h3> 
       <div class="watch-faq__answer"> 
        <div class="watch-faq__answer-inner"> 
         <p class="watch-faq__description">Galaxy Watch8 comes in both LTE and Bluetooth model, giving users flexible options depending on their lifestyle and environment. With the LTE version, you can make calls, send messages, stream music and receive notifications without needing your phone nearby. It's ideal for staying connected while on the go. The Bluetooth version allows you to use the watch independently in known networks, especially when you're at home, work or any place with Wi-Fi. Both options enable a high level of standalone functionality, ensuring you can stay connected your way — whether you're on the move or on a network.</p> 
        </div> 
       </div> </li> 
      <li class="watch-faq__item" role="listitem"> <h3 class="watch-faq__question"> <button type="button" class="watch-faq__button" data-omni-type="microsite_contentinter" data-omni="gwatch8:highlights:faq:acdn-open:compatible" ga-ca="indication" ga-ac="accordion" ga-la="gwatch8:highlights:faq:acdn-open:compatible"> <span class="watch-faq__text">Which smartphones are compatible with Galaxy Watch8?</span> 
         <svg xmlns="http://www.w3.org/2000/svg" id="Down" width="40" height="40" viewbox="0 0 40 40"> 
          <g id="Container" transform="translate(40) rotate(90)" fill="none" stroke="#555" stroke-width="1.5"> 
           <circle cx="20" cy="20" r="20" stroke="none" /> 
           <circle cx="20" cy="20" r="19.25" fill="none" /> 
          </g> 
          <g id="Arrow" transform="translate(32 8) rotate(90)"> 
           <rect id="Container-2" data-name="Container" width="24" height="24" fill="rgba(255,255,255,0)" /> 
           <rect id="Container-3" data-name="Container" width="24" height="24" transform="translate(24 24) rotate(180)" fill="rgba(255,255,255,0)" /> 
           <path id="Path" d="M4647.249,176.567l-8.748-8.374,8.748-8.374" transform="translate(4655.629 180.193) rotate(180)" fill="none" stroke="#555" stroke-miterlimit="10" stroke-width="2" /> 
          </g> 
         </svg> </button> </h3> 
       <div class="watch-faq__answer"> 
        <div class="watch-faq__answer-inner"> 
         <p class="watch-faq__description"> Galaxy Watch8 works with smartphones running Android 12 or higher. <sup><a href="#desc-section" class="click_sup" title="See disclaimer" data-sup="17">17</a></sup> </p> 
        </div> 
       </div> </li> 
      <li class="watch-faq__item" role="listitem"> <h3 class="watch-faq__question"> <button type="button" class="watch-faq__button" data-omni-type="microsite_contentinter" data-omni="gwatch8:highlights:faq:acdn-open:gps" ga-ca="indication" ga-ac="accordion" ga-la="gwatch8:highlights:faq:acdn-open:gps"> <span class="watch-faq__text">Does Galaxy Watch8 have Dual-band GPS?</span> 
         <svg xmlns="http://www.w3.org/2000/svg" id="Down" width="40" height="40" viewbox="0 0 40 40"> 
          <g id="Container" transform="translate(40) rotate(90)" fill="none" stroke="#555" stroke-width="1.5"> 
           <circle cx="20" cy="20" r="20" stroke="none" /> 
           <circle cx="20" cy="20" r="19.25" fill="none" /> 
          </g> 
          <g id="Arrow" transform="translate(32 8) rotate(90)"> 
           <rect id="Container-2" data-name="Container" width="24" height="24" fill="rgba(255,255,255,0)" /> 
           <rect id="Container-3" data-name="Container" width="24" height="24" transform="translate(24 24) rotate(180)" fill="rgba(255,255,255,0)" /> 
           <path id="Path" d="M4647.249,176.567l-8.748-8.374,8.748-8.374" transform="translate(4655.629 180.193) rotate(180)" fill="none" stroke="#555" stroke-miterlimit="10" stroke-width="2" /> 
          </g> 
         </svg> </button> </h3> 
       <div class="watch-faq__answer"> 
        <div class="watch-faq__answer-inner"> 
         <p class="watch-faq__description"> Yes, Galaxy Watch8 has Dual-band GPS. It uses both L1 and L5 GPS for enhanced accuracy. <sup><a href="#desc-section" class="click_sup" title="See disclaimer" data-sup="19">19</a>,<a href="#desc-section" class="click_sup" title="See disclaimer" data-sup="20">20</a></sup> </p> 
        </div> 
       </div> </li> 
      <li class="watch-faq__item" role="listitem"> <h3 class="watch-faq__question"> <button type="button" class="watch-faq__button" data-omni-type="microsite_contentinter" data-omni="gwatch8:highlights:faq:acdn-open:charge" ga-ca="indication" ga-ac="accordion" ga-la="gwatch8:highlights:faq:acdn-open:charge"> <span class="watch-faq__text">How do I charge Galaxy Watch8?</span> 
         <svg xmlns="http://www.w3.org/2000/svg" id="Down" width="40" height="40" viewbox="0 0 40 40"> 
          <g id="Container" transform="translate(40) rotate(90)" fill="none" stroke="#555" stroke-width="1.5"> 
           <circle cx="20" cy="20" r="20" stroke="none" /> 
           <circle cx="20" cy="20" r="19.25" fill="none" /> 
          </g> 
          <g id="Arrow" transform="translate(32 8) rotate(90)"> 
           <rect id="Container-2" data-name="Container" width="24" height="24" fill="rgba(255,255,255,0)" /> 
           <rect id="Container-3" data-name="Container" width="24" height="24" transform="translate(24 24) rotate(180)" fill="rgba(255,255,255,0)" /> 
           <path id="Path" d="M4647.249,176.567l-8.748-8.374,8.748-8.374" transform="translate(4655.629 180.193) rotate(180)" fill="none" stroke="#555" stroke-miterlimit="10" stroke-width="2" /> 
          </g> 
         </svg> </button> </h3> 
       <div class="watch-faq__answer"> 
        <div class="watch-faq__answer-inner"> 
         <p class="watch-faq__description">You can charge Galaxy Watch8 using the Wireless Charger it comes with. Just place your watch on the charger for easy, wireless charging.</p> 
        </div> 
       </div> </li> 
     </ul> 
    </div> 
