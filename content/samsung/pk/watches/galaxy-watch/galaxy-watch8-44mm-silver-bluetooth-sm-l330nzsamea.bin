    <!-- Aging Well --> 
    <div class="watch-aging-well"> 
     <div class="common__inner"> 
      <p class="common__label" data-copy-set="C026-001">Antioxidant index</p> 
      <h2 class="common__title" data-copy-set="C026-002">Balance your diet</h2> 
      <p class="common__description" data-copy-set="C026-003"> Find out if you're on the right track to aging well with Galaxy Watch8, <strong>the world's first smartwatch that measures your antioxidant level</strong>. Place your thumb on the sensor to measure the carotenoid levels in your skin and see how healthy your current diet and lifestyle are. Check your antioxidant index to improve your well-being and lower the risk of diseases. <sup><a href="#desc-section" class="click_sup" title="See disclaimer" data-sup="2">2</a>,<a href="#desc-section" class="click_sup" title="See disclaimer" data-sup="28">28</a>,<a href="#desc-section" class="click_sup" title="See disclaimer" data-sup="29">29</a>,<a href="#desc-section" class="click_sup" title="See disclaimer" data-sup="30">30</a>,<a href="#desc-section" class="click_sup" title="See disclaimer" data-sup="31">31</a></sup> </p> 
