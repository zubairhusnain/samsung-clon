     <div class="watch-card"> 
      <div class="watch-card__container swiper-container"> 
       <ul class="watch-card__list swiper-wrapper" role="list"> 
        <li class="watch-card__item swiper-slide" role="listitem" data-tagging="ages-index"> 
         <div class="watch-card__inner"> 
          <div class="watch-card__text"> 
           <h3 class="watch-card__label" data-copy-set="C027-001">AGEs index</h3> 
           <p class="watch-card__title" data-copy-set="C027-002">Stay in the know about your AGEs index</p> 
           <p class="watch-card__description" data-copy-set="C027-003"> Maintain your metabolic health with Galaxy Watch8. Just wear it while you sleep, and effortlessly stay in control of your <strong>AGEs (Advanced Glycation End-products) index</strong>. Galaxy Watch8 monitors your AGEs index across four levels, helping you understand your current state. Support healthier aging and a more balanced lifestyle with insightful guidance. <sup><a href="#desc-section" class="click_sup" title="See disclaimer" data-sup="32">32</a></sup> </p> 
          </div> 
          <div class="watch-card__image-wrap"> 
           <div class="watch-card__image"> 
            <picture data-media-lazy> 
             <source data-empty media="(min-width:0px)" srcset="data:image/gif;base64,R0lGODlhAQABAHAAACH5BAEAAAAALAAAAAABAAEAAAICRAEAOw=="> 
