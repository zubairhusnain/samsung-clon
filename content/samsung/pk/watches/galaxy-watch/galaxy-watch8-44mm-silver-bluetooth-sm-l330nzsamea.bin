          <li class="watch-howto-popup__thumb-item swiper-slide" data-howto-slide="how-to-use-running-coach"> <button type="button" class="watch-howto-popup__thumb-btn" data-omni-type="microsite_contentinter" data-omni="gwatch8:highlights:how-to-popup:slct-video:how-to-use-running-coach" ga-ca="content click" ga-ac="feature" ga-la="gwatch8:highlights:how-to-popup:slct-video:how-to-use-running-coach"> 
            <div class="watch-howto-popup__thumb-image-wrap"> 
