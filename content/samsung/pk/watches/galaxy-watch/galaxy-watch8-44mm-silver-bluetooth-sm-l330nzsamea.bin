    <div class="watch-card"> 
     <div class="watch-card__container swiper-container"> 
      <ul class="watch-card__list swiper-wrapper" role="list"> 
       <li class="watch-card__item swiper-slide" role="listitem" data-tagging="sleep-tracking"> 
        <div class="watch-card__inner"> 
         <div class="watch-card__text"> 
          <h3 class="watch-card__label" data-copy-set="C014-001">Sleep Tracking</h3> 
          <p class="watch-card__title" data-copy-set="C014-002">Gain sleep insights and get deeper rest</p> 
          <p class="watch-card__description" data-copy-set="C014-003"> Simply wear Galaxy Watch8 to bed and wake up to a clear picture of how your sleep went the night before. With detailed insights into your sleep including <strong>sleep stages, consistency, heart rate and blood oxygen levels</strong>, you can shed light on aspects of your sleep you were previously in the dark about. Train your sleep, gain deeper rest and energize your day. <sup><a href="#desc-section" class="click_sup" title="See disclaimer" data-sup="7">7</a></sup> </p> 
         </div> 
         <div class="watch-card__image-wrap"> 
          <div class="watch-card__image"> 
           <picture data-media-lazy> 
