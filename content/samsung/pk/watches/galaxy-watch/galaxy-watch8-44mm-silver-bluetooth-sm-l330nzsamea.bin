    <div class="watch-card"> 
     <div class="watch-card__container swiper-container"> 
      <ul class="watch-card__list swiper-wrapper" role="list"> 
       <li class="watch-card__item swiper-slide" role="listitem" data-tagging="personalized-hr-zone"> 
        <div class="watch-card__inner"> 
         <div class="watch-card__text"> 
          <h3 class="watch-card__label" data-copy-set="C019-001">Personalized HR Zone</h3> 
          <p class="watch-card__title" data-copy-set="C019-002">Train better with Personalized HR Zone</p> 
          <p class="watch-card__description" data-copy-set="C019-003"> Check your real-time heart rate for safe and effective outdoor running. Monitor your <strong>personalized heart rate zone</strong> as you run, and adjust the intensity to suit your condition. Understand your physical capabilities better and ensure you're training at the <strong>optimal intensity</strong> to reach your <strong>running goals</strong>. <sup><a href="#desc-section" class="click_sup" title="See disclaimer" data-sup="16">16</a></sup> </p> 
         </div> 
         <div class="watch-card__image-wrap"> 
          <div class="watch-card__image"> 
