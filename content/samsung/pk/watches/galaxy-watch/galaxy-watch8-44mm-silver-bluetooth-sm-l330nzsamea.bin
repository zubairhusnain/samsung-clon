.watch-quote-inner {
    width: 100%;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
}
@media screen and (min-width: 768px) {
    .watch-quote{padding-top: 100px; padding-bottom: 50px;}
    .watch-quote-inner {
        width: 988px;
        flex-direction: row;
    }
    .watch-quote-title{font-size: 24px;line-height: 1.33;}
    .watch-des {margin-top: 16px}
}
.watch-quote-item{max-width: 316px;text-align: center;}
.watch-quote-title{font-size: 20px;line-height: 1.45;color: #000;}
.watch-des {margin-top: 10px;font-size: 24px;line-height: 1.33;color: #000;}
.watch-quote-img{width: 100%; padding-bottom: 30px;}
