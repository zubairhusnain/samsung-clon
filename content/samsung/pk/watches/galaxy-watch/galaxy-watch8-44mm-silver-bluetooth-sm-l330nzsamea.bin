    <!-- CXP - Face & Band --> 
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "Article",
      "headline": "Make it yours, face to band",
      "description": "Galaxy Watch8's bands are easy to change and suitable for different occasions, and the watch face can be customized using the Galaxy Wearable app.",
      "articleBody": "Change your band in a snap, and get ready for whatever's next. Go for the Sport Band when you're breaking a sweat, or settle for the soft Fabric Band for undisturbed comfort throughout the night. Plus, customize your watch face in the Galaxy Wearable app with options that range from colors to components.",
      "mainEntityOfPage": {
        "@id": "https://www.samsung.com/uk/watches/galaxy-watch/galaxy-watch8-44mm-graphite-bluetooth-sm-l330ndaaeua/"
      }
    }
  </script> 
   </div> 
   <!-- Device --> 
   <div class="watch-device"> 
    <div class="watch-device__inner"> 
     <div class="watch-device__text"> 
      <h2 class="common__title" data-copy-set="C041-001"> Expanded <br> Galaxy Wearable experience </h2> 
      <p class="common__description" data-copy-set="C041-002"> Get started with your Galaxy Watch seamlessly on your <strong>Android™ smartphone</strong>. Simply download <strong>Galaxy Wearable</strong> and <strong>Samsung Health apps</strong> from Google Play to connect your Android phone to your Galaxy Watch. Now, you can experience the latest Galaxy Wearable device — Galaxy Watch8. Enjoy the features, from health tracking to sleep coaching, that are integrated into a sleek cushion design. <sup><a href="#desc-section" class="click_sup" title="See disclaimer" data-sup="45">45</a>,<a href="#desc-section" class="click_sup" title="See disclaimer" data-sup="46">46</a>,<a href="#desc-section" class="click_sup" title="See disclaimer" data-sup="47">47</a>,<a href="#desc-section" class="click_sup" title="See disclaimer" data-sup="48">48</a>,<a href="#desc-section" class="click_sup" title="See disclaimer" data-sup="49">49</a>,<a href="#desc-section" class="click_sup" title="See disclaimer" data-sup="50">50</a>,<a href="#desc-section" class="click_sup" title="See disclaimer" data-sup="51">51</a></sup> </p> 
     </div> 
     <div class="watch-device__image-wrap"> 
      <div class="watch-device__image"> 
       <picture data-media-lazy> 
        <source data-empty media="(min-width:0px)" srcset="data:image/gif;base64,R0lGODlhAQABAHAAACH5BAEAAAAALAAAAAABAAEAAAICRAEAOw=="> 
        <source media="(min-width: 768px)" srcset="https://images.samsung.com/pk/galaxy-watch8/feature/galaxy-watch8-device-compatibility.jpg?imbypass=true"> 
        <source media="(max-width: 767px)" srcset="https://images.samsung.com/pk/galaxy-watch8/feature/galaxy-watch8-device-compatibility-mo.jpg?imbypass=true"> 
        <img src="https://images.samsung.com/pk/galaxy-watch8/feature/galaxy-watch8-device-compatibility.jpg?imbypass=true" alt="Galaxy Watch8 displays the Energy Score screen with the Energy Score of 92 and the word 'Excellent'. Next to it, an Android smartphone displays the Samsung Health screen with Energy Score, Daily Activity, Sleep score and Exercise Tracking." data-copy-set="C041-003"> 
       </picture> 
      </div> 
     </div> 
     <div class="watch-device__cta"> 
      <a href="//play.google.com/store/apps/details?id=com.samsung.android.app.watchmanager" class="common-cta" target="_blank" title="Open in a new window" data-omni-type="microsite_contentinter" data-omni="gwatch8:highlights:compatibility:link-page:galaxy-wearable-app" ga-ca="content click" ga-ac="feature" ga-la="gwatch8:highlights:compatibility:link-page:galaxy-wearable-app"><span data-copy-set="C041-004">Galaxy Wearable App</span></a> 
