       <li class="watch-card__item swiper-slide" role="listitem" data-tagging="mindfulness-tracker"> 
        <div class="watch-card__inner"> 
         <div class="watch-card__text"> 
          <h3 class="watch-card__label" data-copy-set="C034-001">Mindfulness Tracker</h3> 
          <p class="watch-card__title" data-copy-set="C034-002">Stay centered with Mindfulness Tracker</p> 
          <p class="watch-card__description" data-copy-set="C034-003"> Monitor your moods and observe how they change. Log and track your <strong>daily emotions</strong> to enhance your mental wellness. Explore different ways to practice mindfulness and follow your progress over time. <sup><a href="#desc-section" class="click_sup" title="See disclaimer" data-sup="36">36</a>,<a href="#desc-section" class="click_sup" title="See disclaimer" data-sup="37">37</a>,<a href="#desc-section" class="click_sup" title="See disclaimer" data-sup="38">38</a></sup> </p> 
         </div> 
         <div class="watch-card__image-wrap"> 
