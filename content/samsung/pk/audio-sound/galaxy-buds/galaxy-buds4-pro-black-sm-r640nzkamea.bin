   <!-- Enhanced 2 way Spk --> 
   <div id="2-way-speaker-with-dual-amp" class="buds-2-way-spk black-theme"> 
    <div class="common__headline-wrap common__headline-wrap--center visible-text is-visible"> 
     <h3 class="common__eyebrow" data-copy-set="C10-01">ADVANCED 2-WAY SPEAKER</h3> 
     <p class="common__sub-headline" data-copy-set="C10-02"> Hi-Fi sound.<br class="common-br-mo"> Hear the full range </p> 
    </div> 
    <p class="common__description" data-copy-set="C10-03">Meet the <strong>true Hi-Fi Galaxy Buds</strong>. The <strong>advanced 2-way Speaker</strong> paired with <strong>dedicated Dual Amp</strong> is meticulously tuned to achieve high-fidelity sound across the full spectrum. Bring the studio-scale listening system to your ears, wherever you are.</p> 
    <div class="type-video"> 
     <div class="common-video"> 
      <figure class="common-video__wrapper"> 
       <video playsinline muted preload="none" data-media-lazy data-media-id="media-f4n9m" data-src-pc="https://images.samsung.com/pk/galaxy-buds4-pro/feature/galaxy-buds4-pro-sound-hifispeakers.mp4" aria-label="A single Galaxy Buds4 Pro earbud in an exploded view, showing the audio system within, including the wider woofer and the tweeter of the 2-way Speaker." data-copy-set="C10-04"></video> 
       <picture class="common-video__start-frame" data-media-lazy data-media-id="media-d6r3y"> 
        <source data-empty media="(min-width:0px)" srcset="data:image/gif;base64,R0lGODlhAQABAHAAACH5BAEAAAAALAAAAAABAAEAAAICRAEAOw=="> 
        <source media="(min-width: 768px)" srcset="https://images.samsung.com/pk/galaxy-buds4-pro/feature/galaxy-buds4-pro-sound-hifispeakers-tb.jpg?imbypass=true"> 
        <img src="https://images.samsung.com/pk/galaxy-buds4-pro/feature/galaxy-buds4-pro-sound-hifispeakers-tb.jpg?imbypass=true" alt=""> 
       </picture> 
      </figure> 
      <button type="button" class="common-video__controller common-video__controller--white" title="Hi-Fi sound. Hear the full range video" data-omni-type="microsite_contentinter" data-omni="gbuds4pro:features:sound^2-way-speaker-dual-amp:movi-pause:main-movie" ga-ca="content click" ga-ac="feature" ga-la="gbuds4pro:features:sound^2-way-speaker-dual-amp:movi-pause:main-movie"> 
       <svg class="common-icon" focusable="false" aria-hidden="true"> 
        <use xlink:href="#wearable-video-play" href="#wearable-video-play" class="play"></use> 
        <use xlink:href="#wearable-video-pause" href="#wearable-video-pause" class="pause"></use> 
       </svg> <span class="blind">pause</span> </button> 
     </div> 
     <div class="common-image"> 
      <picture data-media-lazy data-media-id="media-9h1pw"> 
       <source data-empty media="(min-width:0px)" srcset="data:image/gif;base64,R0lGODlhAQABAHAAACH5BAEAAAAALAAAAAABAAEAAAICRAEAOw=="> 
       <source media="(max-width: 767px)" srcset="https://images.samsung.com/pk/galaxy-buds4-pro/feature/galaxy-buds4-pro-sound-hifispeakers-mo.jpg?imbypass=true"> 
       <img src="https://images.samsung.com/pk/galaxy-buds4-pro/feature/galaxy-buds4-pro-sound-hifispeakers-mo.jpg?imbypass=true" alt="A single Galaxy Buds4 Pro earbud in an exploded view, showing the audio system within, including the wider woofer and the tweeter of the 2-way Speaker." data-copy-set="C10-04"> 
      </picture> 
     </div> 
    </div> 
    <div class="common__inner visible-swiper" data-threshold="0.5"> 
     <div class="buds-2-way-spk__info-container swiper-container"> 
      <ul class="buds-2-way-spk__info swiper-wrapper" role="list"> 
       <li class="buds-2-way-spk__info-detail swiper-slide visible-text is-visible" role="listitem" data-visible-mo="swiper" data-visible-pc="video"> <span class="buds-2-way-spk__info-icon"> 
         <svg class="common-icon" focusable="false" aria-hidden="true"> 
          <use xlink:href="#buds-sound-speaker" href="#buds-sound-speaker"></use> 
         </svg> </span> <h4 class="buds-2-way-spk__info-title" data-copy-set="C10-05">2-way Speaker</h4> <p class="buds-2-way-spk__info-description" data-copy-set="C10-06"> Two separate drivers — the newly designed <strong>wider woofer</strong> with an expanded diaphragm area, and a precision tweeter — are expertly aligned to reproduce sound that remains faithful to the original recording. The <strong>advanced 2-way Speaker</strong> delivers a full-range performance, from deep, textured sub-bass to airy, extended highs, while preserving natural bass resonance with faster transient response, a rich midrange body and sharp detail.<sup><a href="#desc-section" class="click_sup" title="See disclaimer" data-sup-tag="sup-5"></a></sup> </p> </li> 
       <li class="buds-2-way-spk__info-detail swiper-slide visible-text is-visible" role="listitem" data-visible-mo="swiper" data-visible-pc="video"> <span class="buds-2-way-spk__info-icon"> 
         <svg class="common-icon" focusable="false" aria-hidden="true"> 
          <use xlink:href="#buds-sound-amplifier" href="#buds-sound-amplifier"></use> 
         </svg> </span> <h4 class="buds-2-way-spk__info-title" data-copy-set="C10-07">Dual Amplifier</h4> <p class="buds-2-way-spk__info-description" data-copy-set="C10-08">Each amplifier on Galaxy Buds4 Pro is <strong>dedicated to its own driver</strong>, expanding sound coverage while reducing distortion and interference through meticulous tuning. The result is a high-fidelity soundscape that immerses you in the full spectrum of sound.</p> </li> 
      </ul> 
      <div class="buds-2-way-spk__pagination"> 
       <ul class="buds-2-way-spk__pagination-list swiper-pagination" role="list" data-tagging="gbuds4pro:features:sound^2-way-speaker-dual-amp:index"></ul> 
      </div> 
     </div> 
    </div> 
