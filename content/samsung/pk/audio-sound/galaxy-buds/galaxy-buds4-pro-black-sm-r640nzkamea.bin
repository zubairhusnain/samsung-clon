          <source media="(max-width: 767px)" srcset="https://images.samsung.com/pk/galaxy-buds4-pro/feature/galaxy-buds4-pro-anc-02-mo.jpg?imbypass=true"> 
          <img src="https://images.samsung.com/pk/galaxy-buds4-pro/feature/galaxy-buds4-pro-anc-02.jpg?imbypass=true" alt=""> 
