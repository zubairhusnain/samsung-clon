   <!-- Interpreter --> 
   <div id="interpreter" class="buds-interpreter"> 
    <div class="buds-gallery"> 
     <div class="buds-gallery__container"> 
      <div class="common__headline-wrap visible-text is-visible"> 
       <h3 class="common__eyebrow" data-copy-set="C24-01">INTERPRETER</h3> 
       <p class="common__sub-headline" data-copy-set="C24-02">Personal AI Translator in your ear</p> 
      </div> 
      <p class="common__description" data-copy-set="C24-03"> Break language barriers with a personal AI translator in your ear. Fully engage in the moment with <strong>Galaxy AI-powered Interpreter</strong> — hear it through Galaxy Buds4 Pro and read it on your Galaxy smartphone. Galaxy AI steps in to ensure clear communication across different languages.<sup><a href="#desc-section" class="click_sup" title="See disclaimer" data-sup-tag="sup-1"></a>,<a href="#desc-section" class="click_sup" title="See disclaimer" data-sup-tag="sup-18"></a>,<a href="#desc-section" class="click_sup" title="See disclaimer" data-sup-tag="sup-19"></a></sup> </p> 
