        <li class="common-bottom-disclaimer__list-item" role="listitem" data-sup="sup-2"> <span class="text_disclaimer" data-copy-set="disclaimer">Availability of colors may vary by country or carrier. Pink Gold color sold exclusively online at Samsung.com.</span> <button type="button" class="common-bottom-disclaimer__back-cta"> <span class="sr-only">Back to Location</span> 
          <svg class="common-icon" focusable="false" aria-hidden="true"> 
           <use xlink:href="#wearable-disclaimer-top" href="#wearable-disclaimer-top"></use> 
