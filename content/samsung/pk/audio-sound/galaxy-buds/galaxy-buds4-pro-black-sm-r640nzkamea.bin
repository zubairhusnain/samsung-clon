         <div class="buds-multi-ai-agent__image buds-multi-ai-agent__image-left"> 
          <picture data-media-lazy data-media-id="media-y6v2r"> 
           <source data-empty media="(min-width:0px)" srcset="data:image/gif;base64,R0lGODlhAQABAHAAACH5BAEAAAAALAAAAAABAAEAAAICRAEAOw=="> 
           <source media="(min-width: 1px)" srcset="https://images.samsung.com/pk/galaxy-buds4-pro/feature/galaxy-buds4-pro-galaxyexperience-buds-left.png?imbypass=true"> 
