   <!-- Hi-fi Anc --> 
   <div id="enhanced-anc" class="buds-hi-fi-anc black-theme"> 
    <div class="common__inner"> 
     <div class="buds-hi-fi-anc__contents"> 
      <div class="buds-hi-fi-anc__headline-wrap common__headline-wrap visible-text is-visible"> 
       <h3 class="common__eyebrow" data-copy-set="C16-01">ENHANCED ANC</h3> 
       <p class="common__sub-headline" data-copy-set="C16-02">Let Hi-Fi sound stay vivid</p> 
      </div> 
      <p class="common__description" data-copy-set="C16-03">With its top-notch high-fidelity sound system, Galaxy Buds4 Pro achieves precise noise control. Distractions fade in real-time as the <strong>Active Noise Canceling (ANC) algorithm</strong> instantly processes and adapts to your ear shape and fit. Listen to vivid, layered and deeply engaging Hi-Fi sound wherever you are.</p> 
     </div> 
     <div class="buds-hi-fi-anc__image"> 
      <picture data-media-lazy data-media-id="media-f2k4t"> 
       <source data-empty media="(min-width:0px)" srcset="data:image/gif;base64,R0lGODlhAQABAHAAACH5BAEAAAAALAAAAAABAAEAAAICRAEAOw=="> 
       <source media="(min-width: 768px)" srcset="https://images.samsung.com/pk/galaxy-buds4-pro/feature/galaxy-buds4-pro-anc-adaptiveanc.jpg?imbypass=true"> 
       <source media="(max-width: 767px)" srcset="https://images.samsung.com/pk/galaxy-buds4-pro/feature/galaxy-buds4-pro-anc-adaptiveanc-mo.jpg?imbypass=true"> 
       <img src="https://images.samsung.com/pk/galaxy-buds4-pro/feature/galaxy-buds4-pro-anc-adaptiveanc.jpg?imbypass=true" alt="A single Galaxy Buds4 Pro earbud in skeleton view, showing the audio system within. On the right are multiple dots that are entirely separated from the earbud, indicating the Active Noise Canceling feature." data-copy-set="C16-04"> 
      </picture> 
     </div> 
    </div> 
   </div> 
   <div id="buds-parallax03" class="buds-parallax"> 
    <div class="buds-parallax__top"> 
     <!-- Adaptive Noise Control --> 
     <div id="adaptive-noise-control" class="buds-adaptive-noise-control black-theme"> 
      <div class="common__inner"> 
       <div class="common__headline-wrap common__headline-wrap--center visible-text is-visible"> 
        <h3 class="common__eyebrow" data-copy-set="C17-01">ADAPTIVE NOISE CONTROL</h3> 
        <p class="common__sub-headline" data-copy-set="C17-02">Stay immersed, stay connected</p> 
       </div> 
       <p class="common__description" data-copy-set="C17-03"> Manage your listening experience your way. Galaxy Buds4 Pro adjusts the levels of <strong>ANC and ambient sounds</strong> in real-time, adapting to your environment — whether you're sensitive to noise or prefer more blending. Stay more immersed in the music while remaining connected to the world around you.<sup><a href="#desc-section" class="click_sup" title="See disclaimer" data-sup-tag="sup-11"></a></sup> </p> 
       <div class="buds-adaptive-noise-control__image"> 
        <picture data-media-lazy data-media-id="media-h4j2r"> 
         <source data-empty media="(min-width:0px)" srcset="data:image/gif;base64,R0lGODlhAQABAHAAACH5BAEAAAAALAAAAAABAAEAAAICRAEAOw=="> 
         <source media="(min-width: 768px)" srcset="https://images.samsung.com/pk/galaxy-buds4-pro/feature/galaxy-buds4-pro-anc-adaptivenoisecontrol.jpg?imbypass=true"> 
         <source media="(max-width: 767px)" srcset="https://images.samsung.com/pk/galaxy-buds4-pro/feature/galaxy-buds4-pro-anc-adaptivenoisecontrol-mo.jpg?imbypass=true"> 
         <img src="https://images.samsung.com/pk/galaxy-buds4-pro/feature/galaxy-buds4-pro-anc-adaptivenoisecontrol.jpg?imbypass=true" alt="A woman with a single, white Galaxy Buds4 Pro earbud in her ear looking towards the right." data-copy-set="C17-04"> 
        </picture> 
       </div> 
      </div> 
      <div class="common__inner"> 
       <div class="buds-card visible-swiper"> 
        <div class="buds-card__container swiper-container"> 
         <ul class="buds-card__list swiper-wrapper" role="list"> 
          <li class="buds-card__item swiper-slide" role="listitem"> 
           <div class="buds-card__inner"> 
            <div class="buds-card__text"> 
             <div class="common__headline-wrap visible-text is-visible" data-visible-mo="swiper"> 
              <h3 class="common__eyebrow" data-copy-set="C18-01">VOICE DETECT</h3> 
              <p class="buds-card__title common__sub-headline" data-copy-set="C18-02">Jump right into conversations</p> 
             </div> 
             <p class="buds-card__description" data-copy-set="C18-03"> Keep your Galaxy Buds4 Pro on, even when a conversation starts. Once you begin speaking, it automatically switches to ambient mode. Stay present without missing a beat.<sup><a href="#desc-section" class="click_sup" title="See disclaimer" data-sup-tag="sup-11"></a></sup> </p> 
            </div> 
            <div class="buds-card__media"> 
             <picture data-media-lazy data-media-id="media-1m3q6"> 
              <source data-empty media="(min-width:0px)" srcset="data:image/gif;base64,R0lGODlhAQABAHAAACH5BAEAAAAALAAAAAABAAEAAAICRAEAOw=="> 
              <source media="(min-width: 768px)" srcset="https://images.samsung.com/pk/galaxy-buds4-pro/feature/galaxy-buds4-pro-anc-voicedetect.jpg?imbypass=true"> 
              <source media="(max-width: 767px)" srcset="https://images.samsung.com/pk/galaxy-buds4-pro/feature/galaxy-buds4-pro-anc-voicedetect-mo.jpg?imbypass=true"> 
              <img src="https://images.samsung.com/pk/galaxy-buds4-pro/feature/galaxy-buds4-pro-anc-voicedetect.jpg?imbypass=true" alt="A woman using a single, white Galaxy Buds4 Pro while holding a conversation with another person, showcasing the Voice Detect feature." data-copy-set="C18-04"> 
             </picture> 
            </div> 
           </div> </li> 
          <li class="buds-card__item swiper-slide" role="listitem"> 
           <div class="buds-card__inner"> 
            <div class="buds-card__text"> 
             <div class="common__headline-wrap visible-text is-visible" data-visible-mo="swiper"> 
              <h3 class="common__eyebrow" data-copy-set="C19-01">SIREN DETECT</h3> 
              <p class="buds-card__title common__sub-headline" data-copy-set="C19-02">Listen when you need to be aware</p> 
             </div> 
             <p class="buds-card__description" data-copy-set="C19-03"> Turn on Siren Detect to be more aware of alert sounds. Galaxy Buds4 Pro will automatically switch to ambient mode when an emergency siren is detected nearby.<sup><a href="#desc-section" class="click_sup" title="See disclaimer" data-sup-tag="sup-11"></a></sup> </p> 
            </div> 
            <div class="buds-card__media"> 
             <picture data-media-lazy data-media-id="media-j5z8p"> 
              <source data-empty media="(min-width:0px)" srcset="data:image/gif;base64,R0lGODlhAQABAHAAACH5BAEAAAAALAAAAAABAAEAAAICRAEAOw=="> 
              <source media="(min-width: 768px)" srcset="https://images.samsung.com/pk/galaxy-buds4-pro/feature/galaxy-buds4-pro-anc-sirendetect.jpg?imbypass=true"> 
              <source media="(max-width: 767px)" srcset="https://images.samsung.com/pk/galaxy-buds4-pro/feature/galaxy-buds4-pro-anc-sirendetect-mo.jpg?imbypass=true"> 
              <img src="https://images.samsung.com/pk/galaxy-buds4-pro/feature/galaxy-buds4-pro-anc-sirendetect.jpg?imbypass=true" alt="An ambulance with sirens on, indicating the Siren Detect feature." data-copy-set="C19-04"> 
             </picture> 
            </div> 
           </div> </li> 
         </ul> 
         <div class="buds-card__pagination"> 
          <ul class="buds-card__pagination-list swiper-pagination" role="list" data-tagging="gbuds4pro:features:anc-and-eq^360-audio:index"></ul> 
         </div> 
        </div> 
       </div> 
      </div> 
     </div> 
    </div> 
    <div class="buds-parallax__bottom"> 
     <!-- ########## Galaxy Experience ########## --> 
     <!-- Multi AI Agent (BM) --> 
     <div id="galaxy-experience" class="buds-multi-ai-agent"> 
      <div class="type-image__wrap"> 
       <div class="common__inner"> 
        <div class="buds-multi-ai-agent__content"> 
         <h2 class="common__headline buds-multi-ai-agent__overlay-headline" data-copy-set="C20-01"> Hi-Fi duet that keeps you in sync <sup><a href="#desc-section" class="click_sup" title="See disclaimer" data-sup-tag="sup-1"></a></sup> </h2> 
        </div> 
       </div> 
       <div class="type-image__area"> 
        <div class="buds-multi-ai-agent__bg"> 
         <picture data-media-lazy data-media-id="media-r5g8n"> 
