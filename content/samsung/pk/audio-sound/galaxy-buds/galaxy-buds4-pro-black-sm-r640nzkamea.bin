   <!-- Hi-Fi Codec 2.0 --> 
   <div id="advanced-wireless-audio" class="buds-hi-fi-codec black-theme"> 
    <div class="common__inner"> 
     <div class="common__headline-wrap common__headline-wrap--center visible-text is-visible"> 
      <h3 class="common__eyebrow" data-copy-set="C11-01">ADVANCED WIRELESS AUDIO</h3> 
      <p class="common__sub-headline" data-copy-set="C11-02">Hear every layer come alive</p> 
     </div> 
     <p class="common__description" data-copy-set="C11-03"> Hear every layer come alive with extended bit depth and high sampling rates. <strong>Samsung Seamless Codec (SSC)</strong> supports <strong>24-bit / 96 kHz audio</strong> to preserve the original sound with vast amount of information, while optimized data transmission control enables a stable listening experience with reduced audible artifacts or dropouts. Turn on the Ultra High Quality Audio (UHQ) option on your Galaxy smartphone and rediscover your favorite songs in full detail.<sup><a href="#desc-section" class="click_sup" title="See disclaimer" data-sup-tag="sup-1"></a>, <a href="#desc-section" class="click_sup" title="See disclaimer" data-sup-tag="sup-6"></a>, <a href="#desc-section" class="click_sup" title="See disclaimer" data-sup-tag="sup-7"></a></sup> </p> 
     <div class="buds-hi-fi-codec__image-wrap"> 
      <div class="buds-hi-fi-codec__image"> 
       <picture data-media-lazy data-media-id="media-w8s1d"> 
        <source data-empty media="(min-width:0px)" srcset="data:image/gif;base64,R0lGODlhAQABAHAAACH5BAEAAAAALAAAAAABAAEAAAICRAEAOw=="> 
        <source media="(min-width: 768px)" srcset="https://images.samsung.com/pk/galaxy-buds4-pro/feature/galaxy-buds4-pro-sound-samsungseamlesscodec.jpg?imbypass=true"> 
        <source media="(max-width: 767px)" srcset="https://images.samsung.com/pk/galaxy-buds4-pro/feature/galaxy-buds4-pro-sound-samsungseamlesscodec-mo.jpg?imbypass=true"> 
        <img src="https://images.samsung.com/pk/galaxy-buds4-pro/feature/galaxy-buds4-pro-sound-samsungseamlesscodec.jpg?imbypass=true" alt="Galaxy smartphone with the 'Advanced quality options' screen open. On the screen, 'Ultra high quality (UHQ) audio' is turned on and the 'Super wide band speech' is turned off. In front of the screen is a pair of white, Galaxy Buds4 Pro." data-copy-set="C11-06"> 
       </picture> 
      </div> 
      <div class="buds-hi-fi-codec__specs visible-text is-visible"> 
       <div class="buds-hi-fi-codec__spec-wrap"> 
        <p class="buds-hi-fi-codec__spec-title" data-copy-set="C11-05"><strong class="buds-hi-fi-codec__spec" data-copy-set="C11-04">24-bit / 96 kHz</strong> Samsung Seamless Codec - UHQ</p> 
       </div> 
      </div> 
      <div class="buds-hi-fi-codec__moving-wrap"> 
       <div class="buds-hi-fi-codec__moving buds-hi-fi-codec__moving--left"> 
        <picture data-media-lazy data-media-id="media-b4y3r"> 
         <source data-empty media="(min-width:0px)" srcset="data:image/gif;base64,R0lGODlhAQABAHAAACH5BAEAAAAALAAAAAABAAEAAAICRAEAOw=="> 
         <source media="(min-width: 1px)" srcset="https://images.samsung.com/pk/galaxy-buds4-pro/feature/galaxy-buds4-pro-sound-samsungseamlesscodec-buds-left.png?imbypass=true"> 
         <img src="https://images.samsung.com/pk/galaxy-buds4-pro/feature/galaxy-buds4-pro-sound-samsungseamlesscodec-buds-left.png?imbypass=true" alt=""> 
        </picture> 
       </div> 
       <div class="buds-hi-fi-codec__moving buds-hi-fi-codec__moving--right"> 
        <picture data-media-lazy data-media-id="media-b1f2n"> 
         <source data-empty media="(min-width:0px)" srcset="data:image/gif;base64,R0lGODlhAQABAHAAACH5BAEAAAAALAAAAAABAAEAAAICRAEAOw=="> 
         <source media="(min-width: 1px)" srcset="https://images.samsung.com/pk/galaxy-buds4-pro/feature/galaxy-buds4-pro-sound-samsungseamlesscodec-buds-right.png?imbypass=true"> 
         <img src="https://images.samsung.com/pk/galaxy-buds4-pro/feature/galaxy-buds4-pro-sound-samsungseamlesscodec-buds-right.png?imbypass=true" alt=""> 
