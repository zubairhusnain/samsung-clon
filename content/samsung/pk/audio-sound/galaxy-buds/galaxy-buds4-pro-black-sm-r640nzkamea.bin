   <!-- 9-Band EQ --> 
   <div id="adaptive-equalizer" class="buds-9-band-eq black-theme"> 
    <div class="common__inner"> 
     <div class="common__headline-wrap visible-text is-visible"> 
      <h3 class="common__eyebrow" data-copy-set="C12-01">ADAPTIVE EQUALIZER</h3> 
      <p class="common__sub-headline" data-copy-set="C12-02">Tailor Hi-Fi sound your way</p> 
     </div> 
     <p class="common__description" data-copy-set="C12-03"> Take a step closer to the ultimate in audio. Customize bass, treble and tone with the <strong>9-Band Equalizer</strong> to match your preference, creating a sound signature tailored just for you. Galaxy Buds4 Pro also <strong>optimizes sound adaptively</strong> to your ear shape and wearing style, ensuring a consistent listening experience as your ears perceive it — even when you adjust the volume.<sup><a href="#desc-section" class="click_sup" title="See disclaimer" data-sup-tag="sup-1"></a></sup> </p> 
     <div class="buds-9-band-eq__media"> 
      <div class="common-video"> 
       <figure class="common-video__wrapper"> 
        <video playsinline muted preload="none" data-media-lazy data-media-id="media-0t6n9" data-src-pc="https://images.samsung.com/pk/galaxy-buds4-pro/feature/galaxy-buds4-pro-sound-eq.mp4" data-src-mobile="https://images.samsung.com/pk/galaxy-buds4-pro/feature/galaxy-buds4-pro-sound-eq-mo.mp4" aria-label="A Galaxy smartphone with the 'Equalizer' settings on, with the screen showing multiple toggles in between a pair of white, Galaxy Buds4 Pro." data-copy-set="C12-04"></video> 
        <picture class="common-video__start-frame" data-media-lazy data-media-id="media-pj1tq"> 
         <source data-empty media="(min-width:0px)" srcset="data:image/gif;base64,R0lGODlhAQABAHAAACH5BAEAAAAALAAAAAABAAEAAAICRAEAOw=="> 
         <source media="(min-width: 768px)" srcset="https://images.samsung.com/pk/galaxy-buds4-pro/feature/galaxy-buds4-pro-sound-eq-tb.jpg?imbypass=true"> 
         <source media="(max-width: 767px)" srcset="https://images.samsung.com/pk/galaxy-buds4-pro/feature/galaxy-buds4-pro-sound-eq-mo-tb.jpg?imbypass=true"> 
         <img src="https://images.samsung.com/pk/galaxy-buds4-pro/feature/galaxy-buds4-pro-sound-eq-tb.jpg?imbypass=true" alt=""> 
        </picture> 
       </figure> 
       <button type="button" class="common-video__controller common-video__controller--white" title="adaptive equalizer video" data-omni-type="microsite_contentinter" data-omni="gbuds4pro:features:sound^adaptive-equalizer:movi-pause:main-movie" ga-ca="content click" ga-ac="feature" ga-la="gbuds4pro:features:sound^adaptive-equalizer:movi-pause:main-movie"> 
        <svg class="common-icon" focusable="false" aria-hidden="true"> 
         <use xlink:href="#wearable-video-play" href="#wearable-video-play" class="play"></use> 
