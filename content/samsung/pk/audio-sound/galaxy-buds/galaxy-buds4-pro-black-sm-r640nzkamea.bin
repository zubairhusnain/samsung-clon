       <div class="common__inner"> 
        <h2 class="common__headline" data-copy-set="C15-01">Deeper immersion that adapts with you</h2> 
       </div> 
       <div class="buds-tailored-to-you__content"> 
        <div class="buds-tailored-to-you__item"> 
         <picture data-media-lazy data-media-id="media-p2y4d"> 
