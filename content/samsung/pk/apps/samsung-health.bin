      <!-- KV -->
<div class="samsung-health-kv">
  <picture class="samsung-health-kv-logo">
    <img src="https://images.samsung.com/is/image/samsung/assets/apps/global/samsung-health/2025-07/samsung-health-logo.png?imbypass=true" alt="Samsung Health logo"/>
  </picture>
  <picture class="samsung-health-kv-ai-logo">
    <img src="https://images.samsung.com/is/image/samsung/assets/apps/global/samsung-health/2025-07/samsung-health-galaxy-ai-logo.png?imbypass=true" alt="Galaxy AI logo"/>
  </picture>

