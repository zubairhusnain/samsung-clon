<div class="pd-g-feature-benefit-two-column aem-GridColumn aem-GridColumn--default--12">









<input type="hidden" class="ft09-productSku" value=","/>
<section class="st-two-column bg-white st-two-column--center st-two-column--mo-center    st-two-column--top st-two-column--mo-top st-two-column--image-radius">
	<div class="st-two-column__column-wrap padding-top--0 padding-bottom--48">	
		
		<div class="st-two-column__column">
			<div class="st-two-column__content">
				<div class="st-two-column__title">
					<h2 class="st-two-column__headline text-size-small">Vascular Load</h2>
				</div>
				<div class="st-two-column__sub-title">
					<h3 class="st-two-column__sub-headline text-size-medium">Manage a balanced vascular load</h3>
				</div>

				<div class="st-two-column__rating">
					
					
					
						
					</a>
				</div>
				<div class="st-two-column__text">
					<p class="text-size-medium">Understand your circulatory health by viewing a simple graph. With Galaxy Watch, measure your baseline vascular load while you sleep for the first 3 nights, then track the levels regularly to receive daily trend reports. If your vascular load continues to be high, consider adjusting your lifestyle — from dietary habits to exercise routines, sleep patterns and stress levels — to support your well-being. <sup>20, 21</sup></p>
				</div>
				<div class="st-two-column__cta-wrap">
					
					
				</div>
				<div class="st-two-column__disclaimer">
					
					
				</div>
			</div>
			<figure class="st-two-column__figure ">
				

				<div class="image image--dyn-height">
					<img class="image__preview lazy-load responsive-img" data-desktop-src="//images.samsung.com/is/image/samsung/assets/pk/apps/samsung-health/25_07/samsung-health-vascular-load-pc_ft09.jpg?$LazyLoad_Home_JPG$" data-mobile-src="//images.samsung.com/is/image/samsung/assets/pk/apps/samsung-health/25_07/samsung-health-vascular-load-mo_ft09.jpg?$LazyLoad_Home_JPG$" alt data-aem-asset-id=""/>
					<img class="image__main lazy-load responsive-img" data-desktop-src="//images.samsung.com/is/image/samsung/assets/pk/apps/samsung-health/25_07/samsung-health-vascular-load-pc_ft09.jpg?$590_N_JPG$" data-mobile-src="//images.samsung.com/is/image/samsung/assets/pk/apps/samsung-health/25_07/samsung-health-vascular-load-mo_ft09.jpg?$624_N_JPG$" alt data-aem-asset-id=""/>
				</div>
			</figure>
		</div>
		
		<div class="st-two-column__column">
			<div class="st-two-column__content">
				<div class="st-two-column__title">
					<h2 class="st-two-column__headline text-size-small">Heart Rate</h2>
				</div>
				<div class="st-two-column__sub-title">
					<h3 class="st-two-column__sub-headline text-size-medium">Keep a lookout on your heart's activity</h3>
				</div>

				<div class="st-two-column__rating">
					
					
					
						
					</a>
				</div>
				<div class="st-two-column__text">
					<p class="text-size-medium">Keep a close eye on your heart rate with Galaxy Watch or Ring. Set your wearable devices to record your heart rate while you're asleep, so you can rest peacefully throughout the night. <sup>22</sup></p>
				</div>
				<div class="st-two-column__cta-wrap">
					
					
				</div>
				<div class="st-two-column__disclaimer">
					
					
				</div>
			</div>
			<figure class="st-two-column__figure ">
				

				<div class="image image--dyn-height">
					<img class="image__preview lazy-load responsive-img" data-desktop-src="//images.samsung.com/is/image/samsung/assets/pk/apps/samsung-health/25_07/samsung-health-heart-rate-pc_ft09.jpg?$LazyLoad_Home_JPG$" data-mobile-src="//images.samsung.com/is/image/samsung/assets/pk/apps/samsung-health/25_07/samsung-health-heart-rate-mo_ft09.jpg?$LazyLoad_Home_JPG$" alt data-aem-asset-id=""/>
					<img class="image__main lazy-load responsive-img" data-desktop-src="//images.samsung.com/is/image/samsung/assets/pk/apps/samsung-health/25_07/samsung-health-heart-rate-pc_ft09.jpg?$590_N_JPG$" data-mobile-src="//images.samsung.com/is/image/samsung/assets/pk/apps/samsung-health/25_07/samsung-health-heart-rate-mo_ft09.jpg?$624_N_JPG$" alt data-aem-asset-id=""/>
				</div>
			</figure>
		</div>
		
	</div>
</section>
