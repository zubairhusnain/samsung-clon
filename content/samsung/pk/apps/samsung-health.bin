<div class="static-content aem-GridColumn aem-GridColumn--default--12">
	
	
	      <!-- overview-sleep -->
<div class="samsung-health-overview overview-sleep" id="sleep">
  <div class="samsung-health-overview-text-box">
    <small class="samsung-health-overview-eyebrow">Sleep</small>
    <h2 class="samsung-health-overview-title">Sleep tight and start <br />the day right</h2>
    <p class="samsung-health-overview-desc">
      Wonder why you're tired, even after hours of sleep? Check your sleep habits with Galaxy Watch or Ring. Track your sleep data and
      receive personalized Sleep Coaching for better days and nights. <sup>1, 2, 3</sup>
    </p>
  </div>
  <a href="https://shealth.samsung.com/deepLink?sc_id=tracker.sleep&action=view&destination=track&src=Scom" data-omni-type="microsite_contentinter" data-omni="samsung-health:feature:sleep:link-page:try-now" ga-ca="content click" ga-ac="feature" ga-la="samsung-health:feature:sleep:link-page:try-now" aria-label="Try now. Samsung Health app" class="samsung-health-overview-button-deeplink"><span>Try now</span>
    <svg
      id="icon_bold_action_new-window"
      data-name="icon/bold/action/new-window"
      xmlns="http://www.w3.org/2000/svg"
      width="14"
      height="15"
      viewBox="0 0 14 15"
    >
      <rect id="container" width="14" height="15" transform="translate(0 0)" fill="none" />
      <path id="vector" d="M10.3,0V8.115H9.1V2.041L.846,10.3,0,9.45,8.254,1.2H2.18V0Z" transform="translate(1.79 1.907)" />
    </svg>
  </a>

  <picture class="samsung-health-overview-background">
    <source media="(min-width: 1081px)" srcset="https://images.samsung.com/is/image/samsung/assets/apps/global/samsung-health/2025-07/samsung-health-sleep-overview-pc.jpg?imbypass=true"/>
    <source media="(min-width: 768px)" srcset="https://images.samsung.com/is/image/samsung/assets/apps/global/samsung-health/2025-07/samsung-health-sleep-overview-pc.jpg?imbypass=true&imwidth=1080"/>
    <source media="(min-width: 361px)" srcset="https://images.samsung.com/is/image/samsung/assets/apps/global/samsung-health/2025-07/samsung-health-sleep-overview-mo.jpg?imbypass=true"/>
    <source media="(max-width: 360px)" srcset="https://images.samsung.com/is/image/samsung/assets/apps/global/samsung-health/2025-07/samsung-health-sleep-overview-mo.jpg?imbypass=true&imwidth=360"/>
    <img src="https://images.samsung.com/is/image/samsung/assets/apps/global/samsung-health/2025-07/samsung-health-sleep-overview-pc.jpg?imbypass=true" alt="Person sitting on a bed with hands behind his head, facing the window. On the wrist is Galaxy Watch. Sleep tracking feature GUI surrounds the person. Sleep stage data, Sleep score, Sleep time consistency and Energy score can be seen."/>
  </picture>
</div>
	
</div>
<div class="pd-g-flip-card aem-GridColumn aem-GridColumn--default--12">













<div class="ft25-flip-card desktop-text-align--left mobile-text-align--left bg-white ft25-flip-card--desktop-swiper ft25-flip-card--mobile-swiper ft25-flip-card--use-mouseover-interaction">
	<p class="ft25-flip-card__head-title"></p>
	<div class="ft25-flip-card__swiper-wrap">
		
		<button type="button" class="swiper-button-prev" an-tr="ft25_flip card-apps detail-arrow-indication" an-ca="indication" an-ac="carousel" an-la="carousel:arrow:left">
			<span class="hidden">Previous</span>
			<svg class="icon" focusable="false"><use xlink:href="#previous-regular" href="#previous-regular"></use></svg>
		</button>
		
		<div class="ft25-flip-card__swiper swiper-container basic-swiper" data-swiper-option='{
			&quot;componentEl&quot;:&quot;.ft25-flip-card__swiper-wrap&quot;,
			&quot;keepWrapper&quot;: true,
