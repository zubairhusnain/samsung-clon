	<!-- overview-mental-health -->
<div class="samsung-health-overview overview-theme-white" id="mindfulness">
  <div class="samsung-health-overview-text-box">
    <small class="samsung-health-overview-eyebrow">Mindfulness</small>
    <h2 class="samsung-health-overview-title">Practice sound mind for sound body</h2>
    <p class="samsung-health-overview-desc">
      Mindfulness is as important as physical health for holistic wellness. Learn about your stress levels and relax with breathing
      exercises and meditation. Check in on yourself every day with Samsung Health.
    </p>
  </div>
  <a href="https://shealth.samsung.com/deepLink?sc_id=mood&action=view&destination=main&src=Scom" data-omni-type="microsite_contentinter" data-omni="samsung-health:feature:mental-health:link-page:try-now" ga-ca="content click" ga-ac="feature" ga-la="samsung-health:feature:mental-health:link-page:try-now" aria-label="Try now. Samsung Health app" class="samsung-health-overview-button-deeplink"><span>Try now</span>
    <svg
      id="icon_bold_action_new-window"
      data-name="icon/bold/action/new-window"
      xmlns="http://www.w3.org/2000/svg"
      width="14"
      height="15"
      viewBox="0 0 14 15"
    >
      <rect id="container" width="14" height="15" transform="translate(0 0)" fill="none" />
      <path id="vector" d="M10.3,0V8.115H9.1V2.041L.846,10.3,0,9.45,8.254,1.2H2.18V0Z" transform="translate(1.79 1.907)" />
    </svg>
  </a>

  <picture class="samsung-health-overview-background">
    <source media="(min-width: 1081px)" srcset="https://images.samsung.com/is/image/samsung/assets/apps/global/samsung-health/2025-07/samsung-health-mindfulness-overview-pc.jpg?imbypass=true"/>
