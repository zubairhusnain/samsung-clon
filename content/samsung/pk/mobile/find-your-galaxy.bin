			}
			},
			&quot;autoHeight&quot;: false,
			&quot;pagination&quot;: true,
			&quot;offTxtAccesibility&quot;: true}'>
			<div class="ft25-flip-card__card-wrap swiper-wrapper">
 				
				
				<div class="ft25-flip-card__card swiper-slide">
					<div class="ft25-flip-card__card-inner ft25-flip-card__card-front ft25-flip-card__card--contents-type-image" style="background:">
						<div class="ft25-flip-card__text-wrap">
							<div class="ft25-flip-card__text-wrap-inner">
								<div class="ft25-flip-card__text-wrap-area">
									<div class="ft25-flip-card__eyebrow-text">Sleep</div>
									<h4 class="ft25-flip-card__title">Guide to a better bedtime</h4>
									
								</div>
							</div>
							
							<button class="ft25-flip-card__icon-wrap" an-tr="ft25_flip card-product recommendation-cta-content_click" an-ca="content click" an-ac="feature" an-la="flip card:sleep:plus" type="button">
								<span class="hidden">show more card open</span>
								<svg class="icon" focusable="false"><use xlink:href="#plus-bold" href="#plus-bold"></use></svg>
							</button>
							
						</div>
						
						<div class="ft25-flip-card__figure">
							
							<div class="image">
								<img class="image__preview lazy-load responsive-img" data-desktop-src="//images.samsung.com/is/image/samsung/assets/pk/s2602/find_your_galaxy/find-your-galaxy_f09_ft25_health-sleep_pc_330x440.jpg?$330_440_JPG$" data-mobile-src="//images.samsung.com/is/image/samsung/assets/pk/s2602/find_your_galaxy/find-your-galaxy_f09_ft25_health-sleep_mo_642x892.jpg?$642_892_JPG$" role="img" data-comp-name="image" data-aem-asset-id=""/>
								<img class="image__main lazy-load responsive-img" data-desktop-src="//images.samsung.com/is/image/samsung/assets/pk/s2602/find_your_galaxy/find-your-galaxy_f09_ft25_health-sleep_pc_330x440.jpg?$330_440_JPG$" data-mobile-src="//images.samsung.com/is/image/samsung/assets/pk/s2602/find_your_galaxy/find-your-galaxy_f09_ft25_health-sleep_mo_642x892.jpg?$642_892_JPG$" role="img" data-comp-name="image" data-aem-asset-id=""/>
							</div>
						</div>
						
					</div>
					
					<div class="ft25-flip-card__card-inner ft25-flip-card__card-back">
						<div class="ft25-flip-card__text-wrap">
							<div class="ft25-flip-card__text-wrap-inner">
								<div class="ft25-flip-card__text-wrap-area">
									<div class="ft25-flip-card__eyebrow-text">Sleep</div>
									<h4 class="ft25-flip-card__title">Guide to a better bedtime</h4>
									<div class="ft25-flip-card__card-description">If sleep feels elusive or you just want sweeter dreams, take Galaxy Watch or Galaxy Ring to bed with you. With Samsung Health on your Galaxy device, you can monitor your sleep and wake up to detailed analysis. After one week, you get an animal avatar based on your sleep type, plus insights on when to go to bed and coaching to improve sleep. Soon sleepless nights will be a thing of the past.<sup>1,15,16</sup></div>
									<button class="ft25-flip-card__icon-wrap" an-tr="ft25_flip card-product recommendation-cta-content_click" an-ca="content click" an-ac="feature" an-la="flip card:sleep:close" type="button">
										<span class="hidden">show more card open</span>
										<svg class="icon" focusable="false"><use xlink:href="#delete-bold" href="#delete-bold"></use></svg>
									</button>
