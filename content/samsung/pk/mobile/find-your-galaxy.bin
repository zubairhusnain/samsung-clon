							</button>
							
						</div>
						
						<div class="ft25-flip-card__figure">
							
							<div class="image">
								<img class="image__preview lazy-load responsive-img" data-desktop-src="//images.samsung.com/is/image/samsung/assets/pk/s2602/find_your_galaxy/find-your-galaxy_f07_ft25_music-adaptive-anc_pc_330x440.jpg?$330_440_JPG$" data-mobile-src="//images.samsung.com/is/image/samsung/assets/pk/s2602/find_your_galaxy/find-your-galaxy_f07_ft25_music-adaptive-anc_mo_642x892.jpg?$642_892_JPG$" role="img" data-comp-name="image" data-aem-asset-id=""/>
								<img class="image__main lazy-load responsive-img" data-desktop-src="//images.samsung.com/is/image/samsung/assets/pk/s2602/find_your_galaxy/find-your-galaxy_f07_ft25_music-adaptive-anc_pc_330x440.jpg?$330_440_JPG$" data-mobile-src="//images.samsung.com/is/image/samsung/assets/pk/s2602/find_your_galaxy/find-your-galaxy_f07_ft25_music-adaptive-anc_mo_642x892.jpg?$642_892_JPG$" role="img" data-comp-name="image" data-aem-asset-id=""/>
							</div>
