								<img class="image__main lazy-load responsive-img" data-desktop-src="//images.samsung.com/is/image/samsung/assets/pk/s2602/find_your_galaxy/find-your-galaxy_f05_ft25_camera-professional-photography_pc_330x440.jpg?$330_440_JPG$" data-mobile-src="//images.samsung.com/is/image/samsung/assets/pk/s2602/find_your_galaxy/find-your-galaxy_f05_ft25_camera-professional-photography_mo_642x892.jpg?$642_892_JPG$" role="img" data-comp-name="image" data-aem-asset-id=""/>
