<div class="ft25-flip-card margin-bottom--32 desktop-text-align--center mobile-text-align--center bg-white   ft25-flip-card--use-mouseover-interaction">
	<h2 class="ft25-flip-card__head-title"></h2>
	<div class="ft25-flip-card__swiper-wrap">
		
		<div class="ft25-flip-card__swiper swiper-container" data-swiper-option='{
			&quot;componentEl&quot;:&quot;.ft25-flip-card__swiper-wrap&quot;,
			&quot;keepWrapper&quot;: true,
			&quot;breakpoints&quot;: {
