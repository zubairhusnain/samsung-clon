				<button class="cta cta--contained cta--black gnb-js-layer-close" an-tr="nv00_gnb-Product recommendation-cart popup-other_interaction" an-ca="other interaction" an-ac="cart is empty:OK" an-la="cart is empty:OK" aria-label="Accessibility Text" onclick="window.sg.components.Nv00GnbV4.closeLayerPopup(this);">
					OK
