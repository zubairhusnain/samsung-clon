									<div class="image image--dyn-height">
										<img class="image__preview lazy-load-man responsive-img" data-desktop-src="//images.samsung.com/is/image/samsung/assets/pk/s2602/all_about_galaxy/02_vapor_chamber_pc.png?$LazyLoad_Home_PNG$" data-mobile-src="//images.samsung.com/is/image/samsung/assets/pk/s2602/all_about_galaxy/02_vapor_chamber_mo.png?$LazyLoad_Home_PNG$" alt="A new Vapor Chamber is seen dissipating heat more efficiently." data-aem-asset-id=""/>
										<img class="image__main lazy-load-man responsive-img" data-desktop-src="//images.samsung.com/is/image/samsung/assets/pk/s2602/all_about_galaxy/02_vapor_chamber_pc.png?$570_N_PNG$" data-mobile-src="//images.samsung.com/is/image/samsung/assets/pk/s2602/all_about_galaxy/02_vapor_chamber_mo.png?$720_N_PNG$" alt="A new Vapor Chamber is seen dissipating heat more efficiently." data-aem-asset-id=""/>
