					<div class="feature-column-carousel__item swiper-slide  feature-column-carousel__item--align-center" data-type-headline="Ray tracing/Vulkan" an-tr="ft12_feature column carousel-product family showcase-index-indication" an-ca="indication" an-ac="carousel" an-la="carousel:index:3">
						<div class="feature-column-carousel__feature bg-white">
							<div class="feature-column-carousel__content">
								<div class="feature-column-carousel__text-wrap">
									<div class="feature-column-carousel__eyebrow">
										<p class="feature-column-carousel__eyebrow-text">Ray tracing/Vulkan</p>
									</div>
									<div class="feature-column-carousel__title">
										<h3 class="feature-column-carousel__title-text">Realistic gaming with ray tracing <br />and Vulkan</h3>
									</div>
									
									<div class="feature-column-carousel__text">
										<p class="feature-column-carousel__text-text">Gaming on Galaxy smartphones is a winner, and the GPU and CPU improvements in the next-gen processor enable up to 17% improvement in ray tracing performance on Galaxy S26 Ultra. Galaxy smartphones also have graphics API Vulkan integrated to further enhance seamless loading and promote stable gameplay. And with an ever-growing list of Vulkan-supported games, you can fully immerse yourself in the action with an incredibly realistic gaming environment.<sup>7,9</sup></p>
									</div>
								</div>
