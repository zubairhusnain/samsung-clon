					<div class="feature-column-carousel__item swiper-slide  feature-column-carousel__item--align-center" data-type-headline="Slimness Design" an-tr="ft12_feature column carousel-product family showcase-index-indication" an-ca="indication" an-ac="carousel" an-la="carousel:index:1">
						<div class="feature-column-carousel__feature bg-white">
