			<div class="feature-column-carousel__inner swiper-wrapper">
				
					<div class="feature-column-carousel__item swiper-slide  feature-column-carousel__item--align-center" data-type-headline="Real-time suggestions when you need it" an-tr="ft12_feature column carousel-apps detail-index-indication" an-ca="indication" an-ac="carousel" an-la="carousel:index:1">
						<div class="feature-column-carousel__feature bg-white">
							<div class="feature-column-carousel__content">
								<div class="feature-column-carousel__text-wrap">
									<div class="feature-column-carousel__eyebrow">
										<p class="feature-column-carousel__eyebrow-text">Now Nudge</p>
									</div>
									<div class="feature-column-carousel__title">
										<h3 class="feature-column-carousel__title-text">Real-time suggestions when you need it</h3>
									</div>
									
									<div class="feature-column-carousel__text">
										<p class="feature-column-carousel__text-text">The new Now Nudge acknowledges context. When you're texting your friends, talking about grabbing dinner next week or going on a weekend getaway, Now Nudge takes in what is shown on the screen to provide relevant information or suggest the next step. With Now Nudge, all you need to do is just tap to schedule meet ups, dig up old photos and more — right then and there.<sup>3</sup></p>
									</div>
								</div>
								<div class="feature-column-carousel__button">
									
									
									
									
									
									
									
									
									
									
									
									
									
								</div>
								<div class="feature-column-carousel__disclaimer">
									
								</div>
							</div>
							
							<div class="feature-column-carousel__figure">
								
								
									
									<div class="image image--dyn-height">
										<img class="image__preview lazy-load-man responsive-img" data-desktop-src="//images.samsung.com/is/image/samsung/assets/pk/s2602/one_ui/oneui_03_now_nudge_pc_570x448.jpg?$LazyLoad_Home_JPG$" data-mobile-src="//images.samsung.com/is/image/samsung/assets/pk/s2602/one_ui/oneui_03_now_nudge_mo_720x444.jpg?$LazyLoad_Home_JPG$" alt="Part of a text message conversation. First message is &#39;I can&#39;t believe it&#39;s already been a year since our trip to Seoul&#39;. The reply is &#39;Ooh I miss Seoul. Do you have the photos?&#39; Below the text field is Share photos button to indicate that Now Nudge understood the context and is making the related suggestion." data-aem-asset-id=""/>
										<img class="image__main lazy-load-man responsive-img" data-desktop-src="//images.samsung.com/is/image/samsung/assets/pk/s2602/one_ui/oneui_03_now_nudge_pc_570x448.jpg?$570_N_JPG$" data-mobile-src="//images.samsung.com/is/image/samsung/assets/pk/s2602/one_ui/oneui_03_now_nudge_mo_720x444.jpg?$720_N_JPG$" alt="Part of a text message conversation. First message is &#39;I can&#39;t believe it&#39;s already been a year since our trip to Seoul&#39;. The reply is &#39;Ooh I miss Seoul. Do you have the photos?&#39; Below the text field is Share photos button to indicate that Now Nudge understood the context and is making the related suggestion." data-aem-asset-id=""/>
									</div>
								
								
								
							</div>
						</div>
					</div>
				 
					<div class="feature-column-carousel__item swiper-slide  feature-column-carousel__item--align-center" data-type-headline="Your day simplified" an-tr="ft12_feature column carousel-apps detail-index-indication" an-ca="indication" an-ac="carousel" an-la="carousel:index:2">
						<div class="feature-column-carousel__feature bg-white">
