<div class="cm-g-title-and-three-column aem-GridColumn aem-GridColumn--default--12">


    
    
    
    
    
    <div class="title-and-3-column   padding-top--48 padding-bottom--48 bg-white">
      
      
      <div class="title-and-3-column__inner">
        <div class="title-and-3-column__column">
          <div class="title-and-3-column__column-inner column-contents">
            <div class="column-contents__text">
              <h4 class="column-contents__title">
                
                  On-device Protection<br />
                
              </h4>
              <p class="column-contents__description">Our Personal Data Engine gathers and processes your personal data safely. Then it encrypts that data and saves it onto your device with KEEP and Knox Vault, making it harder for anyone else to gain access.<sup>9,10</sup></p>
              
            </div>
            
                       
          </div>
          
          
        </div>
      
        <div class="title-and-3-column__column">
          <div class="title-and-3-column__column-inner column-contents">
            <div class="column-contents__text">
              <h4 class="column-contents__title">
                
                  Tailored Controls
                
              </h4>
              <p class="column-contents__description">Take control over your Galaxy AI. You decide where it gets processed, either on-device or in the cloud.</p>
              
            </div>
            
                       
          </div>
          
          
        </div>
      
        <div class="title-and-3-column__column">
          <div class="title-and-3-column__column-inner column-contents">
            <div class="column-contents__text">
              <h4 class="column-contents__title">
                
                  Connected Security
                
              </h4>
              <p class="column-contents__description">Knox Matrix Trust Chain technology provides security across Galaxy connected devices so you can monitor the security of other devices right from your Galaxy smartphone.</p>
              
            </div>
            
                       
          </div>
          
          
        </div>
      </div>
    </div>
</div>
