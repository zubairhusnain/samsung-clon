					<div class="feature-column-carousel__item swiper-slide  feature-column-carousel__item--align-center" data-type-headline="Keep private things private" an-tr="ft12_feature column carousel-apps detail-index-indication" an-ca="indication" an-ac="carousel" an-la="carousel:index:2">
						<div class="feature-column-carousel__feature bg-white">
							<div class="feature-column-carousel__content">
								<div class="feature-column-carousel__text-wrap">
									<div class="feature-column-carousel__eyebrow">
										<p class="feature-column-carousel__eyebrow-text">Privacy Alerts</p>
									</div>
									<div class="feature-column-carousel__title">
										<h3 class="feature-column-carousel__title-text">Keep private things private</h3>
									</div>
									
									<div class="feature-column-carousel__text">
										<p class="feature-column-carousel__text-text">It's natural to worry about your private information not being so private anymore. Privacy Alerts utilizes AI to find apps that seem to overuse your exact location, warning you about security risks. Also, it monitors the use of personal info to detect possible dangers and suggests minimizing the type of sensitive data that apps access.<br /></p>
									</div>
								</div>
								<div class="feature-column-carousel__button">
									
									
									
									
									
									
									
									
									
									
									
									
									
								</div>
