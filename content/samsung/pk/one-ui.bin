					<div class="feature-column-carousel__item swiper-slide  feature-column-carousel__item--align-center" data-type-headline="The world’s first Privacy Display on mobile" an-tr="ft12_feature column carousel-apps detail-index-indication" an-ca="indication" an-ac="carousel" an-la="carousel:index:1">
						<div class="feature-column-carousel__feature bg-white">
							<div class="feature-column-carousel__content">
								<div class="feature-column-carousel__text-wrap">
									<div class="feature-column-carousel__eyebrow">
										<p class="feature-column-carousel__eyebrow-text">Privacy Display</p>
									</div>
									<div class="feature-column-carousel__title">
										<h3 class="feature-column-carousel__title-text">The world’s first Privacy Display on mobile<br /></h3>
									</div>
									
									<div class="feature-column-carousel__text">
										<p class="feature-column-carousel__text-text">Block your display from being seen by others. Easily set up Privacy Display to choose the apps you want to mask while using them, such as bank or cloud apps. You can also choose to keep your screen private when entering passwords or when sensitive notification messages appear. Turn the feature on and off when you want to and stay safe from peeping Toms.<sup>6,7</sup></p>
									</div>
								</div>
								<div class="feature-column-carousel__button">
									
									
									
									
									
									
									
									
									
									
									
									
									
								</div>
