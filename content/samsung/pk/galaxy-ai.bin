<div class="pd-g-half-text-bullet-list aem-GridColumn aem-GridColumn--default--12">
	 
    
    <section class="half-text-bullet-list half-text-bullet-list--width-large bg-white" id="privacy">
      <div class="half-text-bullet-list__contents-wrap">
        <div class="half-text-bullet-list__image-wrap">
          
          <div class="image image--dyn-height">
            <img class="image__preview lazy-load responsive-img" data-desktop-src="//images.samsung.com/is/image/samsung/assets/pk/s2602/galaxy_ai/privacy_pc.jpg?$LazyLoad_Home_JPG$" data-mobile-src="//images.samsung.com/is/image/samsung/assets/pk/s2602/galaxy_ai/privacy_mo.jpg?$LazyLoad_Home_JPG$" alt="Samsung Knox logo" data-aem-asset-id=""/>
            <img class="image__main lazy-load responsive-img" data-desktop-src="//images.samsung.com/is/image/samsung/assets/pk/s2602/galaxy_ai/privacy_pc.jpg?$ORIGIN_PNG$" data-mobile-src="//images.samsung.com/is/image/samsung/assets/pk/s2602/galaxy_ai/privacy_mo.jpg?$ORIGIN_PNG$" alt="Samsung Knox logo" data-aem-asset-id=""/>
          </div>
        </div>
        <div class="half-text-bullet-list__text-wrap">
          
          
          <h2 class="half-text-bullet-list__title contrast-target dummy-ti3wu4bk6w">How Galaxy AI keeps your data secure</h2>
          <p class="half-text-bullet-list__desc contrast-target dummy-ti3wu4bk6w">Enjoy peace of mind with Samsung's security, designed for the era of AI. We use multiple safeguards to ensure that your personal details stay personal.<br /></p>
		  	
          <ul class="half-text-bullet-list__list dummy-ti3wu4bk6w" role="list">
            <li class="half-text-bullet-list__list-item" role="listitem">
              
              
              <div class="half-text-bullet-list__list-item-content">
                <strong class="half-text-bullet-list__list-item-title contrast-target">Turn your device into a digital fortress</strong>
                <p class="half-text-bullet-list__list-item-desc contrast-target">Rest assured when it comes to on-device protection for your Galaxy. Our Personal Data Engine gathers and processes your personal data safely. Then it encrypts that data and saves it onto your device with KEEP and Knox Vault, making it harder for anyone else to gain access.<sup>16</sup></p>
              </div>
            </li>
          
            <li class="half-text-bullet-list__list-item" role="listitem">
              
              
              <div class="half-text-bullet-list__list-item-content">
                <strong class="half-text-bullet-list__list-item-title contrast-target">Take control of your privacy settings</strong>
                <p class="half-text-bullet-list__list-item-desc contrast-target">You can decide where your Galaxy AI data gets processed — either locally on device or out in the cloud. Go to your privacy settings and choose the option that gives you the most assurance, or switch back and forth depending on your needs.</p>
              </div>
            </li>
          
            <li class="half-text-bullet-list__list-item" role="listitem">
              
              
              <div class="half-text-bullet-list__list-item-content">
                <strong class="half-text-bullet-list__list-item-title contrast-target">Establish trust across your Galaxy</strong>
                <p class="half-text-bullet-list__list-item-desc contrast-target">Your connected devices become safer when they look out for each other. Our Knox Matrix Trust Chain technology provides cross-platform security, allowing Galaxy devices to check on one another and isolate potential threats.<sup>17</sup><br /></p>
              </div>
            </li>
          </ul>
        </div>
      </div>
    </section>


	 </div>
