					<div class="feature-column-carousel__item swiper-slide  feature-column-carousel__item--align-center" an-tr="ft12_feature column carousel-im marketing page-index-indication" an-ca="indication" an-ac="carousel" an-la="carousel:index:3">
						<div class="feature-column-carousel__feature bg-white">
							<div class="feature-column-carousel__content">
								<div class="feature-column-carousel__text-wrap">
									<div class="feature-column-carousel__eyebrow">
										<p class="feature-column-carousel__eyebrow-text">Audio Eraser</p>
									</div>
									<div class="feature-column-carousel__title">
										<h3 class="feature-column-carousel__title-text">Filter out the noise and crank up the vibes<br /></h3>
									</div>
									
									<div class="feature-column-carousel__text">
										<p class="feature-column-carousel__text-text">Audio Eraser removes background noise from videos in a couple of taps, cleaning up your audio like a charm. Use it across Galaxy phones and tablets to easily edit the moments you've filmed in your life, or use it to clear up distractions from videos shared on certain apps. From the concerts you've attended to content shared by others, you can hear every second in crystal clarity — especially while listening with your Galaxy Buds.<sup>3</sup></p>
									</div>
								</div>
