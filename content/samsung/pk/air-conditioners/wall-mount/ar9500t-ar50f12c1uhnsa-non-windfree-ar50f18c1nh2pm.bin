" data-comp-name="image" role="img"/>
									</div>
								</div>
							</div>

							
							

								
							
							
							<div class="ftd16-interactive-multi-feature__bottom">
								<h3 class="ftd16-interactive-multi-feature__headline">Get warm faster
								</h3>
								<h4 class="ftd16-interactive-multi-feature__sub-headline">Fast Heating
								</h4>
								<p class="ftd16-interactive-multi-feature__description">Heat rooms rapidly from corner to corner, so you are feel comfortable whenever you want and wherever you are. When activated, the Fast Heating mode quickly distributes warm air across an entire room. Its unique design means it reaches the desired temperature faster than conventional models*.
								</p>
								<span class="ftd16-interactive-multi-feature__disclaimer">* Based on internal testing of the AR18AX4ZAWK model using Fast Mode compared with the conventional AQ12EASER model, measuring the time taken to increase the room temperature from 9°C to 20°C.</span>
							</div>
						</div>
					</div>
				  
					<div class="ftd16-interactive-multi-feature__swiper-item swiper-slide" role="listitem" data-tagging='{
						"an-tr":"ftd16_interactive multi feature-product detail-indicator",
						"an-ca":"indication",
