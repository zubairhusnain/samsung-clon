						"an-ac":"carousel",
						"an-la":"carousel:index:3"
					}'>
						<div class="ftd16-interactive-multi-feature__swiper-inner">
							
							<div class="ftd16-interactive-multi-feature__top">
								<div class="ftd16-interactive-multi-feature__image">
									<div class="image">
										<img class="image__preview lazy-load responsive-img" data-desktop-src="//images.samsung.com/is/image/samsung/p6pim/pk/feature/166148881/pk-feature-easy-energy-control-546618721?$LazyLoad_Home_JPG$" data-mobile-src="//images.samsung.com/is/image/samsung/p6pim/pk/feature/166148881/pk-feature-easy-energy-control-546618722?$LazyLoad_Home_JPG$" data-desktop-alt="Shows that the compressor is automatically adjusted for optimum efficiency in 5 steps, including 40, 60, 80, 100 and 120%." data-mobile-alt="Shows that the compressor is automatically adjusted for optimum efficiency in 5 steps, including 40, 60, 80, 100 and 120%." data-comp-name="image" role="img"/>
										<img class="image__main responsive-img lazy-load" data-desktop-src="//images.samsung.com/is/image/samsung/p6pim/pk/feature/166148881/pk-feature-easy-energy-control-546618721?$900_N_JPG$" data-mobile-src="//images.samsung.com/is/image/samsung/p6pim/pk/feature/166148881/pk-feature-easy-energy-control-546618722?$550_N_JPG$" data-desktop-alt="Shows that the compressor is automatically adjusted for optimum efficiency in 5 steps, including 40, 60, 80, 100 and 120%." data-mobile-alt="Shows that the compressor is automatically adjusted for optimum efficiency in 5 steps, including 40, 60, 80, 100 and 120%." data-comp-name="image" role="img"/>
									</div>
								</div>
							</div>

							
							

								
							
							
							<div class="ftd16-interactive-multi-feature__bottom">
								<h3 class="ftd16-interactive-multi-feature__headline">Easy energy control
								</h3>
								<h4 class="ftd16-interactive-multi-feature__sub-headline">5-step Convertible Control
								</h4>
								<p class="ftd16-interactive-multi-feature__description">Save energy, but still stay cool. The 5-step Convertible Cooling* lets you adjust the compressor operation in 5 steps, from 40% to 120%, to suit your changing cooling needs, using the minimal amount of energy**. You can also use it to reduce your daily energy consumption whenever you want.
								</p>
								<span class="ftd16-interactive-multi-feature__disclaimer">* Only available when the air conditioner is in Cooling mode, but not in WindFree™ mode.
<br />** Based on internal testing on the AR24AY4YATAN compared with Samsung conventional models, measuring the power consumption of the Normal mode vs. 5-step Convertible Cooling mode. Tested based on the Cooling Standard (Out 35℃ DB / 24℃ WB, In 27℃ DB / 19℃ WB). The results may vary depending on the model, environmental factors and individual use.</span>
							</div>
						</div>
					</div>
				   
				</div>
			
