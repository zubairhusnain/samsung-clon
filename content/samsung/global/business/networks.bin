@media screen and (max-width: 1023px) { 
	.p6-transfer-wrap .f02 .title-wrap h3 { font-size: 42px; padding-bottom: 0; text-align:center; }
	.p6-transfer-wrap .f02 .technologies-item-title { font-size: 48px; }
