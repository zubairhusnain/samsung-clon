	function techMenu_Reset()
	{
		techWidth = 0;
		fullWidth = 0;
		$(".p6-transfer-wrap .f02 .technologies-item-tab li").each(function(){
			if (techWidth < techGrab)
			{
				techWidth += $(this).outerWidth(true);
			}
			fullWidth += $(this).outerWidth(true);
		});

		if (techWidth > (fullWidth - $(".p6-transfer-wrap .f02 .technologies-item-tab_all").outerWidth()+44))
		{
			techWidth = fullWidth - $(".p6-transfer-wrap .f02 .technologies-item-tab_all").outerWidth()+44;
		}
		if (techWidth < 0)
		{
			techWidth = 0;
			techGrab = 0;
		}
		$(".p6-transfer-wrap .f02 .technologies-item-tab").css({"transition":"none", "transform":"translate(-"+techWidth+"px,0)"});
	}

	var techIndex = 0;
	var techWidth = 0;
	var techGrab = 0;
	var fullWidth = 0;
	var techOut = false;
	
	var motionIng = false;
	var sliderDelay = 600;
	var techIndex = 0;
	var grabMove = 0;
	var grabDistance = 0;
	var movePosition = 0;
	var moveing = false;
	var slideOut = false;
	function techSlider()
	{
		if (!motionIng)
		{
			motionIng = true;
			movePosition = 0;
			$(".p6-transfer-wrap .f03 .techTalk-slide").each(function(){
				if ($(this).index() < techIndex + 2)
				{
					movePosition += $(this).outerWidth(true);
				}
			});
			$(".p6-transfer-wrap .f03 .techTalk-slide .techTalk-text").css({"transition":"none", "opacity":0});
			$(".p6-transfer-wrap .f03 .techTalk-slide .techTalk-text").eq(techIndex+2).css({"transition":"opacity 0.2s 0.2s", "opacity":1});
			movePosition += parseInt($(".p6-transfer-wrap .f03 .techTalk-slide").eq(techIndex+2).css("margin-left"));
			$(".p6-transfer-wrap .f03 .techTalk-slide-wrapper").css({"transition":"transform "+sliderDelay+"ms", "transform":"translate(-"+movePosition+"px,0)"});
			
			setTimeout(function(){
				if (techIndex == -1)
				{
					movePosition = 0;
					$(".p6-transfer-wrap .f03 .techTalk-slide").each(function(){
						if ($(this).index() < 4)
						{
							movePosition += $(this).outerWidth(true);
						}
					});
					movePosition += parseInt($(".p6-transfer-wrap .f03 .techTalk-slide").eq(4).css("margin-left"));
					$(".p6-transfer-wrap .f03 .techTalk-slide-wrapper").css({"transition":"none", "transform":"translate(-"+movePosition+"px,0)"});
					techIndex = 2;
				}else if (techIndex == 3)
				{
					movePosition = 0;
					$(".p6-transfer-wrap .f03 .techTalk-slide").each(function(){
						if ($(this).index() < 2)
						{
							movePosition += $(this).outerWidth(true);
						}
					});
					movePosition += parseInt($(".p6-transfer-wrap .f03 .techTalk-slide").eq(2).css("margin-left"));
					$(".p6-transfer-wrap .f03 .techTalk-slide-wrapper").css({"transition":"none", "transform":"translate(-"+movePosition+"px,0)"});
					techIndex = 0;
				}

				$(".p6-transfer-wrap .f03 .techTalk-slide .techTalk-text").eq(techIndex+2).css({"transition":"none", "opacity":1});
				motionIng = false;
			},sliderDelay);

			$(".p6-transfer-wrap .f03 .techTalk-pagination-bullet").removeClass("active");
			if (techIndex == -1)
			{
				$(".p6-transfer-wrap .f03 .techTalk-pagination-bullet").eq(2).addClass("active");
			}else if (techIndex == 3)
			{
				$(".p6-transfer-wrap .f03 .techTalk-pagination-bullet").eq(0).addClass("active");
			}else{
				$(".p6-transfer-wrap .f03 .techTalk-pagination-bullet").eq(techIndex).addClass("active");
			}
		}
	}

	function techSlider_Reset()
	{
		var showWidth = $(".p6-transfer-wrap .f02 .technologies-item-tab_all").outerWidth(true);
		var fullWidth = 10;
		$(".p6-transfer-wrap .f02 .technologies-item-tab li").each(function(){
			fullWidth += $(this).outerWidth(true);
		});
		if (showWidth < fullWidth && viewportWidth() < 1024)
		{
			console.log("AA");
			$(".p6-transfer-wrap .f02 .technologies-item-tab").css({"width":fullWidth + "px"});
		}else{
			console.log("BB");
			$(".p6-transfer-wrap .f02 .technologies-item-tab").css({"width":""});
		}
		

		movePosition = 0;
		$(".p6-transfer-wrap .f03 .techTalk-slide").each(function(){
			if ($(this).index() < techIndex + 2)
			{
				movePosition += $(this).outerWidth(true);
			}
		});
		movePosition += parseInt($(".p6-transfer-wrap .f03 .techTalk-slide").eq(techIndex + 2).css("margin-left"));
		$(".p6-transfer-wrap .f03 .techTalk-slide-wrapper").css({"transition":"none", "transform":"translate(-"+movePosition+"px,0)"});
	}

	function featureReset()
	{
		$(".p6-transfer-wrap .f03 .techTalk-slide").each(function(){
			if ($(this).index() < 2)
			{
				movePosition += $(this).outerWidth(true);
			}
		});
		
		movePosition += parseInt($(".p6-transfer-wrap .f03 .techTalk-slide").eq(2).css("margin-left"));

		$(".p6-transfer-wrap .f03 .techTalk-slide-wrapper").css({"transition":"none", "transform":"translate(-"+movePosition+"px,0)"});
	}

	function viewportWidth() 
	{  
		if (typeof document.documentElement.clientWidth != 'undefined' && typeof window.innerWidth != 'undefined')  
		{
			if(document.documentElement.clientWidth > window.innerWidth)
				return document.documentElement.clientWidth;
			else
				return window.innerWidth;  
		}else if (typeof document.documentElement != 'undefined' && typeof document.documentElement.clientWidth != 'undefined' && document.documentElement.clientWidth != 0)
		{
			return document.documentElement.clientWidth;  
		}else{
			return viewportwidth = document.getElementsByTagName('body')[0].clientWidth;
		}
	}

	function checkBrowser()
	{
		var agt = navigator.userAgent.toLowerCase();
		var rv = -1; // Return value assumes failure.    
		if (navigator.appName == 'Microsoft Internet Explorer') {        
			var ua = navigator.userAgent;        
			var re = new RegExp("MSIE ([0-9]{1,}[\.0-9]{0,})");        
			if (re.exec(ua) != null)            
				rv = parseFloat(RegExp.$1);    

			//return "IE" + rv;
			return "InternetExplorer";
		}
		//alert("agt : " + agt);
		
		if (agt.indexOf("samsungbrowser") != -1) return 'samsungbrowser'; 
		if (agt.indexOf("ucbrowser") != -1) return 'ucbrowser'; 
		if (agt.indexOf("chrome") != -1) return 'Chrome'; 
		if (agt.indexOf("opera") != -1) return 'Opera'; 
		if (agt.indexOf("staroffice") != -1) return 'StarOffice'; 
		if (agt.indexOf("webtv") != -1) return 'WebTV'; 
		if (agt.indexOf("beonex") != -1) return 'Beonex'; 
		if (agt.indexOf("chimera") != -1) return 'Chimera'; 
		if (agt.indexOf("netpositive") != -1) return 'NetPositive'; 
		if (agt.indexOf("phoenix") != -1) return 'Phoenix'; 
		if (agt.indexOf("firefox") != -1) return 'Firefox'; 
		if (agt.indexOf("safari") != -1) return 'safari'; 
		if (agt.indexOf("skipstone") != -1) return 'SkipStone'; 
		if (agt.indexOf("msie") != -1) return 'InternetExplorer'; 
		if (agt.indexOf("netscape") != -1) return 'Netscape'; 
		//if (agt.indexOf("mozilla/5.0") != -1) return 'Mozilla';
		if (agt.indexOf("mozilla/5.0") != -1) return 'InternetExplorer';

		//return 'InternetExplorer';
	}

	function setMasonry(target, itemSelector) {
		const options = {
			itemSelector: itemSelector,
			columnWidth: itemSelector,
			horizontalOrder: true,
			percentPosition: true,
			transitionDuration: '0.1s',
			gutter: 24
		};

		//unsetMasonry(target);
		target.masonry(options);
	}

	function unsetMasonry(target) {
		target.masonry('reloadItems');
	}

	function insightsDotdotdot() {
		var insights = $('.p6-transfer-wrap .feature.f04 .insights-wrap');
		var items = insights.find('.insights-item');

		items.map(function() {
			return $(this).find('.insights-title');
		}).each(function() {
			var item = this[0];
			
			var line = 3;
			var height = Math.ceil(parseFloat(getComputedStyle(item).lineHeight) * line);

            item.style.height = '';

			var $item = $(item);

            $item.trigger('destroy');
            $item.dotdotdot({
                ellipsis: '...',
                height: height
            });

            item.style.height = height + 'px';
		})
	}





			});
		</script>
	
</div>
