	$(window).on("load", onLoad)
			.on("scroll", onScroll)
			.on("resize", onResize);

	function onLoad()
	{
		kvLoad();

		featureReset();

		if (viewportWidth() > 767)
		{
			$(".p6-transfer-wrap .f02 .technologies-item-tab_all").swipe("disable");
		}else{
			$(".p6-transfer-wrap .f02 .technologies-item-tab_all").swipe("enable");
		}
		techSlider_Reset();

		insightsDotdotdot();

		setMasonry($('.p6-transfer-wrap .feature.f04 .insights-wrap'), '.insights-item');
	}

	function onResize()
	{
		techSlider_Reset();
		setTimeout(techSlider_Reset,500);

		if (viewportWidth() > 767)
		{
			$(".p6-transfer-wrap .f02 .technologies-item-tab_all").swipe("disable");
			$(".p6-transfer-wrap .f02 .technologies-item-tab_all").css({"transition":"none", "transform":""});
		}else{
			$(".p6-transfer-wrap .f02 .technologies-item-tab_all").swipe("enable");
			techMenu_Reset();
		}

		$(".p6-transfer-wrap .f02 .technologies-item-con .technologies-item-text").css({"transition":"", "transform":"", "opacity":""});
		$(".p6-transfer-wrap .f02 .technologies-item-con .technologies-item-thumb").css({"transition":"", "opacity":""});

		insightsDotdotdot();
	}

	var scrollTop = 0;
	function onScroll()
	{
		scrollTop = $(window).scrollTop();
		$("section.feature").each(function(){
			var checkPosition = $(this).offset().top - $(window).outerHeight() + ($(window).outerHeight() / 3);
			var contentsPosition = $(this).offset().top - $(window).outerHeight() + ($(this).outerHeight() / 3);
			var setPosition = checkPosition < contentsPosition ? checkPosition : contentsPosition;
			if (setPosition < scrollTop)
			{
				$(this).addClass("active");
			}else{
				$(this).removeClass("active");
			}
		});
	}
	
	function kvLoad()
	{
		if (checkBrowser() != "InternetExplorer")
		{
			$(".p6-transfer-wrap .kv .kv_slide li").eq(kvIndex).find("video").each(function(){
				this.currentTime = 0;
				this.play();
			});
		}

		$(".p6-transfer-wrap .kv .kv_slide li.video video").each(function(){
			$(this).bind("timeupdate", function(event){
				if (this.currentTime > 0.0)
				{
					$(this).parent().find("img").animate({"opacity":0},200,function(){
						$(this).css({"display":"none"});
					});
				}
			});
		});
		kvSlide();
	}
	function onTrackedVideoFrame(c, d)
	{
		if (c > 0.0)
		{
			if ($(".kv_vd_cover").css("opacity") == 1)
			{
				$(".kv_vd_cover").animate({"opacity":0},200,function(){
					$(this).css({"display":"none"});
				});
			}
		}
	}
	var kf_vd;
	var kvDelay = 10000; //220818 첫번째 kv 영상 길이 수정
	var oldIndex = -1;
	var kvIndex = 0;
	var kvTimeout;
	function kvSlide()
	{
		if (oldIndex != kvIndex)
		{
			$(".p6-transfer-wrap .kv .kv_slide li").removeClass("active");
			if (oldIndex > -1)
			{
				$(".p6-transfer-wrap .kv .kv_slide li").eq(kvIndex).addClass("active").css({"opacity":0}).animate({"opacity":1},300);
			}else{
				$(".p6-transfer-wrap .kv .kv_slide li").eq(kvIndex).addClass("active");
			}
			$(".p6-transfer-wrap .kv .carousel li").removeClass("active");
			$(".p6-transfer-wrap .kv .carousel li").eq(kvIndex).addClass("active");
			$(".p6-transfer-wrap .kv .carousel li span").css({"transition":"none", "width":"0%"});
			if ($(".p6-transfer-wrap .kv .kv_slide li").eq(kvIndex).hasClass("video"))
			{
				if (checkBrowser() != "InternetExplorer")
				{
					$(".p6-transfer-wrap .kv .kv_slide li").eq(kvIndex).find("video").each(function(){
						this.currentTime = 0;
						this.play();

						$(".p6-transfer-wrap .kv .kv_slide li").each(function(){
							if ($(this).index() != kvIndex)
							{
								$(this).find("video").each(function(){
									this.currentTime = 0;
									this.pause();
								});
							}
						});
					});
				}
			}else{
				$(".p6-transfer-wrap .kv .kv_slide li video").each(function(){
					this.pause();
				});
			}

			oldIndex = kvIndex;
		}		
		
		if (!$(".p6-transfer-wrap .kv .rolling_button").hasClass("active"))
		{
			$(".p6-transfer-wrap .kv .carousel li").eq(kvIndex).find("span").css({"transition":"width " + kvDelay + "ms linear", "width":"100%"});
			kvTimeout = setTimeout(function(){
				kvIndex++;
				if (kvIndex >= $(".p6-transfer-wrap .kv .carousel li").length)
				{
					kvIndex = 0;
				}
				kvDelay = 10000; //220818 첫번째 kv 길이 수정
				kvSlide();
			},kvDelay);
		}
	}

