					$(this).find("ul").css({"transition":"transform 600ms","transform":"translate(" + Math.ceil(-movePosition) + "px, 0px)"});
					setTimeout(function(){
						motionIng = false;
					});
				}
			}
		});

		$(".p6-transfer-wrap .f03 .techTalk-slide-container").bind("touchend", function(e){
