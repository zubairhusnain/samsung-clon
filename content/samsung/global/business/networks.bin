	<div class="title medium"></div>
	
</div>
<div class="static-content aem-GridColumn aem-GridColumn--default--12">
	
		<style scoped="scoped">
			*, *::before, *::after { box-sizing: border-box; }

.wsnr{white-space:nowrap;}
.m_only{display:none;}
.t_only{display:none;}

@media screen and (max-width: 1023px){
       .pc_only{display:none;}
        .t_only{display:block;}
	
}


@media screen and (max-width: 767px) {
        .t_only{display:none;}
	.m_only{display:block;}
	
}

.p6-transfer-wrap {overflow: hidden; box-sizing:border-box;}
.p6-transfer-wrap img { width:100%; }
.p6-transfer-wrap .kv { position: relative; width: 100%; height: 810px;}
.p6-transfer-wrap .kv .kv_slide { width: 100%; }
.p6-transfer-wrap .kv .kv_slide li { display:none; position: absolute; top: 0; left: 0; right: 0; bottom: 0; width: 100%; height: 100%; }
.p6-transfer-wrap .kv .kv_slide li.active{display:block;}
.p6-transfer-wrap .kv .kv_slide li figure {position: relative;}
.p6-transfer-wrap .kv .kv_slide li figure .kv_vd_cover {position: absolute; top: 0; left: 50%; transform: translateX(-50%);}




.p6-transfer-wrap .kv img, 
.p6-transfer-wrap .kv video { width: auto; height: 810px; position: absolute; left: 50%; transform: translateX(-50%); object-fit: cover; }

.p6-transfer-wrap .kv .kv_slide li .txt-white { color:#fff; }

.p6-transfer-wrap .kv .txt_wrap { position: absolute; top: calc(50% - 27px); left: 50%; width: 100%; max-width: 1200px; padding:0 22px;  transform: translate(-50%, -50%); text-align: center; z-index: 10;  }

.p6-transfer-wrap .kv .txt_wrap.no-text {top: calc(50% + 67px);}

.p6-transfer-wrap .kv li.radio .txt_wrap {padding: 0 0 0 151px;}

.p6-transfer-wrap .kv .kv_slide .elctronics .txt_wrap {top:60%;}
.p6-transfer-wrap .kv .kv_slide .allAboutX .txt_wrap {top:62%;}
.p6-transfer-wrap .kv .kv_slide .innovations .txt_wrap {top:75%;}
.p6-transfer-wrap .kv .kv_slide .analytics .txt_wrap {top:46%;}

.p6-transfer-wrap .kv .txt_wrap .txt.left_sort{text-align:left;}
.p6-transfer-wrap .kv .txt_wrap .txt.center_sort{margin-top: 170px;}

.p6-transfer-wrap .kv .kv-eybrow { font-family: 'SamsungSharpSans', sans-serif; font-size: 16px; line-height: 1.42; font-weight: 700; margin-bottom: 32px; color: #fff; }

.p6-transfer-wrap .kv .kv-desc { margin-bottom: 8px; font-family: 'SamsungSharpSans', sans-serif; font-size: 72px; line-height: 1.3; color: #fff; font-weight: 700; }
.p6-transfer-wrap .kv .kv_slide li:nth-child(2) .kv-desc {margin-bottom: 0;}

.p6-transfer-wrap .kv .txt_wrap .learnmore-btn { display: inline-block; line-height: 40px; font-weight: 700; font-size: 14px; padding: 0 25px; background-color: #ffffff; color: #000000; border-radius: 20px; height: 40px; margin-top: 36px; transition: background cubic-bezier(0.4, 0, 0.2, 1) 0.2s, color cubic-bezier(0.4, 0, 0.2, 1) 0.2s, border-color cubic-bezier(0.4, 0, 0.2, 1) 0.2s, font-weight cubic-bezier(0.4, 0, 0.2, 1) 0.2s }

.p6-transfer-wrap .kv .kv_slide li.innovations .txt_wrap {margin-top: 0;}

.p6-transfer-wrap .kv .txt_wrap .learnmore-btn:hover { color: #000000; background-color: #eeeeee; }

.p6-transfer-wrap .kv .bottom_obj { display: table; position: absolute; bottom: 33px; left: 50%; transform: translateX(-50%); text-align: center; }

.p6-transfer-wrap .kv .carousel { float: left; display: table; width: 920px; height: 32px; margin-left: -16px;}

.p6-transfer-wrap .kv .carousel li { display: table-cell; width: 190px; height: 100%; padding-left: 16px;  }

.p6-transfer-wrap .kv .carousel li a { position: relative; display: inline-block; width: 100%; height: 2px; background: rgba(0, 0, 0, 0.3); }

.p6-transfer-wrap .kv .carousel li a:after { content: ""; display: none; position: absolute; top: 0; left: 0; width: 8px; height: 8px; border-radius: 50%;background: white;}

.p6-transfer-wrap .kv .carousel li a span { position: relative; top: 0; left: 0; display: block; width: 0; height: 100%; background: black; }

.p6-transfer-wrap .kv .carousel li a div { box-sizing: border-box; overflow: hidden; position: absolute; bottom: 100%; left: 0; width: 100%; padding: 0 3px; font-weight: bold; font-size: 14px; color: #000; text-align: center; height: 20px; }

.p6-transfer-wrap .kv.white .carousel li a div { color: #fff;}

.p6-transfer-wrap .kv .carousel li a div p { display: block; width: 100%; padding-bottom: 5px; opacity: .4;}

.p6-transfer-wrap .kv .carousel li.active a div p, .p6-transfer-wrap .kv .carousel li a:hover div p { opacity: 1;}

.p6-transfer-wrap .kv .rolling_button { display: block; position: absolute; left: 100%; top: 50%; transform: translateY(-50%); float: left; width:16px; height: 16px; margin-left: 6px; background: url('//images.samsung.com/is/content/samsung/assets/global/business/networks/home/pause-w.svg') no-repeat center; background-size: 100% auto; opacity: .9;}

.p6-transfer-wrap .kv .rolling_button.active { background: url('//images.samsung.com/is/content/samsung/assets/global/business/networks/home/play-w.svg') no-repeat center; background-size: 100% auto; }

.p6-transfer-wrap .kv .rolling_button::after { content: ''; clear: both; }

.p6-transfer-wrap .kv.white .prev_btn { background: url("//images.samsung.com/is/image/samsung/assets/global/business/networks/home/prev-w.png") no-repeat center; background-size: 100% auto; }

.p6-transfer-wrap .kv.white .next_btn { background: url("//images.samsung.com/is/image/samsung/assets/global/business/networks/home/next-w.png") no-repeat center; background-size: 100% auto; }

.p6-transfer-wrap .kv.white .carousel li a { background: rgba(255, 255, 255, 0.3); }

.p6-transfer-wrap .kv.white .carousel li a span { background: white; }

.p6-transfer-wrap .kv .kv_slide > li.txt-white.txt-shadow-new { text-shadow: 0px 1px 3.68px rgba(0, 0, 0, 0.7); }

.p6-transfer-wrap .kv .prev_btn { position: absolute; top: 50%; left: 20px; transform: translateY(-50%); display: block; width: 45px; height: 80px; background-size: 100% auto; }

.p6-transfer-wrap .kv .next_btn { position: absolute; top: 50%; right: 20px; transform: translateY(-50%); display: block; width: 45px; height: 80px; background-size: 100% auto; }

.p6-transfer-wrap .kv .slide_obj { max-width: 1920px; position: relative; margin: 0 auto; height: 100%; }

 
.p6-transfer-wrap .f01{ max-width: 1200px; padding: 120px 22px; text-align: center; margin: 0 auto; }

.p6-transfer-wrap .f01 .title-wrap { text-align:center; }

.p6-transfer-wrap .f01 .title-wrap .desc { font-family: 'SamsungSharpSans'; font-size: 24px; font-weight: 700; line-height:1.23; }

.p6-transfer-wrap .f01 .title-wrap .desc + h3{margin-top:23px}

.p6-transfer-wrap .f01 .title-wrap h3 { font-family: 'SamsungSharpSans'; font-size: 56px; font-weight: 700; line-height:1.23; }

.p6-transfer-wrap .f01 .products-wrap { margin-top: 60px; }

.p6-transfer-wrap .f01 .products-wrap > ul { display:flex; justify-content: space-between; }

.p6-transfer-wrap .f01 .products-wrap>ul>li:first-child { margin-right: 32px; }

.p6-transfer-wrap .f01 .products-wrap .product-list li:nth-child(n+3):nth-child(-n+4) { margin-bottom: 0;}


.p6-transfer-wrap .f01 .products-wrap>ul>li:last-child ul li {  }

.p6-transfer-wrap .f01 .products-wrap ul:not(.product-list) > li { border-radius:30px; overflow:hidden; width: calc((100% - 32px) /2); }

.p6-transfer-wrap .f01 .products-wrap .product-list { display:flex; flex-wrap:wrap; width:100%; }

.p6-transfer-wrap .f01 .products-wrap .product-list li {  width: calc((100% - 23px) /2); margin-bottom:24px; border-radius:30px; overflow:hidden; }

.p6-transfer-wrap .f01 .products-wrap .product-list li:nth-child(even) { margin-left:21px; }

.p6-transfer-wrap .f01 .products-wrap ul li a { display:block; width:100%; height:100%; position:relative; cursor:pointer; }

.p6-transfer-wrap .f01 .products-wrap ul li a img { display: block; width:100%;  transition-duration: 0.45s;  }

.p6-transfer-wrap .f01 .products-wrap ul li a:hover { overflow:hidden; }

.p6-transfer-wrap .f01 .products-wrap ul li a:hover img { position: relative; transform: scale(1.1) ; border-radius:30px; } 

.p6-transfer-wrap .f01 .products-wrap .text-box { position: absolute; top: 50px; left: 50px; text-align:left; }

.p6-transfer-wrap .f01 .products-wrap .text-box .product-eyebrow { display: block; margin-bottom: 4px; font-family: 'SamsungOne'; font-size:16px; font-weight: 700; line-height: 1.33; color: #ffffff; }

.p6-transfer-wrap .f01 .products-wrap .text-box .product-title { font-family: 'SamsungSharpSans'; font-size:34px; color: #ffffff; line-height:1.25;}

.p6-transfer-wrap .f01 .products-wrap .product-list .text-box .product-eyebrow { font-size: 12px; }

.p6-transfer-wrap .f01 .products-wrap .product-list .text-box .product-title { font-size: 22px; line-height:1.33;} 
.p6-transfer-wrap .f01 .products-wrap .product-list .text-box{top:37px; left:37px; right: 37px;}



.p6-transfer-wrap .f02 { overflow: hidden; background:#000; color:#fff; }

.p6-transfer-wrap .f02 .technologies-item-tab_all{width:100%; overflow:hidden;}

.p6-transfer-wrap .f02 .inner { max-width: 1200px; padding:110px 22px 120px; text-align: center; margin: 0 auto;}

.p6-transfer-wrap .f02 .title-wrap h3 { font-family: 'SamsungSharpSans', sans-serif; font-size: 56px; line-height: 1.42; font-weight: 700; letter-spacing:-0.02em; padding-bottom: 88px; text-align: left; }

.p6-transfer-wrap .f02 .technologies-list { position: relative; }

.p6-transfer-wrap .f02 .technologies-item-tab { font-size: 0; position: absolute; left: 0; top: 27px; display: flex;  flex-direction: column; z-index: 10; justify-content: center; }

.p6-transfer-wrap .f02 li { margin-bottom: 55px; display: inline-block; text-align: left; }

.p6-transfer-wrap .f02 li a { display: inline-block; position: relative; }

.p6-transfer-wrap .f02 li a::before { content: ''; display: inline-block; width: 0; height: 1px; background: #fff; position: absolute; top: -11px; left: 0; }

.p6-transfer-wrap .f02 li a.active::before { width: 271px;  }

.p6-transfer-wrap .f02 li a span { font-family: 'SamsungOne', sans-serif; font-size: 14px; line-height: 1.41; font-weight: 400; font-weight: 700; display: inline-block; padding-right: 16px; color: #aaa; }

.p6-transfer-wrap .f02 li a p { font-family: 'SamsungSharpSans', sans-serif; font-size: 16px; font-weight: 700; letter-spacing: 0.2px; display: inline-block; vertical-align: sub; color: #aaa; }

.p6-transfer-wrap .f02 li a.active > * { color: #ffffff; }

.p6-transfer-wrap .f02 .technologies-item-con {   visibility: hidden; height: 0; }

.p6-transfer-wrap .f02 .technologies-item-con.active { visibility: visible; width: 100%; height: auto; }

.p6-transfer-wrap .f02 .technologies-item-text > * { text-align:left; }

.p6-transfer-wrap .f02 .technologies-item-text { padding-left: 430px; padding-bottom: 160px; }

.p6-transfer-wrap .f02 .technologies-item-title { font-family: 'SamsungSharpSans', sans-serif; font-weight: 700; font-size: 64px; margin-bottom: 25px;   }

.p6-transfer-wrap .f02 .technologies-item-text-desc { font-family: 'SamsungOne', sans-serif; font-size: 18px; line-height: 1.45; font-weight: 500;  margin-bottom: 40px; }

.p6-transfer-wrap .f02 .technologies-item-thumb { position: relative; display: block; width:100%; border-radius: 30px; }


.p6-transfer-wrap .f02 .btn-wrap { transition: all 0.6s ease; }

.p6-transfer-wrap .f02 .btn-wrap .technologies-item-btn { display: inline-block; height: 40px; line-height: 40px; font-weight: 700; font-size: 14px; padding: 0 24px; background-color: #ffffff; color: #000000; border-radius: 20px; height: 40px; transition: background cubic-bezier(0.4, 0, 0.2, 1) 0.2s, color cubic-bezier(0.4, 0, 0.2, 1) 0.2s, border-color cubic-bezier(0.4, 0, 0.2, 1) 0.2s, font-weight cubic-bezier(0.4, 0, 0.2, 1) 0.2s;
}

.p6-transfer-wrap .f02 .btn-wrap .technologies-item-btn:hover {
  color: #000000;
  background-color: #eeeeee;
}

.p6-transfer-wrap .f03 { padding: 165px 0 120px; overflow:hidden; }

.p6-transfer-wrap .f03 img { width:100%; display:block; }
 
.p6-transfer-wrap .f03 .title-wrap { text-align: center; margin-bottom:60px; }

.p6-transfer-wrap .f03 .contents-wrap {  }

.p6-transfer-wrap .f03 .title-wrap .desc { font-family: 'SamsungSharpSans'; font-size: 24px; font-weight: 700;  }

.p6-transfer-wrap .f03 .title-wrap h3 { font-family: 'SamsungSharpSans'; font-size: 56px; margin-top: 22px; font-weight: 700; line-height:1.32 }

.p6-transfer-wrap .f03 .techTalk-arrow-wrap { position: relative;  max-width: 1332px; margin: 0 auto;  display: flex;   justify-content: space-between; height: 0; z-index: 10; }

.p6-transfer-wrap .f03 .techTalk-arrow { position: absolute; top: 0; margin-top: 13.5%; display: inline-block; width: 40px; height: 40px; background: url('//images.samsung.com/is/content/samsung/assets/global/business/networks/home/icon_arrow.svg') 0 0 no-repeat; background-size: 100% 100%; }

.p6-transfer-wrap .f03 .techTalk-arrow.arrow_prev { transform: rotate(180deg); left: 0; margin-left: 24px; }

.p6-transfer-wrap .f03 .techTalk-arrow.arrow_next { right: 0; margin-right: 24px; }

.p6-transfer-wrap .f03 .techTalk-slide-container { overflow: visible; max-width: 1200px; margin: 0 auto;   position: relative; }

.p6-transfer-wrap .f03 .techTalk-slide-wrapper { height: 638px; position: relative; width: 100%; height: 100%; z-index: 1;  display: flex; }

.p6-transfer-wrap .f03 .techTalk-slide { width: 100%;  height: auto; flex-shrink: 0;  height: 100%; position: relative; left: 0; padding:0 22px;}

.p6-transfer-wrap .f03 .techTalk-slide + .techTalk-slide{margin-left:104px;}

.p6-transfer-wrap .f03.active .techTalk-text {opacity:0;}

.p6-transfer-wrap .f03 .techTalk-text { padding-top: 56px;  display: flex; justify-content: space-between; }

.p6-transfer-wrap .f03.active .techTalk-slide:nth-child(3) .techTalk-text {opacity:1;}

.p6-transfer-wrap .f03 .techTalk-left_box { -webkit-box-flex: 0; -ms-flex: 0 1 50%; flex: 0 1 50%; }

.p6-transfer-wrap .f03 .techTalk-left_box .techTalk-eyebrow { font-family: "SamsungSharpSans"; font-size: 18px; font-weight: 700; }

.p6-transfer-wrap .f03 .techTalk-left_box .techTalk-title { padding-top: 17px; font-family: "SamsungSharpSans"; font-size: 36px; font-weight: 700; }

.p6-transfer-wrap .f03 .techTalk-right_box { -webkit-box-flex: 0; -ms-flex: 0 1 50%; flex: 0 1 50%; margin-left: 24px; }

.p6-transfer-wrap .f03 .techTalk-desc { padding-top: 48px; font-family: "SamsungOne"; font-size: 18px; }

.p6-transfer-wrap .f03 .learnmore-btn { display:inline-block; height: 40px; line-height: 40px; font-size: 14px; padding: 0 24px;  background-color: #000000; color: #ffffff; border-radius:50px; margin-top:24px; font-weight: 700;}

.p6-transfer-wrap .f03 .learnmore-btn:hover { background-color: #333333; color: #ffffff; }

.p6-transfer-wrap .f03 .techTalk-pagination-bullets { position: relative; text-align: center; margin-top: 120px; font-size:0;}

.p6-transfer-wrap .f03 .techTalk-pagination-bullet {  cursor: pointer; width: 8px; height: 8px; display: inline-block; border-radius: 100%; background: #d9d9d9; }

.p6-transfer-wrap .f03 .techTalk-pagination-bullet + .techTalk-pagination-bullet{margin-left:12px;}

.p6-transfer-wrap .f03 .techTalk-pagination-bullet.active { background: #000; }

.p6-transfer-wrap .f03 .btn-wrap { margin:80px 0 0; text-align:center; }

.p6-transfer-wrap .f03 .showmore-btn { font-family: 'SamsungOne'; font-style: normal; font-weight: 700; font-size: 18px; line-height: 22px;text-align: center; color: #000000; height: 22px; line-height: 22px;     display: inline-block; vertical-align: middle;  }

.p6-transfer-wrap .f03 .showmore-btn .icon { background:url('//images.samsung.com/is/image/samsung/assets/global/business/networks/home/btn-arrow.png'); background-size:cover; width: 11px; height: 18px; margin-left:14px; display: inline-block; vertical-align: middle; }


.p6-transfer-wrap .f04 { overflow: hidden; padding: 120px 0; }

.p6-transfer-wrap .f04 .title-wrap { text-align:center; }

.p6-transfer-wrap .f04 .title-wrap .desc { font-family: 'SamsungSharpSans'; font-size: 24px; font-weight: 700; }
.p6-transfer-wrap .f04 .title-wrap h3 { font-family: 'SamsungSharpSans'; font-size: 56px; margin-top: 17px; font-weight: 700; }

.p6-transfer-wrap .f04 .insights-cat-list {  display: flex; -webkit-box-pack: center; -ms-flex-pack: center; justify-content: center; margin: 45px auto 105px; }

.p6-transfer-wrap .f04 .insights-cat-list a { height: 40px; line-height: 40px; font-size: 14px; font-weight: 700; color: #000000; background-color: #f8f8f8; padding: 0 24px; border-radius: 20px; }

.p6-transfer-wrap .f04 .insights-cat-list a:hover { color: #ffffff; background-color: #000000; }

.p6-transfer-wrap .f04 .insights-cat-list a + a { margin-left: 12px; }

.p6-transfer-wrap .f04 .insights-wrap { margin: 0 auto; max-width: 1200px; padding:0 22px; -webkit-box-pack: center; -ms-flex-pack: center; justify-content: center; display: flex; -ms-flex-wrap: wrap; flex-wrap: wrap; position: relative; }

.p6-transfer-wrap .f04 .insights-wrap li {position:relative; width: calc((100% - 92px) / 3); padding: 0; height: auto; min-width: 0; z-index:1;}


.p6-transfer-wrap .f04 .insights-wrap li{ margin-bottom: 25px; }


.p6-transfer-wrap .f04 .insights-wrap li > a { display: block; padding: 0 32px;} 

.p6-transfer-wrap .f04 .insights-wrap li > a .insights-thumb { position: relative; margin: 0 -32px 24px -32px; border-radius: 30px; overflow:hidden; z-index:1; }

.p6-transfer-wrap .f04 .insights-wrap li > a .insights-thumb img { display: block; height: 100%;  transition:transform 0.5s; }

.p6-transfer-wrap .f04 .insights-wrap li > a:hover img { position: relative; transform: scale(1.1) ; }

.p6-transfer-wrap .f04 .insights-wrap .insights-eyebrow { line-height: 1.33; margin-bottom: 8px; font-weight: 700; color: #666; font-family: 'SamsungOne', sans-serif; letter-spacing: normal; font-size: 12px; color: #666; font-weight: 700; }

.p6-transfer-wrap .f04 .insights-wrap .insights-title { font-family: 'SamsungSharpSans'; font-weight: 700; letter-spacing: 0.2px; font-size: 18px; display: block; display: -webkit-box; -o-text-overflow: ellipsis; text-overflow: ellipsis; line-height: 1.39; -webkit-line-clamp: 5; -webkit-box-orient: vertical; word-wrap: break-word; overflow: hidden; white-space: normal; margin-bottom: 16px; letter-spacing: 0; color:#000;}

.p6-transfer-wrap .f05 .signup-wrap { max-width: 100%; width: 100%; position: relative; margin: 0 auto; } 

.p6-transfer-wrap .f05 .signup-text { position: absolute; max-width: 1200px; padding:0 22px; width: 100%; left: 50%; top: 50%;  transform: translate(-50%, -50%); color: #ffffff; } 

.p6-transfer-wrap .f05 .signup-title { font-family: 'SamsungSharpSans'; font-size: 48px; line-height: 1.41; font-weight: 700;}

.p6-transfer-wrap .f05 .signup-btn { font-family: 'SamsungOne'; background-color: #ffffff; color: #000000; height: 40px; font-size: 14px; padding: 0 24px; font-weight: 700; display: inline-flex; align-items: center; border-radius: 20px; margin-top: 28px;

transition: background cubic-bezier(0.4, 0, 0.2, 1) 0.2s, color cubic-bezier(0.4, 0, 0.2, 1) 0.2s, border-color cubic-bezier(0.4, 0, 0.2, 1) 0.2s, font-weight cubic-bezier(0.4, 0, 0.2, 1) 0.2s; }

.p6-transfer-wrap .f05 .signup-btn:hover { color: #000000; background-color: #eeeeee; }

.p6-transfer-wrap .f05 figure { } 
.p6-transfer-wrap .f05 figure img { width: 100%; height: 380px; max-height: 570px; object-fit:cover; }




