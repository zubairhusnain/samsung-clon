		$(".p6-transfer-wrap .f03 .techTalk-slide-container").swipe({
			swipeStatus:function(event, phase, direction, distance, duration, fingerCount, fingerData) {
				console.log("phase : " + phase);
				if (motionIng)
				{
					return false;
				}
				
				if (phase == "start")
				{
					slideOut = false;
					moveing = false;
				}

				if (phase == "move" && Math.abs(duration) > 0)
				{
					$(this).css({"cursor":"grabbing"});
					moveing = true;
					if (slideOut)
					{
						return false;
					}
				}else{
					$(this).css({"cursor":""});
				}

				if (phase == "end" || phase == "cancel")
				{
					setTimeout(function(){
						moveing = false;
					},300);
				}
				
				
				if (moveing && (direction == "right" || direction == "left"))
				{
					grabDistance = distance;
					grabMove = movePosition + distance;
					if (direction == "right")
					{
						grabDistance = -distance;
						grabMove = movePosition - distance;
					}			
					$(this).find("ul").css({"transition":"none","transform":"translate(" + Math.ceil(-grabMove) + "px, 0px)"});
				}				

				if (phase == "end" || phase == "cancel")
				{
					movePosition = 0;
					$(".p6-transfer-wrap .f03 .techTalk-slide").each(function(){
						if ($(this).index() < techIndex + 2)
						{
							movePosition += $(this).outerWidth(true);
						}
					});
					movePosition += parseInt($(".p6-transfer-wrap .f03 .techTalk-slide").eq(techIndex+2).css("margin-left"));
					$(".p6-transfer-wrap .f03 .techTalk-slide-wrapper").css({"transition":"transform 600ms", "transform":"translate(-"+movePosition+"px,0)"});
					
					setTimeout(function(){
						moveing = false;
					},600);
				}
			},
			swipe:function(event, phase, direction, distance, duration, fingerCount, fingerData) {
				slideOut = true;
				moveing = false;

				$(this).css({"cursor":""});	
				var moveWidth = $(".p6-transfer-wrap .f03 .techTalk-slide-container").outerWidth() / 5; 

				if (Math.abs(distance) > moveWidth)
				{
					if (phase == "left" || phase == "right")
					{
						if (phase == "left")
						{
							techIndex++;
						}else{
							techIndex--;
						}

						techSlider();
					}
				}else{
					movePosition = 0;
					$(".p6-transfer-wrap .f03 .techTalk-slide").each(function(){
						if ($(this).index() < techIndex + 2)
						{
							movePosition += $(this).outerWidth(true);
						}
					});
					movePosition += parseInt($(".p6-transfer-wrap .f03 .techTalk-slide").eq(techIndex+2).css("margin-left"));
					$(this).find("ul").css({"transition":"transform 600ms","transform":"translate(" + Math.ceil(-movePosition) + "px, 0px)"});
				}
			},
			allowPageScroll:"vertical"
		});

		$(".p6-transfer-wrap .f03 .techTalk-slide-container").hover(function(){
		},function(){
			
			if (!slideOut)
			{
				slideOut = true;
				moveing = false;
				$(this).css({"cursor":""});	
				if (grabDistance > $(".p6-transfer-wrap .f03 .techTalk-slide-container").outerWidth() / 3)
				{
					console.log("hover Out - Set");

					if (grabDistance > 0)
					{
						techIndex++;
					}else{
						techIndex--;
					}

					techSlider();
				}else{
					console.log("hover Out - Cancel");

					movePosition = 0;
