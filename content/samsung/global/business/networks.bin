	.p6-transfer-wrap .f01 .products-wrap ul:not(.product-list) > li a { border-radius:30px; }

	.p6-transfer-wrap .f01 .products-wrap .text-box { position: absolute; top: 46px; left: 48px; padding:0; text-align:left; }
	.p6-transfer-wrap .f01 .products-wrap .text-box .product-eyebrow { display: block; margin-bottom: 4px; font-family: 'SamsungOne'; font-size: 12px; font-weight: 700; line-height: 1.33; color: #ffffff; }
	.p6-transfer-wrap .f01 .products-wrap .text-box .product-title { font-size: 24px; color: #ffffff; }

	.p6-transfer-wrap .f01 .products-wrap .product-list li { width: calc(50% - 12px); height:100%; margin-top:34px; margin-bottom:0; border-radius: 30px;}
	.p6-transfer-wrap .f01 .products-wrap .product-list li:nth-child(n+3):nth-child(-n+4){margin-top:24px;}
	.p6-transfer-wrap .f01 .products-wrap .product-list li:nth-child(even) { margin-left:23px; }
	
	.p6-transfer-wrap .f01 .products-wrap .text-box .product-eyebrow { font-size:16px; }
	.p6-transfer-wrap .f01 .products-wrap .text-box .product-title { font-size:36px; line-height:1.25; }

